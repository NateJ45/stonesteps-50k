---
// Safe to edit by hand
// A letter (a note from the race director): one narrow column on a plate set
// into the page, the site's "object on a ground" (DESIGN.md). The small line
// above wears the trail blaze, the greeting is in the display face, the letter at a comfortable reading size, the sign-off, then the
// signature picture (or the name in the display font when there is none), the
// role in mono capitals, and an optional button. A content block: the band's
// surface comes from the cadence (rule 9); the plate flips with the theme
// (charcoal on paper, cream on bark) through the plate tokens.
import PortableText from '@/components/PortableText';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import { surfaceClass, type SurfaceValue } from '@/lib/surfaces';
import type { ProjectedLetterSection } from '@/lib/builderBlocks.types';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import type { PortableTextBlock } from '@portabletext/types';

interface Props {
  block: ProjectedLetterSection;
  surface?: SurfaceValue;
  headingId: string;
}
const { block, surface = 'background', headingId } = Astro.props;
const body = (block.body ?? []) as PortableTextBlock[];
const signature = block.signature?.asset ? (block.signature as SanityImageObject) : null;
const greeting = block.greeting?.trim() || 'Dear runners,';
---

<section
  class={surfaceClass(surface)}
  data-builder-block="letterSection"
  aria-labelledby={headingId}
>
  <div class="mx-auto max-w-content px-6 py-section-lg" data-reveal>
    <article class="bb-letter bb-plate">
      {block.eyebrow && (
        <p class="blaze bb-letter__eyebrow font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
          {block.eyebrow}
        </p>
      )}
      <h2 id={headingId} class="bb-letter__greeting">
        {greeting}
      </h2>
      <PortableText value={body} className="bb-letter__body" />
      <footer class="bb-letter__sign">
        {block.signOff && <p class="bb-letter__off">{block.signOff}</p>}
        {signature && (
          <SanityImage
            source={signature}
            width={440}
            sizes="220px"
            quality={80}
            class="bb-letter__signature"
          />
        )}
        {block.name && <p class:list={['bb-letter__name', signature && 'sr-only']}>{block.name}</p>}
        {block.role && <p class="bb-letter__role">{block.role}</p>}
      </footer>
      {block.link?.label && (
        <p class="bb-actions">
          <CtaLink cta={block.link} variant="secondary" />
        </p>
      )}
    </article>
  </div>
</section>
