---
// Safe to edit by hand
//
// A single arc of mud thrown off a shoe. Decorative, aria-hidden.
//
// USED ONCE, ON THE HOME HERO. That restraint is the whole design decision, not
// a limitation. One well-drawn spatter behind the headline reads as the race
// having a character; the same mark repeated down the page reads as a clip-art
// race t-shirt, which is the fastest way to make a considered site look cheap.
// If a second one is ever wanted, that is a conversation, not a copy-paste.
//
// SHAPE, and why the first attempt failed. Spatter is not a scatter of similar
// circles. Draw thirty evenly sized ellipses and you get smudges, which is
// exactly what the first version of this file produced. Real mud thrown off a
// shoe has three populations at once:
//
//   1. a dense cluster of small drops where the foot was,
//   2. a middle band of teardrops stretched along their direction of travel,
//   3. a thin trailing spray of fine specks, plus the occasional long streak
//      from a drop that broke up on the way.
//
// So sizes come from a heavy-tailed curve (most drops tiny, a few fat), density
// falls off along the arc, drops elongate and fade as they travel, and every
// drop scatters PERPENDICULAR to the arc rather than in a square box, which is
// what keeps the throw reading as a throw.
//
// CONTRAST, and a blind spot worth naming. The pixel-sampling contrast gate
// measures text over RASTER media only; it ignores SVG overlays, because
// including them swept in the hairline topo layer on every route. So this mark
// is NOT policed by the gate, and the numbers were worked out by hand instead.
// At the tokened opacities the mark darkens the cream page to a luminance of
// about 0.71 (headline stays near 12.7:1) and lifts the bark page to about
// 0.15 (headline about 4.4:1, against the 3:1 large-text bar). Raise
// --spatter-opacity and you are spending that margin, so redo the arithmetic
// rather than eyeballing it.
//
// Deterministic: the same seed always draws the same mark, so it never shifts
// between builds and never surprises a visual-regression baseline.

interface Props {
  /** Change to redraw. Same seed, same mark, always. */
  seed?: number;
  /** How many drops in total. Most of them are specks. */
  drops?: number;
  class?: string;
}

const { seed = 4, drops = 130, class: className = '' } = Astro.props as Props;

/** Small deterministic PRNG. Same one the topo generator uses. */
function rng(s: number) {
  let t = s + 0x6d2b79f5;
  return () => {
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(seed);
const W = 420;
const H = 260;

/** The arc the mud travels: from the heel, up and out to the right. */
function arcAt(t: number) {
  return { x: 26 + t * 368, y: 214 - Math.sin(t * Math.PI * 0.62) * 152 };
}

const marks = Array.from({ length: drops }, () => {
  // Density falls off along the throw: the exponent piles most drops near the
  // shoe and leaves the far end as a thin spray.
  const t = Math.pow(rand(), 1.55);

  // Scatter across the arc rather than in a box, widening with distance.
  const p = arcAt(t);
  const ahead = arcAt(Math.min(1, t + 0.02));
  const dx = ahead.x - p.x;
  const dy = ahead.y - p.y;
  const len = Math.hypot(dx, dy) || 1;
  const off = (rand() - 0.5) * (16 + t * 96);
  const along = (rand() - 0.5) * (10 + t * 40);
  const x = p.x + (-dy / len) * off + (dx / len) * along;
  const y = p.y + (dx / len) * off + (dy / len) * along;

  // Heavy tail: pow() pushes most drops small, so the few fat ones read as
  // fat instead of everything averaging out into a blur.
  const heavy = Math.pow(rand(), 2.3);
  const size = 0.4 + (1.1 + 7.4 * (1 - t)) * heavy;

  // Stretch along the direction of travel, and let one drop in ten break into
  // a long streak.
  const streak = rand() > 0.9 && t > 0.3 ? 2.6 : 1;
  const stretch = (1 + t * 2.1 + heavy * 0.6) * streak;

  // The travel angle at this point on the arc, wobbled a little.
  const angle = (Math.atan2(dy, dx) * 180) / Math.PI + (rand() - 0.5) * 26;

  return {
    x: +x.toFixed(1),
    y: +y.toFixed(1),
    rx: +Math.max(0.55, size * Math.sqrt(stretch)).toFixed(2),
    ry: +Math.max(0.4, size / Math.sqrt(stretch)).toFixed(2),
    angle: +angle.toFixed(1),
    // The far specks are thinner ink as well as smaller.
    opacity: +(0.98 - t * 0.5).toFixed(2),
  };
});
---

<svg
  class={`spatter ${className}`}
  viewBox={`0 0 ${W} ${H}`}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  {
    marks.map((m) => (
      <ellipse
        cx={m.x}
        cy={m.y}
        rx={m.rx}
        ry={m.ry}
        opacity={m.opacity}
        transform={`rotate(${m.angle} ${m.x} ${m.y})`}
      />
    ))
  }
</svg>

<style>
  /* Currentcolor, so the caller decides the mud. Kept well below the type: this
     sits behind the headline and must never compete with it, which is also why
     the contrast gate now measures text against real pixels rather than
     assuming a flat background (PORTS.md card 43). */
  .spatter {
    fill: currentcolor;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
</style>
