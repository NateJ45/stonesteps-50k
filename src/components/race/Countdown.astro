---
// Safe to edit by hand
//
// The countdown, rendered as the finish-line race clock.
//
// WHY IT LOOKS LIKE THIS. The hero photograph on the same screen shows the real
// clock above the aid station reading in red LED. Rendering the countdown as
// that object means the interface rhymes with the photograph beside it instead
// of being a generic four-number widget. It costs one component and no extra
// payload: the faint unlit "88" behind each pair is the ghost a real seven
// segment display shows behind its active segments.
//
// CHANGED FROM THE MOCKUP: the target is a prop rather than a direct import of
// the race data, so the component is reusable and the value comes from Sanity.
//
// Server-rendered first so the block never renders empty or shifts layout,
// then a small inline script takes over. If the script never runs, the visitor
// still sees a correct countdown as of build time rather than four zeros.

interface Props {
  /** ISO datetime of the start. */
  target?: string | null;
  label?: string;
  /**
   * `clock` is the finish-line housing the hero wears. `inline` is the same
   * clock with the housing taken off: no plate, no LED, the page's own ink, and
   * days/hours/minutes only. The footer carries it beside the race date on
   * every page, where a near-black plate with glowing digits would outshout the
   * date it is there to support and fight the Register plate next to it.
   *
   * BOTH VARIANTS ARE THE SAME COMPONENT ON PURPOSE. The phase logic is the
   * fiddly part (three states, a turnover worked out in the race's timezone,
   * a script that must survive a client-side navigation), and a second
   * component would be a second copy of it that drifts. The script binds
   * `.clock[data-target]`, so an inline instance is driven by the same code.
   */
  variant?: 'clock' | 'inline';
  class?: string;
}

const { target, label = 'Gun time in', variant = 'clock', class: className = '' } = Astro.props;
const inline = variant === 'inline';

const targetDate = target ? new Date(target) : null;
const valid = targetDate && !Number.isNaN(targetDate.getTime());
const ms = valid ? Math.max(0, targetDate.getTime() - Date.now()) : 0;

/**
 * THREE STATES, NOT ONE. Counting down is the clock's job until the gun; then
 * it has two more things to say. From the gun until the end of race day it
 * reads RACE TIME!, because a clock showing 00:00:00:00 all afternoon says the
 * site has stopped. From the next morning it reads TBC, because the only true
 * thing about the next running is that it has not been announced, and this is
 * the line nobody would remember to take down.
 *
 * "End of race day" is midnight in Cincinnati, worked out from the gun's own
 * wall-clock hour, so an 8:00 start turns over sixteen hours later whatever
 * timezone the visitor or the build machine is in. The client script below
 * makes the same call every second, so a page built the week before still
 * turns over on the day.
 */
const RACE_TZ = 'America/New_York';
function dayEndOf(t: Date): number {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: RACE_TZ,
    hour: 'numeric',
    minute: 'numeric',
    hourCycle: 'h23',
  }).formatToParts(t);
  const h = Number(parts.find((p) => p.type === 'hour')?.value ?? 0);
  const m = Number(parts.find((p) => p.type === 'minute')?.value ?? 0);
  return t.getTime() + (24 * 60 - (h * 60 + m)) * 60 * 1000;
}
type Phase = 'count' | 'race' | 'done';
const phase: Phase = !valid
  ? 'count'
  : Date.now() < targetDate.getTime()
    ? 'count'
    : Date.now() < dayEndOf(targetDate)
      ? 'race'
      : 'done';
const TITLES: Record<Phase, string> = { count: label, race: 'Today', done: 'Next running' };
const MESSAGES: Record<Phase, string> = { count: '', race: 'Race time!', done: 'TBC' };

const totalSeconds = Math.floor(ms / 1000);
// EVERY VARIANT KEEPS THE SECOND HAND. The inline one shipped without it on
// 2026-09-13, to save a DOM write per second on a component that is now on
// every page. It read as broken within the hour: minutes are the fastest thing
// that changes, so the footer clock showed identical digits for up to a minute
// while the hero's clock counted seconds a screen above it, and Nathan
// reported it stuck. It was not stuck. Measured across nine navigation paths
// (fresh loads, client-side navigations, back, forward, a hide and show) it was
// correct every time, drift 0 minutes.
//
// That is the point: a clock with no visibly moving digit is indistinguishable
// from a frozen one, and the saving was one `textContent` assignment per
// second. A clock has to look alive to be believed.
const units = [
  { key: 'days', value: Math.floor(totalSeconds / 86400), lbl: 'days' },
  { key: 'hours', value: Math.floor(totalSeconds / 3600) % 24, lbl: 'hrs' },
  { key: 'minutes', value: Math.floor(totalSeconds / 60) % 60, lbl: 'min' },
  { key: 'seconds', value: totalSeconds % 60, lbl: 'sec' },
].map((u) => {
  const text = String(u.value).padStart(2, '0');
  return { ...u, text, ghost: '8'.repeat(text.length) };
});

const srText = !valid
  ? 'Race date not set'
  : phase === 'count'
    ? `${totalSeconds} seconds remaining`
    : phase === 'race'
      ? 'Race day. The race is under way.'
      : 'Next running to be confirmed.';
---

{
  valid && (
    <div class={className}>
      <div
        class:list={[
          'clock',
          inline
            ? 'clock--inline inline-flex items-baseline gap-x-3 gap-y-1'
            : 'inline-block rounded-[10px] border-2 border-black px-[1.15rem] pt-[0.9rem] pb-3',
        ]}
        data-target={target}
        data-phase={phase}
        data-title-count={label}
        data-title-race={TITLES.race}
        data-title-done={TITLES.done}
        data-msg-race={MESSAGES.race}
        data-msg-done={MESSAGES.done}
        role="timer"
        aria-label={srText}
      >
        {/* THE LABEL LIVES ON THE PLATE, not on the band. It used to sit above
          the clock on the page ground, 12px over the mud, and axe blends the
          four mud layers into a veil there: it measured 4.11:1 once, then
          2.68:1 after the wordmark grew and the label moved a hundred pixels
          down the band, and reverting either the size or the stamp brought it
          back over the line. A label whose contrast depends on where the
          mud happens to fall is not a label with contrast. On the plate's own
          face it is cream on near-black and the mud cannot reach it. */}
        <p class="clock__title font-mono text-[0.6875rem] tracking-[0.22em] uppercase">
          {TITLES[phase]}
        </p>
        {/* The two messages, lit in the same LED as the digits. Hidden while
            counting; the digits row is hidden while one of these shows. */}
        <p class="clock__msg tabular" data-msg hidden={phase === 'count'}>
          {MESSAGES[phase]}
        </p>
        <div
          class:list={['flex items-end', inline ? 'gap-3.5' : 'gap-2']}
          data-digits
          hidden={phase !== 'count'}
        >
          {units.map((u, i) => (
            <>
              {i > 0 && !inline && (
                <span class="clock__sep pb-4 font-mono text-2xl leading-none" aria-hidden="true">
                  :
                </span>
              )}
              <span class="clock__group grid justify-items-center">
                <span class="clock__ghost tabular" aria-hidden="true" data-ghost={u.ghost} />
                <span class="clock__val tabular" data-unit={u.key}>
                  {u.text}
                </span>
                <span class="clock__lbl font-mono" aria-hidden="true">
                  {u.lbl}
                </span>
              </span>
            </>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  /* The housing. Deliberately near-black in BOTH themes: this is a physical
     object sitting on the page, and a race clock is not made of paper. */
  .clock {
    --led: #ff3b1f;
    background: #0d0b09;
    /* --lift-ground, not --lift: the housing sits on the page's own ground, and
       on bark a black offset behind a near-black housing is not a shadow. */
    box-shadow:
      var(--lift-ground),
      inset 0 2px 0 rgb(255 235 187 / 0.07);
  }

  /* ---------- The housing taken off ------------------------------------ */
  /* The inline variant is the same clock in the page's own ink. It keeps the
     grid stacking and the tabular figures, and drops everything that made the
     hero's version an object: the plate, the LED, the glow, the unlit ghost
     segments behind the digits. On the footer board those would compete with
     the Register plate beside them and outshout the date they are supporting.

     `flex-wrap` because the footer band narrows before it stacks, and three
     unit groups plus a label is wider than a phone. */
  .clock--inline {
    background: none;
    box-shadow: none;
    flex-wrap: wrap;
  }
  .clock--inline .clock__title {
    color: var(--muted-foreground);
  }
  .clock--inline .clock__ghost {
    /* The unlit segments are the plate's trick and read as dirt without it. */
    display: none;
  }
  .clock--inline .clock__val,
  .clock--inline .clock__msg {
    color: var(--foreground);
    font-size: 1.25rem;
    text-shadow: none;
  }
  .clock--inline .clock__lbl {
    color: var(--muted-foreground);
    /* Roomier than the plate's, because there are no colons between the groups
       here: without separators the figures read as one number and the labels as
       one phrase, so the grouping has to come from the gap instead. */
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  /* Digits stack over their ghost via grid areas, so the label never drifts
     when the digit count changes. */
  .clock__group {
    grid-template-areas: 'digits' 'label';
  }
  .clock__ghost,
  .clock__val {
    grid-area: digits;
    font-weight: 700;
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--led);
  }
  /* The unlit segments a real seven-segment display shows behind its active
     ones. Rendered as GENERATED CONTENT, not as DOM text, because that is what
     it is: decoration carrying no information, already aria-hidden. As text it
     was a genuine axe failure (1.11:1 against the housing) with no honest fix,
     since the whole point is that it is barely visible. As generated content it
     is correctly classified as presentational. The width still follows the real
     digit count, so a three-digit day count still lines up. */
  .clock__ghost {
    opacity: 0.13;
  }
  .clock__ghost::before {
    content: attr(data-ghost);
  }
  .clock__val {
    text-shadow:
      0 0 6px rgb(255 59 31 / 0.5),
      0 0 18px rgb(255 59 31 / 0.22);
  }
  /* RACE TIME! and TBC, in the digits' own light. Slightly smaller than the
     digits so a nine-character message sits inside the same housing. */
  .clock__msg {
    font-weight: 700;
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--led);
    text-shadow:
      0 0 6px rgb(255 59 31 / 0.5),
      0 0 18px rgb(255 59 31 / 0.22);
    padding: 0.35rem 0 0.55rem;
  }
  .clock__msg[hidden] {
    display: none;
  }
  .clock__title {
    /* Cream at 85% on the plate's #0d0b09: about 15:1, and the mud has no
       say. Sits flush with the LED row's left edge. */
    color: rgb(255 235 187 / 0.85);
    margin-bottom: 0.55rem;
  }
  .clock__lbl {
    grid-area: label;
    /* 11px floor. This was 0.55rem, which rendered at 8.8px: the smallest
       text on the site, and a label a visitor is meant to read. */
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 235 187 / 0.5);
    margin-top: 0.35rem;
  }
  .clock__sep {
    color: var(--led);
    opacity: 0.7;
  }

  /* The slow blink a real display has. Off entirely for anyone who asked for
     less motion. */
  @media (prefers-reduced-motion: no-preference) {
    .clock__val[data-unit='seconds'] {
      animation: led 1s steps(2, end) infinite;
    }

    /* A roll-over re-strikes the segments.
       The design review asked for digits that FLIP. They should not: a flip is
       a split-flap, a mechanical object, and this one is explicitly an LED race
       clock drawn to rhyme with the clock in the photograph beside it. What an
       LED display does when a digit changes is light new segments, so that is
       what this does, brief and bright.

       Seconds are excluded on purpose. They already blink, a flare every second
       would be noise, and the moment worth marking is a minute rolling over. */
    .clock__val:not([data-unit='seconds']).is-lit {
      animation: led-strike 420ms ease-out;
    }
  }

  @keyframes led-strike {
    0% {
      filter: brightness(1.85);
    }
    100% {
      filter: none;
    }
  }
  @keyframes led {
    0%,
    60% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0.88;
    }
  }
</style>

<script>
  // Progressive enhancement only. The markup above is already correct as of
  // build time, so a failure here leaves a stale countdown, never a broken one.
  //
  // IT MUST RE-BIND ON EVERY NAVIGATION. This is a module, and a module runs
  // ONCE per full page load: the ClientRouter swaps the document on a
  // client-side navigation and does not re-execute it. So leaving the home
  // page and coming back gave you a brand new clock element with nothing
  // driving it, showing whatever second the page was BUILT at, frozen. It
  // looked exactly like the throttling bug the self-correcting timer below
  // already fixes, and is a completely different cause.
  //
  // `astro:page-load` fires on the first load as well as after every swap, and
  // the dataset flag makes binding idempotent, so this is correct whether or
  // not the ClientRouter is present.
  const cleanups: Array<() => void> = [];

  const bind = (clock: HTMLElement) => {
    if (clock.dataset.clockBound === '1') return;
    clock.dataset.clockBound = '1';
    const target = new Date(clock.dataset.target ?? '');
    if (Number.isNaN(target.getTime())) return;

    const cells: Record<string, HTMLElement | null> = {
      days: clock.querySelector('[data-unit="days"]'),
      hours: clock.querySelector('[data-unit="hours"]'),
      minutes: clock.querySelector('[data-unit="minutes"]'),
      seconds: clock.querySelector('[data-unit="seconds"]'),
    };

    // See the note on the three states in the frontmatter. Same arithmetic,
    // run on every tick, so the turnover happens on a page that has been
    // open since the night before.
    const dayEnd = (() => {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        hour: 'numeric',
        minute: 'numeric',
        hourCycle: 'h23',
      }).formatToParts(target);
      const h = Number(parts.find((p) => p.type === 'hour')?.value ?? 0);
      const m = Number(parts.find((p) => p.type === 'minute')?.value ?? 0);
      return target.getTime() + (24 * 60 - (h * 60 + m)) * 60 * 1000;
    })();
    const title = clock.querySelector<HTMLElement>('.clock__title');
    const msg = clock.querySelector<HTMLElement>('[data-msg]');
    const digits = clock.querySelector<HTMLElement>('[data-digits]');
    const setPhase = (phase: 'count' | 'race' | 'done') => {
      if (clock.dataset.phase === phase) return;
      clock.dataset.phase = phase;
      if (title)
        title.textContent = clock.dataset[`title${phase[0].toUpperCase()}${phase.slice(1)}`] ?? '';
      if (msg) {
        msg.textContent =
          phase === 'count'
            ? ''
            : (clock.dataset[`msg${phase[0].toUpperCase()}${phase.slice(1)}`] ?? '');
        msg.hidden = phase === 'count';
      }
      if (digits) digits.hidden = phase !== 'count';
      clock.setAttribute(
        'aria-label',
        phase === 'race'
          ? 'Race day. The race is under way.'
          : phase === 'done'
            ? 'Next running to be confirmed.'
            : '',
      );
    };

    const tick = () => {
      const now = Date.now();
      if (now >= target.getTime()) {
        setPhase(now < dayEnd ? 'race' : 'done');
        return;
      }
      setPhase('count');
      const total = Math.max(0, Math.floor((target.getTime() - Date.now()) / 1000));
      const parts = {
        days: Math.floor(total / 86400),
        hours: Math.floor(total / 3600) % 24,
        minutes: Math.floor(total / 60) % 60,
        seconds: total % 60,
      };
      for (const [key, el] of Object.entries(cells)) {
        if (!el) continue;
        const next = String(parts[key as keyof typeof parts]).padStart(2, '0');
        if (el.textContent === next) continue;
        el.textContent = next;
        // Seconds are excluded from the strike (they already blink), so do not
        // put a class on them that no rule reads.
        if (key === 'seconds') continue;
        // Restart the strike: remove, force a reflow, re-add. Without the
        // reflow the browser coalesces the two class changes and the animation
        // never replays.
        el.classList.remove('is-lit');
        void el.offsetWidth;
        el.classList.add('is-lit');
      }
      clock.setAttribute('aria-label', `${total} seconds remaining`);
    };

    // A SELF-CORRECTING TIMER, NOT setInterval.
    //
    // Two things stop a 1000ms interval from keeping time. A background tab is
    // throttled to roughly one tick a minute, and a page put into the back /
    // forward cache is frozen outright, so a visitor who leaves the tab and
    // comes back finds a clock showing whatever second it was when they left.
    // setInterval also drifts, because each tick is scheduled a whole second
    // after the last one actually ran rather than on the second boundary.
    //
    // So: schedule to the NEXT WHOLE SECOND every time, and re-read the clock
    // the moment the page becomes visible again or is restored from bfcache.
    // The throttling still happens, it just stops being visible.
    let timer = 0;
    const schedule = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(
        () => {
          tick();
          schedule();
        },
        1000 - (Date.now() % 1000),
      );
    };

    const resync = () => {
      if (document.hidden) return;
      tick();
      schedule();
    };

    document.addEventListener('visibilitychange', resync);
    // Fires on a bfcache restore, where visibilitychange alone may not.
    window.addEventListener('pageshow', resync);

    // THE TEARDOWN IS NOT OPTIONAL. Without it every navigation leaves behind a
    // timer ticking against a detached element and two listeners that can never
    // fire usefully again, and they accumulate for as long as the visit lasts.
    cleanups.push(() => {
      window.clearTimeout(timer);
      document.removeEventListener('visibilitychange', resync);
      window.removeEventListener('pageshow', resync);
    });

    tick();
    schedule();
  };

  const setup = () => {
    document.querySelectorAll<HTMLElement>('.clock[data-target]').forEach(bind);
  };

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    for (const stop of cleanups.splice(0)) stop();
  });
</script>
