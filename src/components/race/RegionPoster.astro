---
// Foundation, edit with care
/**
 * The "where to stay" map on /contact: three places on a cream plate, drawn as
 * inline SVG, each one a link.
 *
 * WHY IT CHANGED (2026-10-09). The first version was a baked screenshot of the
 * site's own terrain map pulled back to show the park, downtown and the airport.
 * It was honest and it was dull: a pale basemap full of town names nobody needs
 * and three small pins. A visitor asking "where do I sleep" needs three places,
 * how far apart they are, and which side of the river. So that is all this
 * draws. A busier drawn version (contours, interstates, a course inset) was tried
 * and rejected on the same day for doing too much: keep it to the pins.
 *
 * WHY THE PINS ARE LINKS (2026-10-25). Three pins and straight-line miles still
 * left the reader with nothing to do next ("this map isn't that useful"). The
 * map stays as plain as it was, but each place now answers the question it
 * raises: Downtown and CVG open a Google Maps hotel search centred on that area,
 * and The Oval opens driving directions to the start. The distance under each
 * base is a drive time, because nobody plans a race morning in crow-flight
 * miles.
 *
 * WHAT IS EXACT. The pins sit at their real coordinates (The Oval is the first
 * point of the recorded course, read at build time). The drive times are
 * rounded Google Maps estimates with no traffic, hand-entered below; the river
 * is a hand-drawn band for orientation only.
 *
 * IT IS A PLATE (cream stock, black edge, hard shadow), not a ridge-cut picture:
 * a dark board vanished into the dark band, and the plate language is what the
 * tickets and FAQ cards already speak in both themes.
 */
import courseGeo from '../../../scripts/data/course-geo.json';
import { directionsUrl } from '@/lib/directions';

interface Props {
  /** Accepted for the caller's sake; a plate does not need the band colour. */
  bandBg?: 'background' | 'muted';
  class?: string;
}
const { class: extraClass = '' } = Astro.props as Props;

// Real coordinates, projected flat at this latitude.
const W = 800;
const H = 600;
const CENTER = { lon: -84.59, lat: 39.111 };
const PX_PER_KM = 23;
const KM_LAT = 111.2;
const KM_LON = 111.2 * Math.cos((CENTER.lat * Math.PI) / 180);
type LL = [number, number];
const project = (ll: LL): LL => [
  W / 2 + (ll[0] - CENTER.lon) * KM_LON * PX_PER_KM,
  H / 2 - (ll[1] - CENTER.lat) * KM_LAT * PX_PER_KM,
];

type Feature = { geometry: { type: string; coordinates: number[][] } };
const firstLine = (courseGeo as { features: Feature[] }).features.find(
  (f) => f.geometry.type === 'LineString',
);
const OVAL_LL: LL = firstLine
  ? [firstLine.geometry.coordinates[0][0], firstLine.geometry.coordinates[0][1]]
  : [-84.568564, 39.172935];
const DOWNTOWN_LL: LL = [-84.512, 39.1031];
const CVG_LL: LL = [-84.6678, 39.0489];

// Rounded Google Maps drive times from The Oval, no traffic. Check them if the
// start ever moves.
const DRIVE_DOWNTOWN_MIN = 15;
const DRIVE_CVG_MIN = 25;

// A hotel search centred on a point: Google lists what is near the map centre,
// so the pin decides the results without a place-name guess.
const hotelsNear = (ll: LL, zoom: number) =>
  `https://www.google.com/maps/search/hotels/@${ll[1]},${ll[0]},${zoom}z`;
const ovalHref = directionsUrl({ lat: OVAL_LL[1], lng: OVAL_LL[0] }) ?? '';
const downtownHref = hotelsNear(DOWNTOWN_LL, 15);
const cvgHref = hotelsNear(CVG_LL, 14);

const oval = project(OVAL_LL);
const downtown = project(DOWNTOWN_LL);
const cvg = project(CVG_LL);

// One soft band, roughly where the Ohio runs: between downtown and CVG. It dips
// on the right so it passes under Downtown's labels, which sit to the right of
// its pin.
const RIVER = 'M-20,396 C200,376 380,436 560,420 S760,436 820,416';

const label = `Map of the Cincinnati area. The Oval in Mt. Airy Forest, where the race starts, is at the top. Downtown Cincinnati is about ${DRIVE_DOWNTOWN_MIN} minutes' drive south east of it, and the CVG airport is about ${DRIVE_CVG_MIN} minutes south west, across the Ohio River in Kentucky. Each place links to Google Maps.`;
---

<figure class={`rposter ${extraClass}`}>
  <svg class="rposter__svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={label}>
    <path d={RIVER} class="rp-river"></path>
    <text x="40" y="400" class="rp-river-label" transform="rotate(-4 40 400)">
      Ohio River
    </text>

    {/* Each place is one link. The transparent rect is the tap target, so a
        thumb does not have to land on the letters; it also carries the focus
        ring. */}
    <a
      href={ovalHref}
      target="_blank"
      rel="noopener"
      class="rp-link"
      aria-label="The Oval, start and finish. Directions (opens Google Maps)"
    >
      <rect
        x={oval[0] - 160}
        y={oval[1] - 80}
        width="320"
        height="182"
        rx="14"
        class="rp-hit"
      ></rect>
      <circle cx={oval[0]} cy={oval[1]} r="16" class="rp-pin rp-pin--race"></circle>
      <text x={oval[0]} y={oval[1] - 34} text-anchor="middle" class="rp-name rp-name--race">
        The Oval
      </text>
      <text x={oval[0]} y={oval[1] + 54} text-anchor="middle" class="rp-sub">
        Start and finish
      </text>
      <text x={oval[0]} y={oval[1] + 88} text-anchor="middle" class="rp-go">
        Directions →
      </text>
    </a>

    <a
      href={downtownHref}
      target="_blank"
      rel="noopener"
      class="rp-link"
      aria-label={`Downtown, ${DRIVE_DOWNTOWN_MIN} min drive. See hotels (opens Google Maps)`}
    >
      <rect
        x={downtown[0] - 22}
        y={downtown[1] - 44}
        width="266"
        height="132"
        rx="14"
        class="rp-hit"
      ></rect>
      <circle cx={downtown[0]} cy={downtown[1]} r="12" class="rp-pin"></circle>
      <text x={downtown[0] + 26} y={downtown[1] - 4} class="rp-name">
        Downtown
      </text>
      <text x={downtown[0] + 26} y={downtown[1] + 30} class="rp-sub">
        {DRIVE_DOWNTOWN_MIN} min drive
      </text>
      <text x={downtown[0] + 26} y={downtown[1] + 66} class="rp-go">
        See hotels →
      </text>
    </a>

    <a
      href={cvgHref}
      target="_blank"
      rel="noopener"
      class="rp-link"
      aria-label={`CVG airport, ${DRIVE_CVG_MIN} min drive. See hotels (opens Google Maps)`}
    >
      <rect x={cvg[0] - 130} y={cvg[1] - 22} width="260" height="148" rx="14" class="rp-hit"></rect>
      <circle cx={cvg[0]} cy={cvg[1]} r="12" class="rp-pin"></circle>
      <text x={cvg[0]} y={cvg[1] + 50} text-anchor="middle" class="rp-name">
        CVG airport
      </text>
      <text x={cvg[0]} y={cvg[1] + 82} text-anchor="middle" class="rp-sub">
        {DRIVE_CVG_MIN} min drive
      </text>
      <text x={cvg[0]} y={cvg[1] + 116} text-anchor="middle" class="rp-go">
        See hotels →
      </text>
    </a>
  </svg>
</figure>

<style>
  /* A plate, like the tickets and the FAQ cards: cream stock, black edge, hard
     offset shadow. It reads in both themes because the edge and the shadow
     carry it, not the ground around it. */
  .rposter {
    margin: 0;
    overflow: hidden;
    background: #f4ebd6;
    border: 2px solid #000;
    border-radius: 12px;
    box-shadow: var(--lift-ground);
  }
  .rposter__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Text is painted with currentColor and coloured with `color`, so what a
     contrast checker reads (the CSS colour) is what the eye sees (the fill).
     Left to inherit, `color` is the page's cream in dark mode. */
  .rposter__svg text {
    fill: currentColor;
    font-family: var(--font-display);
    text-transform: uppercase;
  }
  .rp-river {
    fill: none;
    stroke: #c3d1bd;
    stroke-width: 34;
    stroke-linecap: round;
  }
  .rposter__svg .rp-river-label {
    font-size: 20px;
    letter-spacing: 0.3em;
    color: #2e5738;
  }
  .rp-pin {
    fill: #1a1712;
    stroke: #f4ebd6;
    stroke-width: 4;
  }
  .rp-pin--race {
    fill: #a83c26;
    stroke: #000;
  }
  .rposter__svg .rp-name {
    font-size: 42px;
    color: #1a1712;
  }
  .rposter__svg .rp-name--race {
    font-size: 50px;
    color: #a83c26;
  }
  .rposter__svg .rp-sub {
    font-family: var(--font-mono);
    font-size: 24px;
    letter-spacing: 0.1em;
    color: #5c513b;
  }
  /* The call to action under each place: the rust of the race pin, so the
     three links read as one set, and underlined so they read as links before
     anyone hovers. */
  .rposter__svg .rp-go {
    font-size: 28px;
    letter-spacing: 0.04em;
    color: #a83c26;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* On a phone the plate is about 310px wide, so the viewBox scales text to
     roughly 40%: the small lines would land under 10px. Bigger type, and no
     tracking on the mono line so "15 min drive" still fits right of the
     Downtown pin. */
  @media (max-width: 480px) {
    .rposter__svg .rp-sub {
      font-size: 30px;
      letter-spacing: 0;
    }
    .rposter__svg .rp-go {
      font-size: 34px;
    }
  }
  .rp-hit {
    fill: transparent;
    stroke: transparent;
    stroke-width: 4;
    transition: fill 150ms ease;
  }
  .rp-link {
    cursor: pointer;
    outline: none;
  }
  .rp-link:hover .rp-hit {
    fill: rgb(168 60 38 / 0.08);
  }
  .rp-link:focus-visible .rp-hit {
    stroke: #a83c26;
    stroke-dasharray: 10 6;
  }
  @media (prefers-reduced-motion: reduce) {
    .rp-hit {
      transition: none;
    }
  }
</style>
