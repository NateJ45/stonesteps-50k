---
// Foundation, edit with care
/**
 * The "where to stay" map on /contact: three pins on a dark board, drawn as
 * inline SVG.
 *
 * WHY IT CHANGED (2026-10-09). The first version was a baked screenshot of the
 * site's own terrain map pulled back to show the park, downtown and the airport.
 * It was honest and it was dull: a pale basemap full of town names nobody needs
 * and three small pins. A visitor asking "where do I sleep" needs three places,
 * how far apart they are, and which side of the river. So that is all this
 * draws. A busier drawn version (contours, interstates, a course inset) was tried
 * and rejected on the same day for doing too much: keep it to the pins.
 *
 * WHAT IS EXACT. The pins sit at their real coordinates (The Oval is the first
 * point of the recorded course, read at build time), and the miles are
 * straight-line distances computed from those same coordinates, so they cannot
 * drift from the pins. The river is a hand-drawn band for orientation only.
 *
 * IT IS A PLATE (cream stock, black edge, hard shadow), not a ridge-cut picture:
 * a dark board vanished into the dark band, and the plate language is what the
 * tickets and FAQ cards already speak in both themes.
 */
import courseGeo from '../../../scripts/data/course-geo.json';

interface Props {
  /** Accepted for the caller's sake; a plate does not need the band colour. */
  bandBg?: 'background' | 'muted';
  class?: string;
}
const { class: extraClass = '' } = Astro.props as Props;

// Real coordinates, projected flat at this latitude.
const W = 800;
const H = 600;
const CENTER = { lon: -84.59, lat: 39.111 };
const PX_PER_KM = 23;
const KM_LAT = 111.2;
const KM_LON = 111.2 * Math.cos((CENTER.lat * Math.PI) / 180);
type LL = [number, number];
const project = (ll: LL): LL => [
  W / 2 + (ll[0] - CENTER.lon) * KM_LON * PX_PER_KM,
  H / 2 - (ll[1] - CENTER.lat) * KM_LAT * PX_PER_KM,
];
const miles = (a: LL, b: LL) =>
  Math.round(Math.hypot((a[0] - b[0]) * KM_LON, (a[1] - b[1]) * KM_LAT) * 0.621371);

type Feature = { geometry: { type: string; coordinates: number[][] } };
const firstLine = (courseGeo as { features: Feature[] }).features.find(
  (f) => f.geometry.type === 'LineString',
);
const OVAL_LL: LL = firstLine
  ? [firstLine.geometry.coordinates[0][0], firstLine.geometry.coordinates[0][1]]
  : [-84.568564, 39.172935];
const DOWNTOWN_LL: LL = [-84.512, 39.1031];
const CVG_LL: LL = [-84.6678, 39.0489];

const oval = project(OVAL_LL);
const downtown = project(DOWNTOWN_LL);
const cvg = project(CVG_LL);
const toDowntown = miles(OVAL_LL, DOWNTOWN_LL);
const toCvg = miles(OVAL_LL, CVG_LL);

// One soft band, roughly where the Ohio runs: between downtown and CVG.
const RIVER = 'M-20,412 C200,382 380,432 560,398 S760,382 820,362';

const alt = `Map of the Cincinnati area. The Oval in Mt. Airy Forest, where the race starts, is at the top. Downtown Cincinnati is about ${toDowntown} miles south east of it, and the CVG airport is about ${toCvg} miles south west, across the Ohio River in Kentucky.`;
---

<figure class={`rposter ${extraClass}`}>
  <svg class="rposter__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt}>
    <path d={RIVER} class="rp-river"></path>
    <text x="40" y="414" class="rp-river-label" transform="rotate(-4 40 414)">Ohio River</text>

    <circle cx={oval[0]} cy={oval[1]} r="16" class="rp-pin rp-pin--race"></circle>
    <text x={oval[0]} y={oval[1] - 34} text-anchor="middle" class="rp-name rp-name--race"
      >The Oval</text
    >
    <text x={oval[0]} y={oval[1] + 54} text-anchor="middle" class="rp-sub">Start and finish</text>

    <circle cx={downtown[0]} cy={downtown[1]} r="12" class="rp-pin"></circle>
    <text x={downtown[0]} y={downtown[1] - 28} text-anchor="middle" class="rp-name">Downtown</text>
    <text x={downtown[0]} y={downtown[1] + 48} text-anchor="middle" class="rp-sub"
      >{toDowntown} miles</text
    >

    <circle cx={cvg[0]} cy={cvg[1]} r="12" class="rp-pin"></circle>
    <text x={cvg[0]} y={cvg[1] + 50} text-anchor="middle" class="rp-name">CVG airport</text>
    <text x={cvg[0]} y={cvg[1] + 84} text-anchor="middle" class="rp-sub">{toCvg} miles</text>
  </svg>
</figure>

<style>
  /* A plate, like the tickets and the FAQ cards: cream stock, black edge, hard
     offset shadow. It reads in both themes because the edge and the shadow
     carry it, not the ground around it. */
  .rposter {
    margin: 0;
    overflow: hidden;
    background: #f4ebd6;
    border: 2px solid #000;
    border-radius: 12px;
    box-shadow: var(--lift-ground);
  }
  .rposter__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Text is painted with currentColor and coloured with `color`, so what a
     contrast checker reads (the CSS colour) is what the eye sees (the fill).
     Left to inherit, `color` is the page's cream in dark mode. */
  .rposter__svg text {
    fill: currentColor;
    font-family: var(--font-display);
    text-transform: uppercase;
  }
  .rp-river {
    fill: none;
    stroke: #c3d1bd;
    stroke-width: 34;
    stroke-linecap: round;
  }
  .rposter__svg .rp-river-label {
    font-size: 20px;
    letter-spacing: 0.3em;
    color: #2e5738;
  }
  .rp-pin {
    fill: #1a1712;
    stroke: #f4ebd6;
    stroke-width: 4;
  }
  .rp-pin--race {
    fill: #a83c26;
    stroke: #000;
  }
  .rposter__svg .rp-name {
    font-size: 42px;
    color: #1a1712;
  }
  .rposter__svg .rp-name--race {
    font-size: 50px;
    color: #a83c26;
  }
  .rposter__svg .rp-sub {
    font-family: var(--font-mono);
    font-size: 26px;
    letter-spacing: 0.1em;
    color: #5c513b;
  }
</style>
