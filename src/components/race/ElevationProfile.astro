---
// Foundation, edit with care
/**
 * Elevation profile for the 50K, drawn from the loop structure: four 5.3 mile
 * loops alternating with three 3.2 mile loops, in the order L S L S L S L. Each
 * loop climbs and drops back to The Oval, so the profile is a stack of saw
 * teeth rather than a point-to-point line.
 *
 * The loop lengths are the race's own, from the split columns on its 2006 to
 * 2009 timing spreadsheets. They set the x spacing of the teeth, which is why
 * they matter here and not just on the punch card.
 *
 * THE SHAPE IS SYNTHETIC. It is illustrative of the loop structure and the
 * 10,726 ft total, and it is NOT surveyed GPS data. The caption says so on the
 * page, in words, and that caption is not optional: a plausible-looking
 * elevation chart is read as measurement, and this one is not one.
 *
 * WHEN A MEASURED PROFILE EXISTS it is used instead, and the caption stops
 * hedging. Produce one with `node scripts/build-elevation.mjs <track.gpx>
 * --write`, which samples USGS 3DEP 1 m LiDAR along a real GPS track. Read that
 * script's header before trying to reconstruct a route from the course map: I
 * tried, and the 1998 map is a schematic whose registration error is scattered
 * rather than systematic, so it cannot be snapped to the trail network.
 *
 * The synthetic path below stays as the fallback, because a page that renders
 * nothing is worse than a page that renders something clearly labelled.
 */

interface Props {
  /** Shown in the caption. Verified: 10,726 ft. */
  totalGain?: string;
  /** A real surveyed track, when one exists. Changes what the caption claims. */
  gpxUrl?: string;
  /** A measured profile from scripts/build-elevation.mjs. Wins when present. */
  profile?: {
    source?: string;
    miles?: number;
    gainFt?: number;
    lowFt?: number;
    highFt?: number;
    points?: { mile?: number; ft?: number }[];
  } | null;
}

const { totalGain = '10,726 ft', gpxUrl, profile } = Astro.props;

const measured =
  Array.isArray(profile?.points) && profile.points.length > 8
    ? (profile.points.filter((p) => typeof p.mile === 'number' && typeof p.ft === 'number') as {
        mile: number;
        ft: number;
      }[])
    : null;

const W = 1400;
const H = 320;
const BASE = H - 42;
const PEAK = 46;

type Loop = { kind: 'long' | 'short'; miles: number };

const loops: Loop[] = [
  { kind: 'long', miles: 5.3 },
  { kind: 'short', miles: 3.2 },
  { kind: 'long', miles: 5.3 },
  { kind: 'short', miles: 3.2 },
  { kind: 'long', miles: 5.3 },
  { kind: 'short', miles: 3.2 },
  { kind: 'long', miles: 5.3 },
];

const totalMiles = loops.reduce((s, l) => s + l.miles, 0);

/** Deterministic wobble so each loop reads as trail, not as a clean triangle. */
function jitter(i: number, n: number) {
  return Math.sin(i * 12.9898 + n * 78.233) * 0.5;
}

let x = 0;
let cumulative = 0;
const points: [number, number][] = [[0, BASE]];
const markers: { x: number; label: string; kind: Loop['kind']; mile: number }[] = [];

loops.forEach((loop, li) => {
  const w = (loop.miles / totalMiles) * W;
  // Long loops get more internal climbs than short ones.
  const teeth = loop.kind === 'long' ? 4 : 3;
  const height = loop.kind === 'long' ? 1 : 0.72;

  for (let t = 0; t < teeth; t++) {
    const seg = w / teeth;
    const up = x + seg * 0.45;
    const down = x + seg;
    const wob = jitter(li, t) * 26;
    const crest = BASE - (BASE - PEAK) * height * (0.62 + 0.38 * Math.abs(jitter(li, t + 3))) + wob;
    points.push([up, Math.max(PEAK, Math.min(BASE - 20, crest))]);
    points.push([down, BASE - (t === teeth - 1 ? 0 : 34)]);
    x = down;
  }

  cumulative += loop.miles;
  markers.push({
    x,
    label: `Loop ${li + 1}`,
    kind: loop.kind,
    mile: cumulative,
  });
});

/** Smooth the saw teeth just enough to feel like terrain. */
const line = points
  .map(([px, py], i) => {
    if (i === 0) return `M ${px.toFixed(1)} ${py.toFixed(1)}`;
    const [qx, qy] = points[i - 1];
    const cx = (qx + px) / 2;
    return `C ${cx.toFixed(1)} ${qy.toFixed(1)} ${cx.toFixed(1)} ${py.toFixed(1)} ${px.toFixed(1)} ${py.toFixed(1)}`;
  })
  .join(' ');

const area = `${line} L ${W} ${BASE} L 0 ${BASE} Z`;

// A measured profile replaces both paths and the aid markers. Scaled to the
// same viewBox so every style rule below keeps applying unchanged.
let mLine = '';
let mArea = '';
if (measured) {
  const maxMile = Math.max(...measured.map((p) => p.mile)) || 1;
  const lo = Math.min(...measured.map((p) => p.ft));
  const hi = Math.max(...measured.map((p) => p.ft));
  const span = Math.max(1, hi - lo);
  const sx = (m: number) => (m / maxMile) * W;
  const sy = (ft: number) => BASE - ((ft - lo) / span) * (BASE - PEAK);
  mLine = measured
    .map((p, i) => `${i === 0 ? 'M' : 'L'} ${sx(p.mile).toFixed(1)} ${sy(p.ft).toFixed(1)}`)
    .join(' ');
  mArea = `${mLine} L ${W} ${BASE} L 0 ${BASE} Z`;
}
---

<figure class="elev" data-reveal>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="elev-title elev-desc">
    <title id="elev-title">Stone Steps 50K elevation profile</title>
    <desc id="elev-desc">
      Seven loops from The Oval: four long loops alternating with three short loops of just over
      three miles, totalling 10,726 feet of elevation change across 31 miles.
    </desc>

    <defs>
      <linearGradient id="elevFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" class="elev__stop-top"></stop>
        <stop offset="100%" class="elev__stop-bottom"></stop>
      </linearGradient>
    </defs>

    <!-- Aid-station verticals: you pass through The Oval at the end of every loop. -->
    {
      !measured &&
        markers.map((m) => (
          <g class="elev__aid" style={`--t:${(m.x / W).toFixed(3)}`}>
            <line x1={m.x} y1={PEAK - 20} x2={m.x} y2={BASE} />
            <circle cx={m.x} cy={BASE} r="4" />
          </g>
        ))
    }

    <path d={measured ? mArea : area} class="elev__area" fill="url(#elevFill)"></path>
    <path d={measured ? mLine : line} class="elev__line" pathLength="1"></path>
    <line x1="0" y1={BASE} x2={W} y2={BASE} class="elev__base"></line>

    {
      !measured &&
        markers.map((m, i) => (
          <text
            x={m.x}
            y={BASE + 26}
            class={`elev__lbl ${m.kind === 'long' ? 'is-long' : ''}`}
            text-anchor="middle"
          >
            {i + 1}
          </text>
        ))
    }
  </svg>

  <figcaption class="elev__cap">
    <span class="mono">
      <b>{measured && profile?.gainFt ? `${profile.gainFt.toLocaleString()} ft` : totalGain}</b> total
      elevation change
    </span>
    {
      measured ? (
        <span class="elev__note">
          Measured from USGS 1 m LiDAR along the recorded course
          {profile?.miles ? `, ${profile.miles} miles` : ''}
        </span>
      ) : (
        <span class="elev__note">Shape illustrates the loop structure. Not surveyed GPS data</span>
      )
    }
    {
      gpxUrl && (
        <a class="elev__note" href={gpxUrl} rel="noopener">
          Download the course GPX
        </a>
      )
    }
    <span class="elev__key">
      <span class="elev__dot"></span> Aid station at the end of every loop
    </span>
  </figcaption>
</figure>

<style>
  .elev svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* stop-color must be set as a CSS PROPERTY, not a presentation attribute.
     var() does not resolve inside a presentation attribute, so
     stop-color="var(--primary)" silently produced no fill at all: the profile
     rendered as a bare line over empty space. */
  .elev__stop-top {
    stop-color: var(--primary);
    stop-opacity: 0.32;
  }
  .elev__stop-bottom {
    stop-color: var(--primary);
    stop-opacity: 0;
  }

  .elev__line {
    fill: none;
    stroke: var(--heading-accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .elev__base {
    stroke: color-mix(in srgb, var(--foreground) 35%, transparent);
    stroke-width: 1;
  }

  .elev__aid line {
    stroke: color-mix(in srgb, var(--foreground) 22%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  .elev__aid circle {
    fill: var(--foreground);
  }

  /* ---- The profile draws itself -------------------------------------- */
  /* The line is the shape of the race: seven climbs out of The Oval and seven
     drops back into it. Drawing it left to right says that in a way a static
     chart cannot, and it is the reason to animate this rather than a decorative
     one.

     `pathLength="1"` is what makes it JS-free. It renormalises the path's
     length to 1 for dash purposes, so a dasharray of 1 and a dashoffset of 1
     hide exactly the whole line whatever the real geometry is. No measuring, no
     resize handler, and it keeps working when the loop lengths change.

     Aid markers pop as the line reaches them: each carries `--t`, its own
     fraction along the x axis, so its delay is that fraction of the draw.

     The whole thing is inside a no-preference query, so the resting state is
     the FINISHED chart. Under reduced motion, and under the reveal observer's
     own reduced-motion branch, nothing here applies at all. */
  @media (prefers-reduced-motion: no-preference) {
    .elev[data-reveal] .elev__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .elev[data-reveal].is-visible .elev__line {
      transition: stroke-dashoffset 1900ms cubic-bezier(0.33, 0, 0.15, 1);
      stroke-dashoffset: 0;
    }

    .elev[data-reveal] .elev__area {
      opacity: 0;
    }
    .elev[data-reveal].is-visible .elev__area {
      transition: opacity 900ms ease-out 900ms;
      opacity: 1;
    }

    .elev[data-reveal] .elev__aid {
      opacity: 0;
    }
    .elev[data-reveal].is-visible .elev__aid {
      animation: elev-aid 460ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(var(--t, 0) * 1900ms);
    }
  }

  @keyframes elev-aid {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .elev__lbl {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--muted-foreground);
  }

  .elev__lbl.is-long {
    fill: var(--foreground);
    font-weight: 700;
  }

  .elev__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--cream-dim);
    text-transform: uppercase;
  }

  .elev__cap b {
    color: var(--heading-accent);
  }

  .elev__key {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .elev__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--foreground);
    display: inline-block;
  }

  .elev__note {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    font-style: italic;
  }
</style>
