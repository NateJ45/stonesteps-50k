---
import { externalLinkAttrs } from '@/lib/links';
// Foundation, edit with care
/**
 * Elevation profile for the 50K, drawn from the loop structure: four 5.3 mile
 * loops alternating with three 3.2 mile loops, in the order L S L S L S L. Each
 * loop climbs and drops back to The Oval, so the profile is a stack of saw
 * teeth rather than a point-to-point line.
 *
 * The loop lengths are the race's own, from the split columns on its 2006 to
 * 2009 timing spreadsheets. They set the x spacing of the teeth, which is why
 * they matter here and not just on the punch card.
 *
 * THE SHAPE IS SYNTHETIC. It is illustrative of the loop structure and the
 * 10,726 ft total, and it is NOT surveyed GPS data. The caption says so on the
 * page, in words, and that caption is not optional: a plausible-looking
 * elevation chart is read as measurement, and this one is not one.
 *
 * WHEN A MEASURED PROFILE EXISTS it is used instead, and the caption stops
 * hedging. Produce one with `node scripts/build-elevation.mjs <track.gpx>
 * --write`, which samples USGS 3DEP 1 m LiDAR along a real GPS track. Read that
 * script's header before trying to reconstruct a route from the course map: I
 * tried, and the 1998 map is a schematic whose registration error is scattered
 * rather than systematic, so it cannot be snapped to the trail network.
 *
 * The synthetic path below stays as the fallback, because a page that renders
 * nothing is worse than a page that renders something clearly labelled.
 */

interface Props {
  /** Shown in the caption. Verified: 10,726 ft. */
  totalGain?: string;
  /** A real surveyed track, when one exists. Changes what the caption claims. */
  gpxUrl?: string;
  /** A measured profile from scripts/build-elevation.mjs. Wins when present. */
  profile?: {
    source?: string;
    miles?: number;
    gainFt?: number;
    lossFt?: number;
    lowFt?: number;
    highFt?: number;
    points?: { mile?: number; ft?: number }[];
  } | null;
  /**
   * `watermark` draws ONLY the ridge line, oversized and silent, for a band to
   * lay behind its own copy. It is the same path from the same data as the
   * readable chart: the section's background is then literally the section's
   * subject, rather than a texture chosen to sit behind it.
   *
   * It carries no title, no axis, no caption and no aria: the real chart below
   * it is the accessible one, and announcing the same profile twice would be a
   * screen-reader tax for a decoration.
   */
  variant?: 'chart' | 'watermark';
}

const { totalGain = '10,726 ft', gpxUrl, profile, variant = 'chart' } = Astro.props;

const measured =
  Array.isArray(profile?.points) && profile.points.length > 8
    ? (profile.points.filter((p) => typeof p.mile === 'number' && typeof p.ft === 'number') as {
        mile: number;
        ft: number;
      }[])
    : null;

/**
 * The measured headline, COUNTED THE SAME WAY the synthetic one is.
 *
 * "10,726 ft total elevation change" is up and down added together, which is
 * how the race states it and how a watch reports it. Gain alone is a shade over
 * half that, so printing gain under the words "total elevation change" would
 * have flattened the race on the day a real track arrived. Both halves, or the
 * caption keeps the race's own figure and says nothing it cannot support.
 */
const measuredChange =
  measured && typeof profile?.gainFt === 'number' && typeof profile?.lossFt === 'number'
    ? Math.round(profile.gainFt + profile.lossFt)
    : null;

/**
 * THE CHART IS DRAWN TWICE, ON TWO CANVASES, and that is a phone fix. The
 * profile is a 1400 x 320 drawing, a 4.4:1 strip that reads as a ridge line on
 * a desktop column. Scaled to a 327px phone column that same strip is 75px
 * tall, the fourteen aid verticals are 23px apart and the whole thing is a
 * smear under the caption. Stretching it with preserveAspectRatio="none" would
 * have squashed every label and turned the aid dots into slivers. So the same
 * loops are laid out again on a 720 x 400 canvas, whose teeth are about twice
 * as steep, and each canvas is shown at its own breakpoint. The geometry is
 * one function of (W, H) so the two can never disagree about the course.
 */
type Loop = { kind: 'long' | 'short'; miles: number };

const loops: Loop[] = [
  { kind: 'long', miles: 5.3 },
  { kind: 'short', miles: 3.2 },
  { kind: 'long', miles: 5.3 },
  { kind: 'short', miles: 3.2 },
  { kind: 'long', miles: 5.3 },
  { kind: 'short', miles: 3.2 },
  { kind: 'long', miles: 5.3 },
];

const totalMiles = loops.reduce((s, l) => s + l.miles, 0);

/** Deterministic wobble so each loop reads as trail, not as a clean triangle. */
function jitter(i: number, n: number) {
  return Math.sin(i * 12.9898 + n * 78.233) * 0.5;
}

function build(W: number, H: number) {
  const BASE = H - 42;
  const PEAK = 46;

  let x = 0;
  let cumulative = 0;
  const points: [number, number][] = [[0, BASE]];
  const markers: { x: number; label: string; kind: Loop['kind']; mile: number }[] = [];

  loops.forEach((loop, li) => {
    const w = (loop.miles / totalMiles) * W;
    // Long loops get more internal climbs than short ones.
    const teeth = loop.kind === 'long' ? 4 : 3;
    const height = loop.kind === 'long' ? 1 : 0.72;

    for (let t = 0; t < teeth; t++) {
      const seg = w / teeth;
      const up = x + seg * 0.45;
      const down = x + seg;
      const wob = jitter(li, t) * 26;
      const crest =
        BASE - (BASE - PEAK) * height * (0.62 + 0.38 * Math.abs(jitter(li, t + 3))) + wob;
      points.push([up, Math.max(PEAK, Math.min(BASE - 20, crest))]);
      points.push([down, BASE - (t === teeth - 1 ? 0 : 34)]);
      x = down;
    }

    cumulative += loop.miles;
    markers.push({
      x,
      label: `Loop ${li + 1}`,
      kind: loop.kind,
      mile: cumulative,
    });
  });

  /** Smooth the saw teeth just enough to feel like terrain. */
  const line = points
    .map(([px, py], i) => {
      if (i === 0) return `M ${px.toFixed(1)} ${py.toFixed(1)}`;
      const [qx, qy] = points[i - 1];
      const cx = (qx + px) / 2;
      return `C ${cx.toFixed(1)} ${qy.toFixed(1)} ${cx.toFixed(1)} ${py.toFixed(1)} ${px.toFixed(1)} ${py.toFixed(1)}`;
    })
    .join(' ');

  const area = `${line} L ${W} ${BASE} L 0 ${BASE} Z`;

  // A measured profile replaces both paths and the aid markers. Scaled to the
  // same viewBox so every style rule below keeps applying unchanged.
  let mLine = '';
  let mArea = '';
  if (measured) {
    const maxMile = Math.max(...measured.map((p) => p.mile)) || 1;
    const lo = Math.min(...measured.map((p) => p.ft));
    const hi = Math.max(...measured.map((p) => p.ft));
    const span = Math.max(1, hi - lo);
    const sx = (m: number) => (m / maxMile) * W;
    const sy = (ft: number) => BASE - ((ft - lo) / span) * (BASE - PEAK);
    mLine = measured
      .map((p, i) => `${i === 0 ? 'M' : 'L'} ${sx(p.mile).toFixed(1)} ${sy(p.ft).toFixed(1)}`)
      .join(' ');
    mArea = `${mLine} L ${W} ${BASE} L 0 ${BASE} Z`;
  }

  return {
    W,
    H,
    BASE,
    PEAK,
    markers,
    line: measured ? mLine : line,
    area: measured ? mArea : area,
  };
}

const wide = build(1400, 320);
const tall = build(720, 400);
// Two canvases, one for each breakpoint. The phone's carries a bigger label
// size because its viewBox is half the width and would otherwise render the
// loop numbers at 7px.
const canvases = [
  { ...wide, cls: 'elev__svg elev__svg--wide', lbl: 15 },
  { ...tall, cls: 'elev__svg elev__svg--tall', lbl: 26 },
];
---

{
  /* THE SAME PATH FROM THE SAME DATA AS THE CHART BELOW IT. That is the whole
    point: the band's background IS the band's subject, rather than a texture
    picked to sit behind it. Stretched with preserveAspectRatio="none" because
    it is being read as a shape, not as a measurement; the readable one keeps
    its aspect.

    IT SHOWS ONLY THE FIRST THIRD OF THE COURSE, blown up to fill the band. At
    full width it came out the same scale as the chart drawn over it and the two
    read as one badly printed graph. A watermark has to be unmistakably a
    different size from the thing it sits behind, or it looks like a mistake
    rather than a decision. */
  variant === 'watermark' ? (
    <svg
      class="elev-mark"
      viewBox={`0 0 ${Math.round(wide.W * 0.34)} ${wide.H}`}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d={wide.area} class="elev-mark__area" />
      <path d={wide.line} class="elev-mark__line" />
    </svg>
  ) : (
    <figure class="elev" data-reveal>
      {/* The chart's ONE accessible name lives on the first canvas; the phone
          canvas is a second drawing of the same figure and is hidden from the
          tree, or a screen reader would hear the course described twice. The
          gradient ids are suffixed per canvas because two <linearGradient
          id="elevFill"> in one document resolve to the first one only. */}
      {canvases.map((c, ci) => (
        <svg
          class={c.cls}
          viewBox={`0 0 ${c.W} ${c.H}`}
          role={ci === 0 ? 'img' : undefined}
          aria-labelledby={ci === 0 ? 'elev-title elev-desc' : undefined}
          aria-hidden={ci === 0 ? undefined : 'true'}
        >
          {ci === 0 && (
            <>
              <title id="elev-title">Stone Steps 50K elevation profile</title>
              {/* THE DESCRIPTION IS THE CHART, for anyone who cannot see it, so
                it has to move when the chart does. It used to state 10,726 ft
                and 31 miles as literals, which a measured profile would have
                silently contradicted: the picture would show one race and the
                screen reader would announce another. */}
              <desc id="elev-desc">
                Seven loops from The Oval: four long loops alternating with three short loops of
                just over three miles, totalling{' '}
                {measuredChange ? measuredChange.toLocaleString() : '10,726'} feet of elevation
                change across 31 miles.
              </desc>
            </>
          )}

          <defs>
            <linearGradient id={`elevFill-${ci}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" class="elev__stop-top" />
              <stop offset="100%" class="elev__stop-bottom" />
            </linearGradient>
          </defs>

          {/* Aid-station verticals: you pass through The Oval at the end of every loop. */}
          {!measured &&
            c.markers.map((m) => (
              <g class="elev__aid" style={`--t:${(m.x / c.W).toFixed(3)}`}>
                <line x1={m.x} y1={c.PEAK - 20} x2={m.x} y2={c.BASE} />
                <circle cx={m.x} cy={c.BASE} r={ci === 0 ? 4 : 6} />
              </g>
            ))}

          <path d={c.area} class="elev__area" fill={`url(#elevFill-${ci})`} />
          <path d={c.line} class="elev__line" pathLength="1" />
          <line x1="0" y1={c.BASE} x2={c.W} y2={c.BASE} class="elev__base" />

          {!measured &&
            c.markers.map((m, i) => (
              <text
                x={m.x}
                y={c.BASE + (ci === 0 ? 26 : 34)}
                class={`elev__lbl ${m.kind === 'long' ? 'is-long' : ''}`}
                style={`font-size:${c.lbl}px`}
                text-anchor="middle"
              >
                {i + 1}
              </text>
            ))}
        </svg>
      ))}

      <figcaption class="elev__cap">
        <span class="mono">
          <b>{measuredChange ? `${measuredChange.toLocaleString()} ft` : totalGain}</b> total
          elevation change
        </span>
        {/* THE TRACK'S OWN MILEAGE DOES NOT GO IN THIS NOTE. A GPS track under
            canopy reads short, and this one measures 29.68 against a 50K's
            31.07. On a race page that sentence is not a caption, it is an
            accusation that the course is short, and it would be the first thing
            a runner screenshotted. The profile is drawn from the track; the
            distance is the race's, and the race states it elsewhere. */}
        {measured ? (
          <span class="elev__note">
            Measured from USGS 1 m LiDAR along a recorded run of the course
          </span>
        ) : (
          <span class="elev__note">
            Shape illustrates the loop structure. Not surveyed GPS data
          </span>
        )}
        {gpxUrl && (
          <a class="elev__note" href={gpxUrl} {...externalLinkAttrs(gpxUrl)}>
            Download the course GPX
          </a>
        )}
        {/* A KEY FOR MARKS THAT ARE DRAWN. The aid verticals and their dots are
            rendered only on the synthetic chart, because a measured profile has
            no loop boundaries to hang them on. Left unconditional, the measured
            chart printed a legend dot for a symbol that appears nowhere above
            it, which is the one thing a key must never do. The fact itself is
            not lost: the section's intro says every loop returns you through
            the aid station at The Oval. */}
        {!measured && (
          <span class="elev__key">
            <span class="elev__dot" /> Aid station at the end of every loop
          </span>
        )}
      </figcaption>
    </figure>
  )
}

<style>
  /* ---- The watermark ---------------------------------------------------
     Only ever the ridge. No axis, no markers, no labels: at this size those
     would be a second chart competing with the real one, and the eye would try
     to read numbers off something that is deliberately stretched. */
  .elev-mark {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    height: 78%;
    width: 100%;
    pointer-events: none;
    /* FADED AT THE FOOT. The drawing's baseline sits 42 units up from the
       bottom of its own viewBox (the room the chart keeps for its loop
       numbers), so stretched across the band it ended in a flat filled strip
       with a clean horizontal edge above the bare band below: a gap nobody
       drew. The mask dissolves the bottom fifth, and the top too, so the
       ridge fades into the band on both sides rather than stopping. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 22%,
      #000 66%,
      transparent 96%
    );
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 66%, transparent 96%);
  }
  .elev-mark__area {
    fill: color-mix(in srgb, var(--heading-accent) 6%, transparent);
  }
  .elev-mark__line {
    fill: none;
    stroke: color-mix(in srgb, var(--heading-accent) 16%, transparent);
    stroke-width: 2.5;
    /* The stretch would otherwise thin the line wherever the profile is steep. */
    vector-effect: non-scaling-stroke;
  }
  /* ON A PHONE THE WATERMARK STEPS BACK. At 78% of the band it was three
     times the height of the chart it sits behind, and a background that
     outweighs its subject reads as the subject. A third of the band, and
     fainter, keeps it a watermark. */
  @media (width < 48rem) {
    .elev-mark {
      height: 34%;
    }
    .elev-mark__area {
      fill: color-mix(in srgb, var(--heading-accent) 4%, transparent);
    }
    .elev-mark__line {
      stroke: color-mix(in srgb, var(--heading-accent) 11%, transparent);
    }
  }

  .elev svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  /* One canvas at a time. See the note on `build()` above. Written as
     `.elev .elev__svg--*` because the `.elev svg` rule above is (0,1,1) and a
     bare class is (0,1,0): the first cut of this lost to it and both charts
     rendered, one under the other, on every width. */
  .elev .elev__svg--tall {
    display: none;
  }
  @media (width < 48rem) {
    .elev .elev__svg--wide {
      display: none;
    }
    .elev .elev__svg--tall {
      display: block;
    }
  }

  /* stop-color must be set as a CSS PROPERTY, not a presentation attribute.
     var() does not resolve inside a presentation attribute, so
     stop-color="var(--primary)" silently produced no fill at all: the profile
     rendered as a bare line over empty space. */
  .elev__stop-top {
    stop-color: var(--primary);
    stop-opacity: 0.32;
  }
  .elev__stop-bottom {
    stop-color: var(--primary);
    stop-opacity: 0;
  }

  .elev__line {
    fill: none;
    stroke: var(--heading-accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .elev__base {
    stroke: color-mix(in srgb, var(--foreground) 35%, transparent);
    stroke-width: 1;
  }

  .elev__aid line {
    stroke: color-mix(in srgb, var(--foreground) 22%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  .elev__aid circle {
    fill: var(--foreground);
  }

  /* ---- The profile draws itself -------------------------------------- */
  /* The line is the shape of the race: seven climbs out of The Oval and seven
     drops back into it. Drawing it left to right says that in a way a static
     chart cannot, and it is the reason to animate this rather than a decorative
     one.

     `pathLength="1"` is what makes it JS-free. It renormalises the path's
     length to 1 for dash purposes, so a dasharray of 1 and a dashoffset of 1
     hide exactly the whole line whatever the real geometry is. No measuring, no
     resize handler, and it keeps working when the loop lengths change.

     Aid markers pop as the line reaches them: each carries `--t`, its own
     fraction along the x axis, so its delay is that fraction of the draw.

     The whole thing is inside a no-preference query, so the resting state is
     the FINISHED chart. Under reduced motion, and under the reveal observer's
     own reduced-motion branch, nothing here applies at all. */
  @media (prefers-reduced-motion: no-preference) {
    .elev[data-reveal] .elev__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .elev[data-reveal].is-visible .elev__line {
      transition: stroke-dashoffset 1900ms cubic-bezier(0.33, 0, 0.15, 1);
      stroke-dashoffset: 0;
    }

    .elev[data-reveal] .elev__area {
      opacity: 0;
    }
    .elev[data-reveal].is-visible .elev__area {
      transition: opacity 900ms ease-out 900ms;
      opacity: 1;
    }

    .elev[data-reveal] .elev__aid {
      opacity: 0;
    }
    .elev[data-reveal].is-visible .elev__aid {
      animation: elev-aid 460ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(var(--t, 0) * 1900ms);
    }
  }

  @keyframes elev-aid {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .elev__lbl {
    font-family: var(--font-mono);
    /* Size is set inline per canvas: 15px on the wide one, 26px on the tall. */
    fill: var(--muted-foreground);
  }

  .elev__lbl.is-long {
    fill: var(--foreground);
    font-weight: 700;
  }

  .elev__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--cream-dim);
    text-transform: uppercase;
  }

  .elev__cap b {
    color: var(--heading-accent);
  }

  .elev__key {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .elev__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--foreground);
    display: inline-block;
  }

  .elev__note {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    font-style: italic;
  }
</style>
