---
// Foundation, edit with care
/**
 * The course map section: the framed map and the caption that describes it.
 *
 * THE MAP IS MAPLIBRE. See CourseMapLibre.tsx for why, and for the two
 * public-domain tile sources it uses. This file's job is the shell around it:
 * the framed box, the legend and the figcaption.
 *
 * TWO LISTS USED TO LIVE HERE and were cut on 2026-09-16: the park's toilets
 * and water, and the tally of which trails the course runs on. The facilities
 * list was eleven unnamed rows of mile numbers that no runner could tell apart,
 * for facilities the race does not staff, under a caption saying aid is at The
 * Oval. Both are still DERIVED by scripts/build-course-map.mjs and still sit in
 * course-map.json and course-poi.json, because the map draws the facilities as
 * dots and the trail tally is how we know what the course runs on. Rendering
 * either as a list again is a content decision, not a rebuild.
 *
 * ATTRIBUTION MOVED WITH THEM. The trail tally was OSM-derived text on the page
 * and carried its own ODbL credit; now the only OSM-derived content here is
 * inside the map, and MapLibre's own attribution control covers it. If anything
 * OSM-derived is ever printed in this shell again, its credit has to come back
 * with it, because the map's control is not on the page when the map is not.
 *
 * THE DATA IS NOT EDITORIAL. Everything here comes from
 * scripts/data/course-map.json and course-geo.json, which
 * scripts/build-course-map.mjs derives from the GPS track. Nothing about the
 * route can be typed into the Studio, because a number an editor can retype is
 * a number that can disagree with the course.
 */
import CourseMapLibre from './CourseMapLibre.tsx';
import meta from '../../../scripts/data/course-map.json';

interface Props {
  id?: string;
}

const { id = 'course-map' } = Astro.props as Props;

// THE PUBLISHED LENGTHS. The recorded track reads 5.04 and 3.21, and its own
// laps disagree with each other over ground that cannot change length, so the
// shortfall is GPS under a canopy rather than the course. Distances shown to a
// reader are the race's own; the track is what says where things are.
const longMiles = meta.loops.find((l) => l.kind === 'long')?.publishedMiles ?? 0;
const shortMiles = meta.loops.find((l) => l.kind === 'short')?.publishedMiles ?? 0;
---

<figure class="cmap" id={id} data-course-map>
  {
    /* client:visible, and this one is safe where the old control island was not:
    that island's only child was absolutely positioned inside a
    `display: contents` <astro-island>, so IntersectionObserver had no box to
    observe and it never hydrated. This component's root is the map's own framed
    box, which has a rect, so "when the reader reaches it" works. That timing is
    the point: MapLibre is ~250KB and must not be in the page's measured load. */
  }
  <CourseMapLibre client:visible />

  <figcaption class="cmap__figcap">
    Seven loops out of The Oval: four long loops of about {longMiles} miles alternating with three short
    loops of about {shortMiles} miles.
  </figcaption>
</figure>

<style>
  .cmap {
    margin: 0;
  }

  /* The frame is sized HERE, not by the engine. MapLibre fills whatever box it
     is given, and giving it one that exists before it loads is what stops the
     page reflowing when the map arrives. A phone gets a PORTRAIT box, because
     the course is taller than it is wide. */
  :global(.cmap__frame) {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 70vh;
    overflow: hidden;
    background: var(--color-muted);

    /* NO BORDER AND NO RADIUS. A hairline rectangle around a photograph is the
       thing that makes a map read as an embed rather than as part of the page.
       The edge is the ridge below instead, which is the same contour every band
       on this site is cut with. */

    /* IT ESCAPES THE COLUMN, a little. Not 100vw: that includes the scrollbar
       and produces a horizontal scroll on Windows, which is a worse bug than a
       narrow map. A fixed bleed on each side is predictable and still reads as
       breaking out of the text.

       ONE VARIABLE, USED THREE TIMES. The bleed also has to inset every control
       that sits in a corner, or they hang off the edge of the screen: the first
       version pushed the play button half out of the viewport and cut the scale
       bar in two. Deriving the insets from the same number is what keeps them
       together when it changes. */
    /* 1.5rem IS ALWAYS SAFE because it is exactly the content column's own
       px-6 padding, so the frame reaches the column's outer edge and no
       further. */
    --cmap-bleed: 1.5rem;
    margin-inline: calc(-1 * var(--cmap-bleed));
  }

  /* 16:9 EARLIER THAN THE BIGGER BLEED. The shape is safe at any width; the
     bleed is not. */
  @media (min-width: 64rem) {
    :global(.cmap__frame) {
      aspect-ratio: 16 / 9;
    }
  }

  /* A DEEPER BLEED ONLY WHERE THERE IS PROVABLY ROOM FOR IT. The content column
     maxes out at --container-content (82.5rem), so free space beside it only
     exists past that width; below it the column is viewport-bound and there is
     nothing to bleed into but the padding. Setting 4rem at 64rem overflowed the
     page by 40px at exactly 1024px, which the reflow test caught. 96rem leaves
     108px of free space each side for a 64px bleed. */
  @media (min-width: 96rem) {
    :global(.cmap__frame) {
      --cmap-bleed: 4rem;
    }
  }

  /* MapLibre puts its own controls in the frame's corners, which the bleed has
     just moved off screen. Shift each corner in by the bleed. */
  :global(.cmap__frame .maplibregl-ctrl-bottom-left) {
    left: var(--cmap-bleed);
    bottom: 1.4rem;
  }

  :global(.cmap__frame .maplibregl-ctrl-bottom-right) {
    right: var(--cmap-bleed);
    bottom: 1.4rem;
  }

  :global(.cmap__frame .maplibregl-ctrl-top-right) {
    right: var(--cmap-bleed);
    top: 1.2rem;
  }

  :global(.cmap__canvas) {
    position: absolute;
    inset: 0;
  }

  /* THE SAME CUT AS EVERY BAND ON THIS SITE. --ridge-mask is the contour the
     page already separates its bands with, drawn off the topography this course
     runs over. Using it here means the map is bounded by terrain rather than by
     a box, and it is the difference between a widget dropped on the page and a
     band of the page that happens to be alive.

     Painted in the BAND'S colour, passed down as --cmap-band-bg, so the cut is
     the band closing over the map exactly as one band closes over another. */
  :global(.cmap__ridge) {
    position: absolute;
    inset-inline: 0;
    height: 34px;
    background-color: var(--cmap-band-bg, var(--color-background));
    pointer-events: none;
    z-index: 1;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  :global(.cmap__ridge.is-top) {
    top: 0;
    /* The band mask draws the solid part BELOW the contour, so the top edge
       uses it flipped. */
    transform: scaleY(-1);
    -webkit-mask-image: var(--ridge-mask);
    mask-image: var(--ridge-mask);
  }

  :global(.cmap__ridge.is-bottom) {
    bottom: 0;
    -webkit-mask-image: var(--ridge-mask);
    mask-image: var(--ridge-mask);
  }

  @media (width < 48rem) {
    :global(.cmap__ridge) {
      height: 22px;
    }
  }

  /* ---- the floating control bar ----------------------------------------- */

  :global(.cmapbar) {
    position: absolute;
    left: calc(var(--cmap-bleed) + 0.9rem);
    /* CLEAR OF MAPLIBRE'S OWN BOTTOM ROW, AND OF A CREDIT THAT WRAPS. The scale
       bar and the attribution sit at 1.4rem; measured, a 3.4rem bar overlapped
       the scale by 7px, which is the sort of thing that reads as sloppy rather
       than as a bug.

       3.9rem WAS ENOUGH FOR A ONE-LINE CREDIT ONLY. The expanded attribution
       grows UPWARDS, and at 720px, the exact width at which CourseMapLibre
       stops collapsing it, the credit needs about 711px of frame and has 681,
       so it wraps to two lines. The bar's foot was at 62.4px off the frame and
       the wrapped credit's head at 76.4px, so the first line ran UNDER the bar
       and the words "Elevation: AWS Terrain Tiles | Map data (c) OpenStreetMap"
       were hidden behind it. A licence credit is the one thing on this map that
       may not be covered. Swept 390 to 1600: 720 is the only width that does it
       today, which is exactly why this is worth clearing rather than nudging,
       because one more character in the credit moves that window rather than
       closing it.

       THE NUMBER IS DERIVED, NOT TRIED. MapLibre's own control carries a 10px
       margin inside the 1.4rem corner inset, so the credit's foot is at 32.4px
       and two lines of it are 44px, putting its head at 76.4px. 5.25rem is 84px,
       which clears that by 7.6px, and it also opens the gap to the scale bar
       from the 2px the old value left to 19.6px. The phone rule below keeps its
       own value: there the credit is collapsed to its button and cannot wrap. */
    bottom: 5.25rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0.3rem;
    border-radius: 999px;
    /* Glass, but with a solid fallback first: backdrop-filter is still absent
       on some browsers and a transparent bar over a forest is unreadable. */
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    box-shadow: var(--lift-sm);
  }

  /* 82%, NOT 62%, AND THE GLASS IS STILL GLASS. Measured on a phone at 390px
     against the live aerial photograph, sampling the button faces across
     sixteen moments of a real flight with the labels made transparent so the
     pixels are the background and nothing else: at 62% the worst frame put
     cream labels on rgb(110,111,87) at 4.38:1, under AA's 4.5, and the bright
     horizon at the top of a 74 degree pitch computes worse still. It is the
     same failure the hero's subhead and the countdown's label each had, and it
     has the same cause: ink whose contrast depends on where the terrain happens
     to fall is not ink with contrast. At 82% the same measurement gives 10.71
     in dark and 12.21 in light, and the blur and the saturate are untouched, so
     the bar still reads as glass over the map rather than as a panel. */
  @supports (backdrop-filter: blur(8px)) {
    :global(.cmapbar) {
      background: color-mix(in srgb, var(--color-background) 82%, transparent);
      backdrop-filter: blur(10px) saturate(1.15);
    }
  }

  :global(.cmapbar__btn) {
    padding: 0.32rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* The glyph sits ON the baseline of the label rather than centred on the
     button, because a triangle centred against uppercase text reads as sitting
     slightly low. inline-flex on the button and a fixed box here keeps the
     label in exactly the same place whether the glyph is a triangle or a
     square, so the bar does not twitch when the flight starts. */
  :global(.cmapbar__btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  :global(.cmapbar__glyph) {
    width: 0.7em;
    height: 0.7em;
    flex: none;
    fill: currentcolor;
  }

  :global(.cmapbar__btn:hover:not(:disabled)) {
    background: color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  :global(.cmapbar__btn:focus-visible) {
    outline: 2px solid var(--color-ring);
    outline-offset: 1px;
  }

  :global(.cmapbar__btn:disabled) {
    opacity: 0.45;
    cursor: default;
  }

  :global(.cmapbar__btn.is-primary) {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }

  @media (max-width: 40rem) {
    :global(.cmapbar) {
      left: calc(var(--cmap-bleed) + 0.5rem);
      right: calc(var(--cmap-bleed) + 0.5rem);
      bottom: 4.2rem;
      justify-content: center;
    }
  }

  /* ---- the flight HUD ---------------------------------------------------- */

  /* SAME TREATMENT AS THE CONTROL BAR, on purpose: glass over the terrain with
     a solid fallback first, so the two things sitting on the map read as one
     family rather than as two widgets. Top-left is the only free corner:
     MapLibre's zoom and compass stack is top-right, its attribution is
     bottom-right, and the control bar is bottom-left. The top offset clears the
     ridge that cuts the frame's top edge. */
  :global(.cmaphud) {
    position: absolute;
    top: 2.6rem;
    left: calc(var(--cmap-bleed) + 0.9rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.85rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    box-shadow: var(--lift-sm);
    pointer-events: none;
  }

  /* 82%, for the reason written over the control bar's own @supports block,
     and measured the same way: the HUD's second line is 13px muted ink and at
     62% it measured 4.40 in dark and 4.28 in light across twenty-four moments
     of a real flight, both under 4.5; at 82% the same line reads 6.77 and 5.69,
     and the big mile figure 9.88 and 13.68. The two panels share the number
     because they are meant to read as one family. */
  @supports (backdrop-filter: blur(8px)) {
    :global(.cmaphud) {
      background: color-mix(in srgb, var(--color-background) 82%, transparent);
      backdrop-filter: blur(10px) saturate(1.15);
    }
  }

  /* BIG, because the whole point of moving this onto the map is that it can be
     read without looking away from the terrain. */
  :global(.cmaphud__mile) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-foreground);
    /* Tabular figures so the number does not jitter sideways as it counts. */
    font-variant-numeric: tabular-nums;
  }

  :global(.cmaphud__row) {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    :global(.cmaphud) {
      padding: 0.4rem 0.65rem;
    }

    :global(.cmaphud__mile) {
      font-size: 1.15rem;
    }

    :global(.cmaphud__row) {
      font-size: 0.75rem;
      gap: 0.55rem;
    }
  }

  /* Over the canvas, under the ridge and the controls. */
  :global(.cmap__vignette) {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 45%,
      transparent 42%,
      rgb(0 0 0 / 22%) 78%,
      rgb(0 0 0 / 38%) 100%
    );
  }

  /* ABOVE THE RIDGE. The bottom ridge is band-coloured and 34px tall, so a bar
     drawn under it would be invisible for the whole flight. */
  :global(.cmap__flightbar) {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    height: 3px;
    pointer-events: none;
    background: color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  :global(.cmap__flightbar-fill) {
    display: block;
    height: 100%;
    /* TRANSFORM, NOT WIDTH. The fill is the full width of the frame and is
       scaled down; animating width would lay the page out again on every one of
       the ninety seconds' worth of frames. */
    transform-origin: left center;
    background: var(--color-primary);
  }

  :global(.cmap__status) {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }

  .cmap__figcap {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }

  :global(.cmap__cap) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }

  :global(.cmap__key) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.cmap__swatch) {
    width: 1.4rem;
    height: 0;
    border-top: 3px solid currentcolor;
    display: inline-block;
  }

  /* THESE MATCH THE LAYER COLOURS IN CourseMapLibre.tsx, and they are literals
     on both sides on purpose. The map paints over an aerial photograph, not
     over the page, so its line colours are chosen to carry on foliage rather
     than to match the theme; pointing the legend at --color-primary would make
     the swatch drift away from the line it describes the next time the brand
     moves. */
  :global(.cmap__swatch.is-long) {
    border-color: #e2593c;
  }

  :global(.cmap__swatch.is-short) {
    border-top-style: dashed;
    border-color: #ffd9a0;
  }

  /* Half rust, half cream, because the markers come in both: one swatch that
     says "these dots" without claiming either loop. */
  :global(.cmap__swatch.is-mile) {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-foreground);
    background: linear-gradient(90deg, #e2593c 0 50%, #f6d9b0 50% 100%);
  }

  :global(.cmap__swatch.is-oval) {
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--color-foreground);
    border-radius: 50%;
    background: #fff;
  }

  :global(.cmap3d__btn) {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  :global(.cmap3d__btn:hover) {
    background: var(--color-muted);
  }

  :global(.cmap3d__btn:focus-visible) {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  :global(.cmap3d__hint) {
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 640px) {
    :global(.cmap__frame) {
      aspect-ratio: 3 / 4;
      max-height: 65vh;
    }
  }

  /* ---- the profile strip / flyover scrubber ----------------------------- */

  :global(.cprof) {
    margin-top: 0.75rem;
  }

  :global(.cprof__svg) {
    display: block;
    width: 100%;
    height: 120px;
    cursor: crosshair;
    touch-action: pan-y;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-muted);
  }

  /* The bands alternate so the seven loops are countable without reading the
     numbers, and the long/short rhythm is visible as a rhythm. */
  :global(.cprof__band.is-odd) {
    fill: color-mix(in srgb, var(--color-secondary) 12%, transparent);
  }

  :global(.cprof__band.is-even) {
    fill: transparent;
  }

  :global(.cprof__band.is-dim) {
    fill: color-mix(in srgb, var(--color-muted-foreground) 26%, transparent);
  }

  :global(.cprof__area) {
    fill: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  :global(.cprof__line) {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  :global(.cprof__loopNum) {
    fill: var(--color-muted-foreground);
    font-size: 11px;
    font-family: var(--font-body);
  }

  :global(.cprof__cursor line) {
    stroke: var(--color-foreground);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  :global(.cprof__cursor circle) {
    fill: #ffd9a0;
    stroke: var(--color-foreground);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* A PLACED MARKER LOOKS PLACED. Same shape, filled in the route's own colour
     and with a heavier rule, so a reader who moved the pointer away can tell at
     a glance that the playhead is something they left there rather than
     something that failed to clear. */
  :global(.cprof__cursor.is-pinned circle) {
    /* The literal, for the reason given above the legend swatches. */
    fill: #e2593c;
  }

  :global(.cprof__cursor.is-pinned line) {
    stroke-width: 2;
  }

  :global(.cprof__readout) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
    /* RESERVED HEIGHT. Without it the readout appears and disappears as the
       pointer enters and leaves the profile, and the whole page below it jumps
       by a line every time. */
    min-height: 1.3rem;
  }

  :global(.cprof__readout b) {
    color: var(--color-foreground);
  }

  :global(.cprof__sliderLabel) {
    display: block;
    margin-top: 0.4rem;
  }

  /* Visually hidden, not display:none: the slider is the keyboard path to the
     scrubber and its label has to reach a screen reader. */
  :global(.cprof__sliderText) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(.cprof__slider) {
    width: 100%;
    accent-color: var(--color-primary);
  }

  /* ---- loop chips -------------------------------------------------------- */

  :global(.cmaploops) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }

  :global(.cmaploops__chip) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  :global(.cmaploops__chip:hover) {
    background: var(--color-muted);
  }

  :global(.cmaploops__chip:focus-visible) {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  :global(.cmaploops__chip.is-on) {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    border-color: var(--color-primary);
  }

  :global(.cmaploops__miles) {
    font-size: 0.6875rem;
    opacity: 0.75;
  }

  /* ---- gradient legend --------------------------------------------------- */

  /* THE RAMP IS PAINTED FROM GRADE_STOPS, in the component, through
     gradeRampCss. It used to be a seven-colour linear-gradient written out
     again here, which is a second copy of the map's own ramp with nothing
     keeping the two the same. Everything left in this file is shape and type;
     the colours belong to the map. */
  :global(.cmapgrade) {
    align-items: flex-start;
  }

  :global(.cmapgrade__bar) {
    display: grid;
    gap: 0.15rem;
    width: 7.5rem;
  }

  :global(.cmapgrade__ramp) {
    display: block;
    height: 0.55rem;
    border-radius: 999px;
    /* A HAIRLINE, BECAUSE THE MIDDLE OF THE RAMP IS ALMOST WHITE. #f2efe6 is
       flat ground, and on the cream page it has nothing to sit against: without
       an edge the bar reads as two coloured blobs with a gap between them
       rather than as one continuous scale. In dark mode the ends need it just
       as much at the other extreme. */
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 30%, transparent);
  }

  :global(.cmapgrade__scale) {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted-foreground);
  }

  :global(.cmap3d__btn.is-primary) {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    border-color: var(--color-primary);
  }

  :global(.cmap3d__btn.is-primary:hover:not(:disabled)) {
    background: var(--color-primary-dark, var(--color-primary));
  }

  :global(.cmap3d__btn:disabled) {
    opacity: 0.5;
    cursor: default;
  }

