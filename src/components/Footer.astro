---
// Foundation, edit with care
//
// The footer, as the trail sign at the finish.
//
// WHAT CHANGED AND WHY (2026-09-12). This was the starter's generic footer with
// a race band bolted on the top: five columns of body-face links (Studio, Work,
// Free tools, Latest projects, Get in touch), an optional newsletter, and the
// mark floating unanchored in the middle of them. Three of those columns were
// for a design studio and never rendered here, one ran a portfolio query on
// every build that could only ever return nothing, and the two that did render
// came through Sanity and were set in the same 14px as the copyright.
//
// The mobile menu had already settled what this site's navigation looks like
// when it is allowed to be loud, and the end of a page is the one place where
// nothing competes with it. So the footer is now that board: contours and a
// walk of prints behind it, the race date at poster size, the links as numbered
// rows in the display face, and the mark on the header's own nailed plate.
// Everything reference rather than navigation (where the race is, who to ask,
// the socials) is a small rail beside them. The style lives in globals.css
// under "The footer, as the trail sign at the finish".
//
// THE STARTER BRANCHES ARE GONE, NOT HIDDEN. Newsletter, latest projects and
// the three studio columns are deleted outright rather than left behind a flag.
// They were the reason another client's logo sat at the bottom of every page of
// this site until 2026-09-09: dead branches nobody reads are where fork
// artefacts survive. If the race ever wants a newsletter, it is a section in
// the page builder, not a footer special case.
//
// EVERY LINK IS EDITOR-DRIVEN. The columns come from Site settings -> Footer
// columns. The built-in fallback below is this race's own pages, so a dataset
// with nothing in that field still gets a usable footer instead of a design
// studio's sitemap.

import { site } from '@/data/site';
import {
  IconBrandInstagram,
  IconBrandFacebook,
  IconBrandLinkedin,
  IconBrandPinterest,
  IconBrandYoutube,
  IconBrandTiktok,
  IconBrandX,
  IconLink,
} from '@tabler/icons-react';
import { Phone } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton';
import { externalLinkAttrs } from '@/lib/links';
import { getRace } from '@/lib/queries';
// THE SVG, NOT THE PNG. The .png files in src/assets were the REID DESIGN
// wordmark, inherited from the repo this project was forked from, and this
// footer was still importing them: another client's logo sat at the bottom of
// every page of this site. The header had already been moved to the real Stone
// Steps mark in the reskin and the footer was missed, because nobody scrolls to
// the bottom of a page they are building. The PNGs are deleted; if an import of
// them ever reappears, it is a fork artefact, not a design choice.
import logoLightAsset from '@/assets/logo-light.svg';
import logoDarkAsset from '@/assets/logo-dark.svg';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { telHref } from '@/lib/phone';

// THE RACE BAND. Everything here is read from the `race` singleton, so the day
// it is edited in the Studio the footer follows and nobody has to remember this
// file exists.
const race = await getRace().catch(() => null);
const raceDate = race?.raceDate ? new Date(race.raceDate) : null;
const raceDateLabel = raceDate
  ? raceDate.toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC', // the date is a race day, not an instant; UTC keeps it from sliding a day
    })
  : null;
const raceIsUpcoming = raceDate ? raceDate.getTime() > Date.now() : false;
/** "23rd" without a lookup table, and correct for 11th/12th/13th. */
function ordinal(n: number): string {
  const rem100 = n % 100;
  if (rem100 >= 11 && rem100 <= 13) return `${n}th`;
  return `${n}${['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
}
const editionLabel = race?.editionNumber ? `${ordinal(race.editionNumber)} running` : null;
const wherePlace = [race?.venue, [race?.city, race?.region].filter(Boolean).join(', ')]
  .filter(Boolean)
  .join(' · ');

// The imported asset's own hashed URL. See the note in Header.astro: routing an
// SVG through getImage() gains nothing and 400s in dev under this adapter.
const footerLogoLight = logoLightAsset.src;
const footerLogoDark = logoDarkAsset.src;

interface SocialLink {
  platform?: string;
  url?: string;
  label?: string;
}

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        title?: string;
        email?: string;
        phone?: string;
        socialInstagram?: string;
        socialFacebook?: string;
        socialLinks?: SocialLink[] | null;
        tagline?: string;
        footerCredit?: string;
        footerCreditUrl?: string;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

// The chrome (footer columns, the small-print row, the social switch) resolves
// through one shared helper (see src/lib/siteSettings.ts) so the footer cannot
// drift from the header.
const chrome = resolveSiteSettings(siteSettings);

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';

// Social links: prefer the new socialLinks array; fall back to the legacy
// socialInstagram / socialFacebook fields so existing datasets keep working.
const showFooterSocials = chrome.showFooterSocials;
const rawSocialLinks = showFooterSocials ? (siteSettings?.socialLinks ?? []) : [];
const ig = showFooterSocials ? (siteSettings?.socialInstagram ?? '') : '';
const fb = showFooterSocials ? (siteSettings?.socialFacebook ?? '') : '';
const socialLinksToRender: SocialLink[] =
  rawSocialLinks.length > 0
    ? rawSocialLinks.filter((l) => l?.url)
    : [
        ...(ig ? [{ platform: 'Instagram', url: ig }] : []),
        ...(fb ? [{ platform: 'Facebook', url: fb }] : []),
      ];

/** Map a platform name to a Tabler icon component. */
function socialIcon(platform: string | undefined) {
  switch (platform) {
    case 'Instagram':
      return IconBrandInstagram;
    case 'Facebook':
      return IconBrandFacebook;
    case 'LinkedIn':
      return IconBrandLinkedin;
    case 'Pinterest':
      return IconBrandPinterest;
    case 'YouTube':
      return IconBrandYoutube;
    case 'TikTok':
      return IconBrandTiktok;
    case 'X':
      return IconBrandX;
    // Tabler has no Houzz brand icon; the generic link icon covers it.
    default:
      return IconLink;
  }
}

const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;
const LEGAL_LINKS = chrome.legalNav;

// THIS RACE'S OWN PAGES, as the fallback when Site settings carries no footer
// columns. The starter's fallback here was Studio / Work / Free tools, which is
// a design studio's sitemap and would 404 five times over on this site.
const BUILT_IN_COLUMNS = [
  {
    title: 'The race',
    links: [
      { label: 'The Race', href: '/' },
      { label: 'Course', href: '/course' },
      { label: 'Records', href: '/records' },
      { label: 'Results', href: '/results' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
const columns = chrome.footerColumns.length > 0 ? chrome.footerColumns : BUILT_IN_COLUMNS;

// WHICH ROW IS STRUCK. The rows carry `aria-current="page"` the way the mobile
// menu's do, so the footer says where you are instead of listing five places
// identically. Trailing slash normalised: Astro serves "/course" and "/course/"
// as the same page and the nav data spells it one way.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHere = (href: string) => (href.replace(/\/+$/, '') || '/') === here;

/** "01", "02"... the index a numbered row wears. */
const idx = (i: number) => String(i + 1).padStart(2, '0');

// A LONG LABEL GETS A SMALLER ROW. The numbered rows are set in the display
// face at up to 1.9rem, which suits "Records" and "Facebook group" and does not
// suit the venue address, which one of the live columns carries as its only
// entry: at row size it wrapped to three lines and read as a headline nobody
// wrote. The length is known here at build time, so the step is decided in
// Astro rather than guessed at in CSS, where there is no way to ask how long a
// string is.
const LONG_LABEL = 18;
const rowClass = (label: string) =>
  label.length > LONG_LABEL ? 'foot-link__label foot-link__label--long' : 'foot-link__label';
---

{
  /* THE BOARD. Its ground is a literal one step deeper than the page's, set in
    globals.css rather than with `bg-muted`: muted is seven units off the body
    on the cream theme, which left the torn top edge with nothing to cut. */
}
<footer class="site-foot text-foreground">
  {
    /* The backdrop: one baked field of mud and prints, out of the flow, and
      marked as media so the contrast gate samples the pixels under the type.
      See .foot-mud in globals.css for why it is one layer and not two. */
  }
  <div class="foot-mud" aria-hidden="true" data-contrast-media></div>

  {
    /* NEXT RUNNING, at poster size. Only while the date is still ahead: a
      footer advertising a race that already happened is worse than one that
      says nothing, and this is the line nobody would remember to take down. */
  }
  {
    raceDateLabel && raceIsUpcoming && (
      <div class="foot-z border-b border-border/60">
        <div class="mx-auto flex max-w-content flex-col items-start gap-m px-6 py-l md:flex-row md:items-end md:justify-between">
          <div>
            <p class="blaze text-heading-accent mb-2 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
              Next running
            </p>
            <p class="foot-date">{raceDateLabel}</p>
            <p class="mt-3 text-sm text-foreground/80">
              {[editionLabel, wherePlace].filter(Boolean).join(' · ')}
            </p>
          </div>
          {race?.registerUrl && (
            <a
              class="btn-plate btn-plate--cream"
              href={race.registerUrl}
              {...externalLinkAttrs(race.registerUrl)}
            >
              Register
              <span class="btn-plate__arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          )}
        </div>
      </div>
    )
  }

  {
    /* THE ROWS AND THE RAIL. Three tracks at lg: the numbered columns take a
      fraction each and the reference rail sits beside them. Below lg they
      stack, rows first, because navigation is what a visitor came down here
      for and the address is what they will read once. */
  }
  <div
    class="foot-z mx-auto grid max-w-content gap-l px-6 pt-l pb-m lg:grid-cols-[1fr_minmax(0,16rem)]"
  >
    {
      /* AUTO-FIT, NOT A COUNT. The columns come from Site settings and there
        can be one of them or four, so the track list is computed from the
        available width rather than written down here. A hardcoded three-track
        grid put the rail on a fourth track and then wrapped it to its own row
        the moment a third column was added, which is exactly what the live
        dataset does. */
    }
    <div class="foot-cols">
      {
        columns.map((col, colIdx) => (
          <nav class="foot-col" aria-labelledby={`foot-col-${colIdx}`}>
            <p id={`foot-col-${colIdx}`} class="foot-col__title">
              {col.title}
            </p>
            <ul class="foot-list">
              {col.links.map((link, i) => (
                <li class="foot-item">
                  <a
                    href={link.href}
                    class="foot-link"
                    aria-current={isHere(link.href) ? 'page' : undefined}
                    {...externalLinkAttrs(link.href)}
                  >
                    {/* A ONE-ROW COLUMN IS NOT A LIST. The numbers exist so four
                    rows read as a route to follow down; "01" on its own above
                    nothing is just a decoration that raises a question. The
                    live "Where" column is exactly this case. */}
                    {col.links.length > 1 && (
                      <span class="foot-link__idx" aria-hidden="true">
                        {idx(i)}
                      </span>
                    )}
                    <span class={rowClass(link.label)}>{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {
      /* The reference rail. A description list because that is what it is:
        labelled facts, not another menu.

        NO "WHERE" ROW HERE. The first cut had one, reading the venue off the
        race singleton, and on the live dataset the footer then said where the
        race is three times: in the Next running line directly above, in this
        rail, and in the editor's own "Where" column beside it. The line above
        is the one that cannot be switched off, so it wins. */
    }
    <div class="foot-rail">
      <dl class="m-0">
        <dt>Get in touch</dt>
        <dd>
          {email && <CopyEmailButton client:visible email={email} variant="link" />}
          {
            phone && (
              <a
                href={telHref(phone)}
                class="inline-flex items-center gap-xs text-link transition-colors hover:text-primary-dark"
              >
                <Phone size={14} aria-hidden="true" />
                {phone}
              </a>
            )
          }
          {
            /* Without an email or phone on file this used to render the brand
              name and nothing else, which is not a way to get in touch. */
          }
          {
            !email && !phone && (
              <a class="text-link underline-offset-2 hover:underline" href="/contact">
                Ask the race director
              </a>
            )
          }
          {
            race?.directorName && (
              <span class="mt-1 block text-foreground/75">{race.directorName}, race director</span>
            )
          }
        </dd>
        {
          socialLinksToRender.length > 0 && (
            <>
              <dt>Elsewhere</dt>
              <dd>
                <ul class="flex list-none gap-s p-0">
                  {socialLinksToRender.map((link) => {
                    const Icon = socialIcon(link.platform);
                    const ariaLabel = link.label ?? link.platform ?? 'Social link';
                    return (
                      <li>
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={ariaLabel}
                          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary-dark hover:bg-primary-dark hover:text-white"
                        >
                          <Icon size={20} stroke={1.5} />
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </dd>
            </>
          )
        }
      </dl>

      {
        /* THE MARK, MOUNTED. Same nailed plate the header wears, bigger and
          turned the other way, so the two boards read as the same sign seen at
          opposite ends of the page. */
      }
      <div class="mt-l flex items-center gap-m">
        <a href="/" aria-label={`${brandName} home`} class="sign-badge foot-badge shrink-0">
          {
            /* The mark is the race's own painted trail sign, portrait at
              108x180, so it is sized by HEIGHT and its width follows. An
              unloaded lazy image with width:auto shrink-wraps to 0x0, never
              intersects the viewport and never loads, which is how the sponsor
              logos vanished earlier in this build: give it real dimensions. */
          }
          <img
            alt={brandName}
            width={108}
            height={180}
            class="h-[5.5rem] w-auto"
            loading="lazy"
            decoding="async"
            data-theme-logo
            src={footerLogoLight}
            data-logo-light-src={footerLogoLight}
            data-logo-light-srcset={footerLogoLight}
            data-logo-dark-src={footerLogoDark}
            data-logo-dark-srcset={footerLogoDark}
          />
        </a>
        {
          siteSettings?.tagline && (
            <p class="text-sm text-foreground/80 italic">{siteSettings.tagline}</p>
          )
        }
      </div>
    </div>
  </div>

  {
    /* The base rail: copyright, small print and the credit on one line, so they
      never grow into a column of their own. */
  }
  <div class="foot-base foot-z">
    <div
      class="mx-auto flex max-w-content flex-col items-center justify-center gap-xs px-6 py-m text-center text-xs text-foreground/80 sm:flex-row sm:justify-between"
    >
      <p>© {currentYear} {brandName}</p>
      <div class="flex items-center gap-m">
        {
          /* The starter's fallback here was a hardcoded "Privacy policy" link.
            This site has no privacy route, because the race does not have that
            page, and a footer link to a 404 is worse than no link at all. */
        }
        {
          LEGAL_LINKS.map((l) => (
            <a
              href={l.href}
              class="underline underline-offset-2 transition-colors hover:text-link"
              {...externalLinkAttrs(l.href)}
            >
              {l.label}
            </a>
          ))
        }
        {
          siteCredit && (
            <span>
              Designed by{' '}
              {siteCreditUrl ? (
                <a
                  href={siteCreditUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-2 transition-colors hover:text-link"
                >
                  {siteCredit}
                </a>
              ) : (
                siteCredit
              )}
            </span>
          )
        }
      </div>
    </div>
  </div>
</footer>
