---
// Foundation, edit with care
//
// The numbers row. Four figures about the race, set as a table rather than a
// row of badges (the reasoning is in StatsCounter.tsx).
//
// WHERE THE FIGURES COME FROM. An item may be typed by hand, or it may name a
// SOURCE and be derived here at render time. This file is the only place that
// gathers the facts; the arithmetic and the rules live in src/lib/stat-sources.ts,
// which is pure and unit tested. The two halves of the gathering are different
// in kind on purpose:
//
//   - The race document's measured climb and edition number arrive through the
//     section's own projection, because they are CONTENT and an editor can
//     change them.
//   - The course distance and the loop count are read straight out of
//     scripts/data/course-map.json, because they are DERIVED FROM THE GPS TRACK
//     by scripts/build-course-map.mjs and there is nothing for an editor to
//     change. The race components do the same (see CourseMap.astro).
//
// A derived item whose fact is missing is DROPPED rather than falling back to
// its stored number: that stored number is exactly the thing that could not be
// trusted.
//
// THE BAND CAN WEAR A LABEL NOW (2026-09-17). `statSection` has carried an
// optional `heading` field since it was written and SectionRenderer threw it
// away, so an editor could type one and watch nothing happen. It is rendered as
// `.section-label`, the outlined display word every other content band wears,
// because this band IS a content band: it takes a surface from the cadence and
// it is a stretch of the page rather than an object sitting on it. Nothing is
// added to the schema to get this, and a band with no heading typed renders
// exactly as it did.
import StatsCounter from './StatsCounter';
import courseMap from '../../scripts/data/course-map.json';
import { resolveStats, type RawStat } from '@/lib/stat-sources';
import type { ProjectedStatSection } from '@/lib/pageBuilder.types';

interface Props {
  stats: RawStat[];
  race?: ProjectedStatSection['race'];
  /** Optional band label, set as the outlined display word. */
  heading?: string;
}

const { stats = [], race, heading } = Astro.props as Props;

const resolved = resolveStats(stats, {
  gainFt: race?.elevationProfile?.gainFt ?? null,
  editionNumber: race?.editionNumber ?? null,
  // The race's own published length, not the track's raw 30.11 miles: the
  // track is what says where things are, the published figure is what the
  // race calls the course. Same call the map's caption makes.
  courseMiles: courseMap.publishedTotalMiles ?? null,
  loopCount: courseMap.loops?.length ?? null,
});
---

{
  resolved.length > 0 && (
    <section class="bg-background" aria-label="Race numbers">
      <div class="mob-center mx-auto max-w-content px-6 py-section-md">
        {heading && <p class="section-label mb-6 text-foreground/80">{heading}</p>}
        <StatsCounter stats={resolved} client:visible />
      </div>
    </section>
  )
}
