---
import { ctaHref } from '@/lib/cta-href';
import { withTrailingSlash } from '@/lib/href';
// Safe to edit by hand
// Resolves a Sanity ctaBlock to the right <a href> through the starter's
// ctaHref() (src/lib/cta-href.ts, PORTABLE, starter PORTS.md card 187): the
// referenced page's route, an external URL (new tab by default), mailto: or tel:.
// The race site adds one escape hatch on top, `internalPath` (below).
//
// ONE BUTTON FAMILY: BOTH VARIANTS ARE SIGN PLATES (2026-09-17).
//   This component arrived from the generic starter with a bronze pill for
//   `primary` and an OUTLINED bronze link for `secondary`. Every button drawn
//   by this site's own components is a sign plate instead: the logo's badge,
//   rounded rectangle, black edge, offset shadow, leaning forward (.btn-plate
//   in globals.css). Most callers had already worked around the mismatch by
//   passing `class="btn-plate"`, which won because .btn-plate is unlayered and
//   Tailwind's utilities are not. The two that had not — the "Ask a question"
//   buttons on /course and /contact — were the only outlined buttons left on
//   the site, and they read as a control from a different product.
//   So the variants now MAP ONTO THE PLATES rather than sitting beside them:
//     - "primary"   → the rust plate (.btn-plate)
//     - "secondary" → the cream plate (.btn-plate.btn-plate--cream)
//   There is deliberately no third, un-plated variant. A caller that wants a
//   quieter link should use a link, not a button.
//
//   The callers still passing `class="btn-plate btn-plate--cream"` keep
//   working and are left alone on purpose: class:list de-duplicates, so they
//   render exactly what they rendered before, and they are explicit about
//   which plate they want.
//
// `onDark` no longer touches the variant colours, because a plate carries its
//   own stock and its own ink and is legible on bark, on forest and on cream
//   alike (see the plate tokens in globals.css). It still moves the FOCUS RING
//   offset, which has to be transparent over a photograph rather than the page
//   background, or the ring draws a pale rectangle on the image.
//
// Both variants keep a 44×44 minimum tap target.

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  /** For internal routes with no document to reference, like /results. */
  internalPath?: string;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

interface Props {
  cta?: CtaBlock | null;
  variant?: 'primary' | 'secondary';
  /** When true, offset the focus ring against a photograph rather than the page. */
  onDark?: boolean;
  /** Fallback href if the CTA can't be resolved (e.g., siteSettings hasn't been populated). */
  fallbackHref?: string;
  /** Fallback label if cta.label is missing. */
  fallbackLabel?: string;
  class?: string;
}

const {
  cta,
  variant = 'primary',
  onDark = false,
  fallbackHref = '/contact/',
  fallbackLabel = 'Get in touch',
  class: extraClass = '',
} = Astro.props as Props;

// Where the button goes. The resolver is the starter's ctaHref(), shared with
// anything else that needs a button's destination (the accent budget, card 158).
// The race site's one addition: `internalPath`, a typed path for file routes
// with no document to reference (/results/, /records/). A picked page still wins
// over a typed path, so a slug change cannot strand a button.
function resolveHref(c?: CtaBlock | null): string {
  if (c?.linkType === 'internal' && !c.internalLink?._type && c.internalPath) {
    return withTrailingSlash(c.internalPath);
  }
  return ctaHref(c, fallbackHref);
}

// A button object with nothing filled in (an optional button left empty, PORTS.md card 178)
// draws nothing, rather than the fallback label. No cta at all still takes the fallbacks.
const isEmpty =
  cta != null &&
  !cta.label &&
  !cta.linkType &&
  !cta.internalLink &&
  !cta.internalPath &&
  !cta.externalUrl &&
  !cta.emailAddress &&
  !cta.phoneNumber;
const href = resolveHref(cta);
const label = cta?.label ?? fallbackLabel;
const isExternal = cta?.linkType === 'external';
const newTab = cta?.openInNewTab || isExternal;

// The plate sets its own font, size, padding, radius and border, and it is
// unlayered so it wins over the utilities below. What survives from this line
// is the tap target, the focus ring and the press easing.
//
// Focus ring offset uses --background by default, but under onDark we offset
// against transparent so the ring still reads on the photographic surface.
const baseClasses = onDark
  ? 'press-tactile inline-flex min-h-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
  : 'press-tactile inline-flex min-h-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

// The rust plate leads, the cream plate follows. Same object, two stocks, and
// the pair reads as one family the moment either is hovered: the cream face
// turns rust and its ink flips to the primary plate's cream.
const variantClasses = variant === 'primary' ? 'btn-plate' : 'btn-plate btn-plate--cream';
---

{!isEmpty && (
  <a
    href={href}
    class:list={[baseClasses, variantClasses, extraClass]}
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noopener noreferrer' : undefined}
  >
    {label}
  </a>
)}
