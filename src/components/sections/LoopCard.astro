---
// Foundation, edit with care
//
// The loop order, as a lap punch card.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// THE HOLES CARRY DATA. Punched holes are loops the 27K covers; unpunched rings
// are 50K only. So the graphic encodes the difference between the two distances
// rather than decorating a list, which is the test any of these objects has to
// pass. A legend states the same thing in words, because a reader who does not
// decode the metaphor must still get the information.
//
// Semantics: this is a CSS grid carrying ARIA table roles rather than a real
// <table>, because the punch column is only as wide as a hole and a real table
// cell fights that. The punch column's header is visually hidden for the same
// reason: at 22px wide the label collided with the next heading.
//
// The mileage labels are the race's own "5+" and "3+", not invented per-loop
// distances. The race does not publish exact figures and neither does this.

import Provisional from '@/components/race/Provisional.astro';
import type { ProjectedLoopCardSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  legend?: string;
  loops?: ProjectedLoopCardSection['loops'];
  aside?: ProjectedLoopCardSection['aside'];
  headingId?: string;
};

const {
  eyebrow,
  headline = 'Seven loops out of The Oval',
  legend,
  loops = [],
  aside = [],
  headingId = 'loops-heading',
} = Astro.props as Props;
---

{
  loops.length > 0 && (
    <section class="bg-muted py-section-lg" aria-labelledby={headingId}>
      <div class="mx-auto w-full max-w-content px-6">
        {eyebrow && (
          <p class="blaze text-heading-accent mb-4 font-mono text-[0.72rem] font-semibold tracking-[0.22em] uppercase">
            {eyebrow}
          </p>
        )}
        <h2 id={headingId} class="display text-h2">
          {headline}
        </h2>

        <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-start">
          <div class="punch w-full max-w-[38rem] p-6 sm:p-8">
            <div
              class="punch__rows"
              role="table"
              aria-label="Loop order for the 50K, and which loops the 27K covers"
            >
              <div
                class="grid grid-cols-[22px_3rem_1fr_3.5rem] items-center gap-4 border-b-2 border-dashed border-black/35 pb-2"
                role="row"
              >
                <span class="sr-only" role="columnheader">
                  Included in the 27K
                </span>
                <span
                  class="font-mono text-[0.58rem] tracking-[0.18em] text-[color:var(--plate-ink-soft)] uppercase"
                  role="columnheader"
                >
                  Loop
                </span>
                <span
                  class="font-mono text-[0.58rem] tracking-[0.18em] text-[color:var(--plate-ink-soft)] uppercase"
                  role="columnheader"
                >
                  Type
                </span>
                <span
                  class="text-right font-mono text-[0.58rem] tracking-[0.18em] text-[color:var(--plate-ink-soft)] uppercase"
                  role="columnheader"
                >
                  Miles
                </span>
              </div>

              {loops.map((loop, i) => (
                <div
                  class="grid grid-cols-[22px_3rem_1fr_3.5rem] items-center gap-4 border-b border-black/10 py-2.5 last:border-b-0"
                  role="row"
                >
                  <span
                    class={`punch__hole ${loop.inShortDistance ? 'is-punched' : ''}`}
                    role="cell"
                    aria-label={loop.inShortDistance ? 'Included in the 27K' : '50K only'}
                  />
                  <span
                    class={`tabular text-lg ${loop.kind === 'long' ? 'font-bold' : 'text-[color:var(--plate-ink-soft)]'}`}
                    role="cell"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span
                    class={`text-sm ${loop.kind === 'long' ? 'text-[color:var(--primary)]' : 'text-[color:var(--plate-ink-soft)]'}`}
                    role="cell"
                  >
                    {loop.kind === 'short' ? 'Short' : 'Long'}
                  </span>
                  <span class="tabular text-right text-sm" role="cell">
                    {loop.miles}
                  </span>
                </div>
              ))}
            </div>

            {legend && (
              <p class="mt-6 flex items-start gap-3 border-t border-dashed border-black/30 pt-4 text-sm opacity-75">
                <span class="punch__hole is-punched mt-0.5 shrink-0" aria-hidden="true" />
                <span>{legend}</span>
              </p>
            )}
          </div>

          {aside.length > 0 && (
            <aside class="grid gap-6">
              {aside.map((note) => (
                <div class="border-t border-border pt-5 first:border-t-0 first:pt-0">
                  <h3 class="display text-h4">{note.title}</h3>
                  {note.body && <p class="mt-2 text-muted-foreground">{note.body}</p>}
                  <Provisional
                    confirmed={note.confirmed}
                    what="The race does not publish this anywhere yet."
                    class="mt-3"
                  />
                </div>
              ))}
            </aside>
          )}
        </div>
      </div>
    </section>
  )
}
