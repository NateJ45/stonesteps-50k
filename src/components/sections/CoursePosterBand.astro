---
// Foundation, edit with care
/**
 * The home page's way in to the course map: a still of the real map, with the
 * course drawing itself over it.
 *
 * WHY A PICTURE AND NOT THE MAP. MapLibre is about 250KB before a single tile,
 * and the home page is the one most likely to be opened on a phone on bad
 * signal in a car park. It would also spend the reward: the terrain map is what
 * makes clicking through to /course worth doing. The site's design record
 * already declined WebGL on the home page for both reasons.
 *
 * WHY IT IS STILL HONEST. The picture is THIS SITE'S map, captured from the
 * built page by `npm run map-poster`, and the route over it was projected by
 * that same map at the same instant, so the line cannot drift off the picture.
 * Re-run the command after any change to the map's camera or terrain.
 *
 * IT IS THE TOPOGRAPHIC QUAD, NOT THE SATELLITE IMAGERY, since 2026-09-16.
 * Nathan chose it. Satellite at this size is a continuous green canopy: the
 * relief the course is famous for is under the leaves, so the still showed a
 * route on a lawn. The USGS quad draws the contours, the creeks and the street
 * names, and the terrain exaggeration in the map's camera is still in the
 * picture, so the ridges read as ridges. `POSTER_BASEMAP=satellite npm run
 * map-poster` captures the old version for comparison.
 *
 * THE WHOLE THING IS A LINK. Nothing here is interactive on its own: a still
 * that behaves like a map invites people to drag it and conclude the site is
 * broken, so it says what it is and goes to the page that does.
 */
import poster from '../../../scripts/data/course-poster.json';

interface Props {
  eyebrow?: string;
  headline?: string;
  intro?: string;
  surface?: string;
  headingId?: string;
}

const {
  eyebrow = 'The map',
  headline = 'See where it actually goes',
  intro = 'Seven loops out of The Oval, drawn from a recorded run of the course. The full map is yours to move around, tilt and fly.',
  surface = 'background',
  headingId,
} = Astro.props as Props;

// The band matches the cadence the way every other section does; the torn top
// edge is the site's own band treatment.
const surfaceClass = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';

const W = poster.width;
const H = poster.height;
---

<section class={`cposter relative py-section-lg ${surfaceClass}`} aria-labelledby={headingId}>
  <div class="cposter__inner">
    <div class="cposter__copy">
      {
        /* THE OUTLINED LABEL, NOT A FOURTH EYEBROW (2026-09-17). This band had
          its own: 13px display caps in muted, scoped to the component, which is
          how a fourth heading system gets onto a page without anybody deciding
          to add one. It is a content band, so it takes the same
          `.section-label` the bands above and below it take. */
      }
      {eyebrow && <p class="section-label text-foreground/80">{eyebrow}</p>}
      <h2 class="cposter__headline" id={headingId}>{headline}</h2>
      {intro && <p class="cposter__intro">{intro}</p>}
    </div>

    <a
      class="cposter__link"
      href="/course"
      data-reveal
      data-poster-tilt
      style={`--poster-band-bg: var(${surface === 'muted' ? '--color-muted' : '--color-background'})`}
    >
      <figure class="cposter__figure" style={`--poster-ratio:${W} / ${H}`}>
        <picture>
          <source
            type="image/avif"
            srcset={`/course-poster.avif 1x, /course-poster@1_5x.avif 1.5x`}
          />
          <img
            class="cposter__img"
            src="/course-poster.webp"
            srcset={`/course-poster.webp 1x, /course-poster@1_5x.webp 1.5x`}
            width={W}
            height={H}
            loading="lazy"
            decoding="async"
            alt="A topographic map of Mt. Airy Forest, tilted into its hills, with the Stone Steps 50K course drawn on the ridges it runs, mile markers round each loop, and the Stone Steps themselves marked."
          />
        </picture>

        <figcaption class="cposter__cap">
          <span class="cposter__cta">Explore the course map</span>
          <span class="cposter__note">3D terrain, mile by mile</span>
        </figcaption>

        {
          /* THE SAME CUT THE REAL MAP HAS. Two band-coloured strips masked with
          --ridge-mask, exactly as `.cmap__ridge` does it on /course, so the
          still and the map it is a still OF are bounded by the same contour
          instead of one being a rounded rectangle and the other a torn band.
          Decoration with nothing to announce, so they are aria-hidden and sit
          outside the figure's flow. Above the caption's scrim on purpose: the
          cut has to read as the band closing over the picture, and the caption
          clears it with padding rather than being painted over. */
        }
        <span class="cposter__ridge cposter__ridge--top" aria-hidden="true"></span>
        <span class="cposter__ridge cposter__ridge--bottom" aria-hidden="true"></span>
      </figure>
    </a>
  </div>
</section>

<style>
  .cposter__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .cposter__copy {
    max-width: 44rem;
    margin-bottom: 1.5rem;
  }

  .cposter__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.05;
  }

  .cposter__intro {
    margin: 0.75rem 0 0;
    color: var(--color-muted-foreground);
    max-width: 38rem;
  }

  .cposter__link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 0.5rem;
    /* The vanishing point for the tilt below. On the LINK rather than on the
       figure, because an element cannot supply its own perspective: a
       `perspective()` function inside the figure's own transform is measured
       from the figure's centre and gives a flat, hinge-like rotation instead of
       a plate lifting off the page. */
    perspective: 1100px;
  }

  .cposter__link:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 4px;
  }

  .cposter__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    /* NO RADIUS. The rounded rectangle was the last thing making this read as
       an embedded thumbnail rather than as the map. The edge is the ridge
       below, which is the same argument `.cmap__frame` makes on /course. */
    background: var(--color-muted);
    /* The picture's own proportions, so the box exists before the image lands
       and the page below it never jumps. */
    aspect-ratio: var(--poster-ratio);
    /* Set by the pointer script, read here. Two degrees is the whole range: it
       is meant to be felt rather than watched, and this plate is 1100px wide on
       a desktop, where a few degrees is already tens of pixels of travel at the
       corners. */
    --poster-rx: 0deg;
    --poster-ry: 0deg;
    /* The cut's depth, shared by the two ridges and by the caption's padding,
       so the text can never end up under the contour. */
    --poster-ridge-h: 34px;
    transform: rotateX(var(--poster-rx)) rotateY(var(--poster-ry));
    /* Slower coming back than going out, because the return is the gesture
       ending rather than the gesture. */
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* While the pointer is over it the transform follows the pointer directly,
     so the easing above would lag every move by half a second. */
  .cposter__figure[data-tilting] {
    transition: transform 90ms linear;
  }

  /* The band closing over the picture, top and bottom. Painted in the band's
     own colour (passed down as --poster-band-bg by the section, the same way
     CourseMapBand hands --cmap-band-bg to the real map), so the cut is the page
     rather than a line drawn on the image. */
  .cposter__ridge {
    position: absolute;
    inset-inline: 0;
    height: var(--poster-ridge-h);
    z-index: 2;
    pointer-events: none;
    background-color: var(--poster-band-bg, var(--color-background));
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-image: var(--ridge-mask);
    mask-image: var(--ridge-mask);
  }

  .cposter__ridge--top {
    top: 0;
    /* The mask draws its solid half BELOW the contour, so the top edge uses it
       flipped. Same trick as `.cmap__ridge.is-top`. */
    transform: scaleY(-1);
  }

  .cposter__ridge--bottom {
    bottom: 0;
  }

  /* Shallower on a phone, where the figure is a third of the height and a 34px
     cut would eat the picture. Matches `.cmap__ridge` and `.band-torn`. */
  @media (width < 48rem) {
    .cposter__figure {
      --poster-ridge-h: 22px;
    }
  }

  .cposter__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The photograph carries the whole band, so it gets a slow push in on
       hover. Transform only: it cannot reflow anything. */
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cposter__link:hover .cposter__img {
    transform: scale(1.03);
  }

  .cposter__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    /* The bottom pad clears the ridge, which is painted OVER this scrim: the
       cut belongs to the band, and type sitting in it would be type sitting in
       the page's own colour. */
    padding: 3.5rem 1rem calc(1rem + var(--poster-ridge-h, 34px));
    color: #fff;
    z-index: 1;
    /* Bottom-up scrim rather than a flat panel: the text has to be legible over
       whatever the picture happens to be doing under it.

       DEEPENED FOR THE TOPO, 2026-09-16. A two-stop ramp over the satellite
       capture was fine, because the bottom of that picture was dark canopy and
       the scrim only had to finish a job the photograph had started. The
       topographic quad is pale olive down there, and measured at the caption's
       own height the old ramp had only reached about 0.3 alpha: white type on
       a light map, which is the one combination this scrim exists to prevent.
       Four stops and a taller box put the text band at 0.88 or better, which
       is about 13:1 for the CTA and 9:1 for the note at its 0.85 ink. */
    background: linear-gradient(
      to top,
      rgba(26, 23, 18, 0.94) 0%,
      rgba(26, 23, 18, 0.88) 45%,
      rgba(26, 23, 18, 0.5) 72%,
      rgba(26, 23, 18, 0) 100%
    );
  }

  .cposter__cta {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cposter__cta::after {
    content: ' \2192';
    display: inline-block;
    transition: transform 240ms ease;
  }

  .cposter__link:hover .cposter__cta::after {
    transform: translateX(0.25rem);
  }

  .cposter__note {
    font-size: 0.8125rem;
    opacity: 0.85;
  }

  /* THE SCRIM WAS SIZED FOR THE DESKTOP PLATE AND IT ATE THE PHONE ONE.
     Measured at 390px: the figure is 184px tall and the caption's box was
     141.5px of it, so 77% of a picture whose whole job is to show the terrain
     was gradient, and the route below the first ridge read as a smear. The
     same box on the 621px desktop plate is 22%, which is why this was never
     visible where it was designed. The 3.5rem top pad is the whole difference:
     it is run-up for the ramp, and a plate a third of the height needs a third
     of the run-up.

     THE RAMP IS RE-CUT, NOT JUST SQUEEZED, and that is the half of this worth
     keeping. The desktop stops over a box 40px shorter put the caption's own
     top line at 4.16:1, WORSE than the 6.25 it had before the box shrank,
     because a shorter box moves the type up into the thin end of the same
     ramp. Pulling the stops up with it measures better on every count than the
     version this replaces: the CTA 9.64:1 against 6.25, the note 14.53 against
     12.94, and the picture's clear area 83px against 42px of a 184px figure.
     All four numbers read off the rendered pixels at 390px with the type
     hidden, so they are the background and nothing else.

     BELOW `.cposter__cap` ON PURPOSE: this override and the base rule have the
     same specificity, the base rule sets `padding` as a shorthand, and the
     first version of this lived in the ridge-height media block forty lines
     up, where the shorthand simply won and the built CSS showed the override
     ahead of the rule it was overriding. */
  @media (width < 48rem) {
    .cposter__cap {
      padding-top: 1rem;
      background: linear-gradient(
        to top,
        rgba(26, 23, 18, 0.94) 0%,
        rgba(26, 23, 18, 0.92) 60%,
        rgba(26, 23, 18, 0.78) 86%,
        rgba(26, 23, 18, 0) 100%
      );
    }
  }

  /* A line that draws itself is decoration, and decoration is what this setting
     refuses. The route is simply there.

     THE TILT IS OFF HERE TWICE OVER: the script never binds under this setting,
     and the rule below means a stale inline value from a session that started
     before the setting changed still cannot move the plate. */
  @media (prefers-reduced-motion: reduce) {
    .cposter__img {
      transition: none;
    }

    .cposter__link:hover .cposter__img {
      transform: none;
    }

    .cposter__figure {
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>

<script>
  // THE PLATE FOLLOWS THE POINTER, a couple of degrees, and nothing else.
  //
  // WHY BY HAND AND NOT IN CSS. A tilt that reads as an object needs the
  // pointer's position inside the box, and CSS has no way to ask for it. It is
  // about thirty lines, it touches two custom properties, and it is the whole
  // reason this band has no framework on it.
  //
  // THREE THINGS IT WILL NOT DO.
  //   1. Bind under prefers-reduced-motion. A plate that moves when the reader
  //      did not ask anything to move is exactly what that setting is about.
  //   2. Bind on a coarse pointer. On a touch screen the "pointer" arrives with
  //      the tap that is already following the link, so the tilt would be a
  //      flicker on the way out of the page, and hover state on touch is the
  //      oldest bad idea on the web.
  //   3. Write anything but a transform. Two custom properties feed one
  //      `rotateX/rotateY`, so this cannot reflow the page and cannot move the
  //      countdown, the header or anything else a layout shift would catch.
  //      Home page CLS is 0 and the point is that it stays 0.
  //
  // It re-binds on every client-side navigation for the same reason the
  // countdown does: a module runs once per full load, and the ClientRouter
  // swaps the document without re-running it.
  const MAX_DEG = 2.4;
  const bound: Array<() => void> = [];

  const bind = (link: HTMLElement) => {
    if (link.dataset.tiltBound === '1') return;
    const figure = link.querySelector<HTMLElement>('.cposter__figure');
    if (!figure) return;
    link.dataset.tiltBound = '1';

    // One read per frame. A pointermove can fire far more often than the
    // compositor paints, and the value from the last event in a frame is the
    // only one that was ever going to be seen.
    let frame = 0;
    let pending: { x: number; y: number } | null = null;

    const apply = () => {
      frame = 0;
      if (!pending) return;
      const rect = figure.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      // -1 .. 1 from the centre of the plate.
      const px = (pending.x - rect.left) / rect.width - 0.5;
      const py = (pending.y - rect.top) / rect.height - 0.5;
      // Pointer above centre tips the TOP away, which is the direction a hand
      // pressing there would push it.
      figure.style.setProperty('--poster-rx', `${(-py * 2 * MAX_DEG).toFixed(2)}deg`);
      figure.style.setProperty('--poster-ry', `${(px * 2 * MAX_DEG).toFixed(2)}deg`);
    };

    const onMove = (e: PointerEvent) => {
      pending = { x: e.clientX, y: e.clientY };
      figure.setAttribute('data-tilting', '');
      if (!frame) frame = requestAnimationFrame(apply);
    };

    const onLeave = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      pending = null;
      figure.removeAttribute('data-tilting');
      figure.style.setProperty('--poster-rx', '0deg');
      figure.style.setProperty('--poster-ry', '0deg');
    };

    link.addEventListener('pointermove', onMove);
    link.addEventListener('pointerleave', onLeave);
    // A keyboard visit gets the plate square, not wherever the mouse was left.
    link.addEventListener('focus', onLeave);

    bound.push(() => {
      if (frame) cancelAnimationFrame(frame);
      link.removeEventListener('pointermove', onMove);
      link.removeEventListener('pointerleave', onLeave);
      link.removeEventListener('focus', onLeave);
    });
  };

  const setup = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-poster-tilt]').forEach(bind);
  };

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    for (const stop of bound.splice(0)) stop();
  });
</script>
