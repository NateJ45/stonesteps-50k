---
// Foundation, edit with care
//
// The hero. Topographic backdrop, display wordmark, and the race clock.
//
// SELF_CONTAINED: never receives a surface prop. It no longer paints its own
// ground either, because the body's ground is the same colour AND carries the
// grain; see the note on the section element.
//
// The headline is split per character into spans so `.hand` can give each
// letter a fraction of a degree of rotation.
//
// A trailing distance token (50k, 27k) gets its k OUTLINED. The logo says 50k,
// not 50K, and Staatliches is caps-only so live type cannot render the
// lowercase form at all. Outlining the letter keeps it distinct without needing
// a glyph the face does not have. It is decoration only: the real string is in
// the sr-only copy above. That reads as hand-cut lettering
// without a distressed typeface, so legibility and font weight are unaffected.
// The real, unsplit text is exposed to screen readers separately, because a
// heading chopped into 30 spans is announced letter by letter by some readers.

import SanityImage from '@/components/SanityImage.astro';
import MudField from '@/components/race/MudField.astro';
import CtaLink from '@/components/CtaLink.astro';
import Topo from '@/components/race/Topo.astro';
import Countdown from '@/components/race/Countdown.astro';
import type { ProjectedRaceHeroSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  claim?: string;
  images?: ProjectedRaceHeroSection['images'];
  image?: ProjectedRaceHeroSection['image'];
  showCountdown?: boolean;
  primaryCta?: ProjectedRaceHeroSection['primaryCta'];
  secondaryCta?: ProjectedRaceHeroSection['secondaryCta'];
  race?: ProjectedRaceHeroSection['race'];
  headingId?: string;
};

const {
  eyebrow,
  headline = '',
  subhead,
  claim,
  images,
  image,
  showCountdown = true,
  primaryCta,
  secondaryCta,
  race,
  headingId = 'race-hero-heading',
} = Astro.props as Props;

// THE SLIDES. `images` is the field editors see; `image` is the single-photo
// field it replaced, read here so a document written before the slideshow
// existed still shows its photograph instead of nothing.
//
// One slide is a still hero. The cross-fade, the drift and the whole animation
// block below are skipped entirely at a length of one, so the common case pays
// nothing for the feature.
const slides = (images?.length ? images : image ? [image] : []).filter((i) => i?.asset);

/* The cycle has to be shared between the markup and the CSS: each slide is
   held, then cross-faded, and the nth slide starts (n/total) of the way
   through a loop that never restarts. Expressed once here and handed to CSS as
   custom properties, so adding a fifth slide in the Studio cannot desynchronise
   the timing from the number of pictures. */
const SLIDE_SECONDS = 7;
const cycleSeconds = SLIDE_SECONDS * slides.length;

/** 1 -> "1st", 23 -> "23rd". Two rules: the teens are all "th", then the last
 *  digit decides. */
const ordinal = (n: number) => {
  const teen = n % 100 >= 11 && n % 100 <= 13;
  const last = n % 10;
  return `${n}${teen ? 'th' : last === 1 ? 'st' : last === 2 ? 'nd' : last === 3 ? 'rd' : 'th'}`;
};

// Split into words, then characters, so a word never breaks mid-rotation
// across a line end.
const words = headline.split(/\s+/).filter(Boolean);

/** True for a final token like "50k" or "27k", whose k gets outlined. */
const isDistanceToken = (w: string, i: number) => i === words.length - 1 && /^\d+k$/i.test(w);
---

{
  /* NO `bg-background` HERE, deliberately. The body already paints exactly this
  colour, and it also carries the paper grain and the mottle layer. A background
  on this section covers those, which was invisible while the header was solid
  and became a clear tonal step across the page the moment the header went
  transparent: grain above the line, none below. Letting the body's surface show
  through makes the top of the page one continuous ground, which is the whole
  point of the overlay. */
}
<section class="hero-band relative py-section-lg" aria-labelledby={headingId}>
  {
    /* The topo still needs clipping to the band; the mud deliberately does not,
    so the clip lives on this wrapper rather than on the <section>. */
  }
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <Topo seed={11} lines={16} opacity={0.42} />
  </div>

  {
    /* The mud. Baked masks rather than live SVG, and home hero only: see the
      header of MudField.astro for why, and for the two shapes it carries. */
  }
  <MudField field="hero" class="hero-mud" />

  {
    /* The photographs. OUTSIDE the z-10 content wrapper on purpose: on desktop
      this is an absolute layer at z-0 so the mud (z-1) crosses it and the copy
      (z-10) stays clear of it. See `.hero-photo` in globals.css.

      ONLY THE FIRST SLIDE IS DESCRIBED. The rest are more pictures of the same
      thing, and a screen reader announcing four descriptions of a decorative
      backdrop is worse than one. They are marked alt="" so they are skipped,
      which is the correct markup for an image that adds nothing a caption has
      not already said.

      Priority is explicit for the same reason, and ONLY THE FIRST SLIDE IS
      EAGER. All of them used to be, which put three full-size photographs on
      the wire at once: measured under Lighthouse's throttling they finished at
      6.6s, 6.9s and 7.4s and held up the first paint behind them. The rest are
      lazy now. They are in the viewport, so they still start immediately after
      load, and the cross-fade does not reach the second slide for seven
      seconds. */
    slides.length > 0 && (
      <figure
        class:list={[
          'photo-plate',
          'hero-photo',
          slides.length > 1 && `hero-photo--cycling hero-photo--n${slides.length}`,
        ]}
        style={`--slide-cycle:${cycleSeconds}s`}
      >
        {slides.map((img, i) => (
          <SanityImage
            source={img}
            width={1400}
            sizes="(min-width: 1024px) 48vw, 100vw"
            /* 62, against the component's default of 75. This photograph sits
               behind a gradient scrim and the page's grain, which is exactly
               the case where the last fifth of JPEG quality is invisible and
               expensive: it is the LCP element and it was 218kB. */
            quality={62}
            alt={i === 0 ? (img.alt ?? '') : ''}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        ))}
      </figure>
    )
  }

  <div class="relative z-10 mx-auto w-full max-w-content px-6">
    <div class="lg:max-w-[52%]">
      <div class="relative">
        {
          eyebrow && (
            <p class="blaze blaze--plain text-heading-accent mb-5 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
              {eyebrow}
            </p>
          )
        }

        <h1 id={headingId} class="display display-echo text-[clamp(6rem,15vw,10.5rem)]">
          <span class="sr-only">{headline}</span>
          <span class="hand" aria-hidden="true">
            {
              words.map((word, wi) => (
                <>
                  <span class="stamp-word inline-block whitespace-nowrap" style={`--wi:${wi}`}>
                    {word.split('').map((ch, ci) => (
                      <span
                        class={
                          isDistanceToken(word, wi) && ci === word.length - 1
                            ? 'k-outline lc'
                            : undefined
                        }
                      >
                        {ch}
                      </span>
                    ))}
                  </span>
                  {wi < words.length - 1 && ' '}
                </>
              ))
            }
          </span>
        </h1>

        {
          /* THE CLAIM IS A MARK, NOT A SENTENCE. It used to open the subhead,
            where the one genuinely boastable fact about this race ("Cincinnati's
            longest running ultra marathon") was the first half of a paragraph
            nobody reads twice. Struck over the hero as a rubber stamp it is
            read in the same glance as the wordmark, which is what a claim is
            for. The edition line under it reads off The Race's own
            editionNumber, so the year can never disagree with the rest of the
            site.

            Real text, not an image: it is a claim a search engine and a screen
            reader should both get, and at this size type is sharper than any
            raster would be.

            In flow on a phone (under the wordmark, still rotated), absolutely
            placed at the top right of the copy column from lg, where the
            second line of the wordmark leaves the corner empty. */
          claim && (
            <p class="claim-stamp">
              <span class="claim-stamp__line">{claim}</span>
              {typeof race?.editionNumber === 'number' && (
                <span class="claim-stamp__edition">{ordinal(race.editionNumber)} year</span>
              )}
            </p>
          )
        }

        {
          /* FULL-STRENGTH INK, not muted. This is the one paragraph on the site
            that sits on the mud, and axe measured it at 4.11:1 against AA's 4.5
            once the field ran the width of the band. It is also the line that
            tells a visitor what the race IS, so softening it was the wrong
            economy twice over. Same call as the countdown's label. */
          subhead && <p class="mt-6 max-w-[46ch] text-lg text-foreground">{subhead}</p>
        }

        <div class="mt-8 flex flex-wrap items-center gap-4">
          {primaryCta && <CtaLink cta={primaryCta} class="btn-plate" />}
          {secondaryCta && <CtaLink cta={secondaryCta} class="btn-plate btn-plate--cream" />}
        </div>
      </div>

      {
        /* The countdown moved out of the old right-hand column and under the
          buttons when the photograph took that column. It reads better here
          anyway: date, then the two things you can do about it, then how long
          you have. */
        showCountdown && race?.raceDate && (
          <div class="border-heading-accent mt-10 max-w-[30rem] border-t-2 pt-5">
            <Countdown target={race.raceDate} />
          </div>
        )
      }
    </div>
  </div>
</section>
