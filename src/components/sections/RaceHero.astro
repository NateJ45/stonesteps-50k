---
// Foundation, edit with care
//
// The hero. Topographic backdrop, display wordmark, and the race clock.
//
// SELF_CONTAINED: never receives a surface prop. It no longer paints its own
// ground either, because the body's ground is the same colour AND carries the
// grain; see the note on the section element.
//
// The headline is split per character into spans so `.hand` can give each
// letter a fraction of a degree of rotation.
//
// A trailing distance token (50k, 27k) gets its k OUTLINED. The logo says 50k,
// not 50K, and Staatliches is caps-only so live type cannot render the
// lowercase form at all. Outlining the letter keeps it distinct without needing
// a glyph the face does not have. It is decoration only: the real string is in
// the sr-only copy above. That reads as hand-cut lettering
// without a distressed typeface, so legibility and font weight are unaffected.
// The real, unsplit text is exposed to screen readers separately, because a
// heading chopped into 30 spans is announced letter by letter by some readers.

import SanityImage from '@/components/SanityImage.astro';
import MudField from '@/components/race/MudField.astro';
import CtaLink from '@/components/CtaLink.astro';
import Topo from '@/components/race/Topo.astro';
import Countdown from '@/components/race/Countdown.astro';
import type { ProjectedRaceHeroSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  image?: ProjectedRaceHeroSection['image'];
  showCountdown?: boolean;
  primaryCta?: ProjectedRaceHeroSection['primaryCta'];
  secondaryCta?: ProjectedRaceHeroSection['secondaryCta'];
  race?: ProjectedRaceHeroSection['race'];
  headingId?: string;
};

const {
  eyebrow,
  headline = '',
  subhead,
  image,
  showCountdown = true,
  primaryCta,
  secondaryCta,
  race,
  headingId = 'race-hero-heading',
} = Astro.props as Props;

// Split into words, then characters, so a word never breaks mid-rotation
// across a line end.
const words = headline.split(/\s+/).filter(Boolean);

/** True for a final token like "50k" or "27k", whose k gets outlined. */
const isDistanceToken = (w: string, i: number) => i === words.length - 1 && /^\d+k$/i.test(w);
---

{
  /* NO `bg-background` HERE, deliberately. The body already paints exactly this
  colour, and it also carries the paper grain and the mottle layer. A background
  on this section covers those, which was invisible while the header was solid
  and became a clear tonal step across the page the moment the header went
  transparent: grain above the line, none below. Letting the body's surface show
  through makes the top of the page one continuous ground, which is the whole
  point of the overlay. */
}
<section class="hero-band relative py-section-lg" aria-labelledby={headingId}>
  {
    /* The topo still needs clipping to the band; the mud deliberately does not,
    so the clip lives on this wrapper rather than on the <section>. */
  }
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <Topo seed={11} lines={16} class="opacity-70" />
  </div>

  {
    /* The mud. Baked masks rather than live SVG, and home hero only: see the
      header of MudField.astro for why, and for the two shapes it carries. */
  }
  <MudField field="hero" class="hero-mud" />

  {
    /* The photograph. OUTSIDE the z-10 content wrapper on purpose: on desktop it
      is an absolute layer at z-0 so the mud (z-1) crosses it and the copy
      (z-10) stays clear of it. See `.hero-photo` in globals.css. */
    image?.asset && (
      <figure class="photo-plate hero-photo">
        <SanityImage
          source={image}
          width={1400}
          sizes="(min-width: 1024px) 48vw, 100vw"
          alt={image.alt ?? ''}
          loading="eager"
        />
      </figure>
    )
  }

  <div class="relative z-10 mx-auto w-full max-w-content px-6">
    <div class="lg:max-w-[52%]">
      <div>
        {
          eyebrow && (
            <p class="blaze blaze--plain text-heading-accent mb-5 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
              {eyebrow}
            </p>
          )
        }

        <h1 id={headingId} class="display text-[clamp(3rem,10vw,7rem)]">
          <span class="sr-only">{headline}</span>
          <span class="hand" aria-hidden="true">
            {
              words.map((word, wi) => (
                <>
                  <span class="inline-block whitespace-nowrap">
                    {word.split('').map((ch, ci) => (
                      <span
                        class={
                          isDistanceToken(word, wi) && ci === word.length - 1
                            ? 'k-outline lc'
                            : undefined
                        }
                      >
                        {ch}
                      </span>
                    ))}
                  </span>
                  {wi < words.length - 1 && ' '}
                </>
              ))
            }
          </span>
        </h1>

        {
          /* FULL-STRENGTH INK, not muted. This is the one paragraph on the site
            that sits on the mud, and axe measured it at 4.11:1 against AA's 4.5
            once the field ran the width of the band. It is also the line that
            tells a visitor what the race IS, so softening it was the wrong
            economy twice over. Same call as the countdown's label. */
          subhead && <p class="mt-6 max-w-[46ch] text-lg text-foreground">{subhead}</p>
        }

        <div class="mt-8 flex flex-wrap items-center gap-4">
          {primaryCta && <CtaLink cta={primaryCta} class="btn-plate" />}
          {secondaryCta && <CtaLink cta={secondaryCta} class="btn-plate btn-plate--cream" />}
        </div>
      </div>

      {
        /* The countdown moved out of the old right-hand column and under the
          buttons when the photograph took that column. It reads better here
          anyway: date, then the two things you can do about it, then how long
          you have. */
        showCountdown && race?.raceDate && (
          <div class="border-heading-accent mt-10 max-w-[30rem] border-t-2 pt-5">
            <Countdown target={race.raceDate} />
          </div>
        )
      }
    </div>
  </div>
</section>
