---
// Page-builder block: image and text side by side. Image side is
// editor-controlled; surface comes from SectionRenderer. Safe to edit by hand.
import SanityImage from '@/components/SanityImage.astro';
import MudField from '@/components/race/MudField.astro';
import Topo from '@/components/race/Topo.astro';
import PortableText from '@/components/PortableText';
import CtaLink from '@/components/CtaLink.astro';

interface Props {
  image?: any;
  imageSide?: 'left' | 'right';
  eyebrow?: string;
  heading?: string;
  cutout?: boolean;
  body?: any;
  cta?: any;
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  image,
  imageSide = 'left',
  eyebrow,
  heading,
  cutout = false,
  body,
  cta,
  surface = 'background',
  headingId,
} = Astro.props as Props;

// `band-torn` here too, so this band is cut into the page like every other
// one. It was the only surface-painting section that bypassed the shared
// class, which is why the boundary above the race director was the one flat
// horizontal line left on the home page.
const bg = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';
const imageFirst = imageSide === 'left';
const bodyClass = `text-foreground/85 text-lg leading-relaxed ${heading || eyebrow ? 'mt-m' : ''}`;
---

<!-- NO CLIP ON THIS SECTION, and it took two tries to get there. The ground
  pool behind a cut-out subject used to need trimming, so the section clipped;
  but the band's ridge is a ::before sitting ABOVE the box, and clipping ate it,
  leaving the one flat boundary on the page. `overflow-x: clip` did not save it
  either, whatever the spec says about the other axis staying visible.
  The pool is now drawn small enough to stay inside the section on its own, so
  there is nothing to clip and the ridge survives. -->
<section class:list={[bg, cutout && 'relative']} aria-labelledby={heading ? headingId : undefined}>
  {
    /* A CUT-OUT SUBJECT NEEDS GROUND TO STAND ON. Without it the person floats
      on a flat band, which is the other half of the problem the frame was
      solving badly. The mud is bigger and sparser here than on the hero: it
      sits behind a person rather than behind a headline, so it should read as
      ground rather than as a second texture competing with him. */
  }
  {
    /* CLIPPED BY A WRAPPER, NOT BY THE SECTION. The mud's arrival scales each
      throw slightly past its resting size, so unclipped it widens the document
      and puts a scrollbar on the page. The section itself must stay unclipped
      because its ridge is a ::before living above the box, so the clip goes one
      level down. Same shape as ElevationBand and ParksBand.

      Unlike the hero's field, this one has no reason to escape its band: it is
      ground under a person, not a throw across the top of the page. */
    cutout && (
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <MudField field="director" />
      </div>
    )
  }
  <div
    class="mx-auto grid max-w-content grid-cols-1 items-center gap-l px-m py-section-lg md:grid-cols-2 md:gap-section-md"
    data-reveal
  >
    <div class:list={[imageFirst ? 'md:order-1' : 'md:order-2']}>
      {
        image?.asset ? (
          cutout ? (
            // A CUT-OUT GETS NO FRAME, but it does get GROUND. A rounded box
            // and a colour wash would draw the rectangle back and undo the only
            // reason to cut him out; a soft pool behind him and a scatter of
            // marks in front of him put him in the scene instead. See
            // `.subject-stage` in globals.css.
            //
            // THE HEIGHT IS CAPPED. Left to its own aspect this photograph came
            // out 948px tall and dragged the whole band to 1172px, which is
            // half again what the four paragraphs beside it need. The cap is on
            // the image rather than the section so the band goes back to being
            // sized by its content.
            <div class="subject-stage">
              <span class="subject-stage__pool" aria-hidden="true">
                <Topo seed={5} lines={9} />
              </span>
              <SanityImage
                source={image}
                width={800}
                sizes="(min-width: 768px) 45vw, 100vw"
                quality={80}
                class="photo-cutout h-auto max-h-[30rem] w-auto"
              />
              <MudField field="director-fore" class="subject-stage__mud" />
            </div>
          ) : (
            // `photo-plate` on the clipping wrapper, so this photograph takes
            // the same grade as every other one on the site.
            <div class="photo-plate overflow-hidden rounded-md">
              <SanityImage
                source={image}
                width={800}
                sizes="(min-width: 768px) 45vw, 100vw"
                quality={75}
                class="h-auto w-full"
              />
            </div>
          )
        ) : (
          <div class="aspect-[4/5] rounded-md bg-muted" aria-hidden="true" />
        )
      }
    </div>

    <div class:list={[imageFirst ? 'md:order-2' : 'md:order-1']}>
      {
        eyebrow && (
          <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">{eyebrow}</p>
        )
      }
      {
        heading && (
          <h2 id={headingId} class="font-display text-h2 text-foreground">
            {heading}
          </h2>
        )
      }
      {body && <PortableText value={body} className={bodyClass} />}
      {
        cta?.label && (
          <div class="mt-l">
            <CtaLink cta={cta} variant="secondary" />
          </div>
        )
      }
    </div>
  </div>
</section>
