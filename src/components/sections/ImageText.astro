---
// Page-builder block: image and text side by side. Image side is
// editor-controlled; surface comes from SectionRenderer. Safe to edit by hand.
import SanityImage from '@/components/SanityImage.astro';
import MudField from '@/components/race/MudField.astro';
import Topo from '@/components/race/Topo.astro';
import PortableText from '@/components/PortableText';
import CtaLink from '@/components/CtaLink.astro';
import RegionPoster from '@/components/race/RegionPoster.astro';
import { localPosterFor } from '@/lib/local-poster';

interface Props {
  image?: any;
  imageSide?: 'left' | 'right';
  eyebrow?: string;
  heading?: string;
  cutout?: boolean;
  body?: any;
  cta?: any;
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  image,
  imageSide = 'left',
  eyebrow,
  heading,
  cutout = false,
  body,
  cta,
  surface = 'background',
  headingId,
} = Astro.props as Props;

// `band-torn` here too, so this band is cut into the page like every other
// one. It was the only surface-painting section that bypassed the shared
// class, which is why the boundary above the race director was the one flat
// horizontal line left on the home page.
const bg = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';
const imageFirst = imageSide === 'left';

// THIS SITE DRAWS ITS OWN MAPS (2026-09-17). A block whose call to action sends
// the reader to Google Maps is a block about where things are, and the picture
// beside it should be our map rather than a screenshot of the one it links to.
// The rule, the three options it was chosen from and the day it can be deleted
// are all written out in src/lib/local-poster.ts; it is tested there too,
// against the live href. Nothing about the CTA changes: a hotel search still
// belongs on Google.
// `externalUrl` is where a ctaBlock keeps an outside link; `href` is what
// CtaLink RESOLVES it to, and this runs before that. Reading the wrong one is
// silent: the rule simply never fires and the block keeps its CMS image, which
// is exactly what the first cut of this did.
const localPoster = localPosterFor(cta?.externalUrl);
const bodyClass = `text-foreground/85 text-lg leading-relaxed ${heading || eyebrow ? 'mt-m' : ''}`;
---

<!-- NO CLIP ON THIS SECTION, and it took two tries to get there. The ground
  pool behind a cut-out subject used to need trimming, so the section clipped;
  but the band's ridge is a ::before sitting ABOVE the box, and clipping ate it,
  leaving the one flat boundary on the page. `overflow-x: clip` did not save it
  either, whatever the spec says about the other axis staying visible.
  The pool is now drawn small enough to stay inside the section on its own, so
  there is nothing to clip and the ridge survives. -->
<section class:list={[bg, cutout && 'relative']} aria-labelledby={heading ? headingId : undefined}>
  {
    /* A CUT-OUT SUBJECT NEEDS GROUND TO STAND ON. Without it the person floats
      on a flat band, which is the other half of the problem the frame was
      solving badly. The mud is bigger and sparser here than on the hero: it
      sits behind a person rather than behind a headline, so it should read as
      ground rather than as a second texture competing with him. */
  }
  {
    /* CLIPPED BY A WRAPPER, NOT BY THE SECTION. The mud's arrival scales each
      throw slightly past its resting size, so unclipped it widens the document
      and puts a scrollbar on the page. The section itself must stay unclipped
      because its ridge is a ::before living above the box, so the clip goes one
      level down. Same shape as ElevationBand and ParksBand.

      Unlike the hero's field, this one has no reason to escape its band: it is
      ground under a person, not a throw across the top of the page. */
    cutout && (
      <div class="mud-edge-fade pointer-events-none absolute inset-0 overflow-hidden">
        <MudField field="director" />
      </div>
    )
  }
  {
    /* THE SHARED SPLIT (2026-09-18). This band used to cut the content column
      into two equal halves with a 76.8px gutter and to do it at `md`, which is
      neither of the two things the rest of the site does. It now takes `.split`
      from globals.css: the picture always gets the narrow track and the words
      the wide one, so the seam here lands where it lands on the page header and
      the course features instead of 42px to the left of them.

      THE PICTURE STAYS FIRST IN THE DOM whichever side it is shown on, and the
      side is chosen with `lg:order-*`, so the stacked reading order on a phone
      (picture, then words) is exactly what it was. */
  }
  <div
    class:list={[
      'split mx-auto max-w-content items-center px-6 py-section-lg',
      imageFirst && 'split--media-first',
    ]}
    data-reveal
  >
    <div class:list={[imageFirst ? 'lg:order-1' : 'lg:order-2']}>
      {
        localPoster === 'region' ? (
          <RegionPoster bandBg={surface} />
        ) : image?.asset ? (
          cutout ? (
            // A CUT-OUT GETS NO FRAME, but it does get GROUND. A rounded box
            // and a colour wash would draw the rectangle back and undo the only
            // reason to cut him out; a soft pool behind him and a scatter of
            // marks in front of him put him in the scene instead. See
            // `.subject-stage` in globals.css.
            //
            // THE SIZE IS CAPPED BY WIDTH, NOT HEIGHT, and that is not a style
            // preference. Left to its own aspect this photograph came out 948px
            // tall and dragged the band to 1172px, half again what the four
            // paragraphs beside it need. Capping it with max-height and
            // width:auto did fix that and cost something quieter: an unloaded
            // lazy image with width:auto has no width to compute a height FROM,
            // so the band reserved nothing and jumped when the picture arrived.
            // Capping the width instead lets the intrinsic aspect ratio hold
            // the space open. Same rendered size, no shift.
            // THE TWO CUSTOM PROPERTIES (2026-09-18) put him on the left edge
            // of his column, where every other object on the page starts, and
            // take the pool of ground with him rather than leaving it centred
            // on a column he no longer fills. `--stage-img-w` repeats the cap
            // on the picture below and `--stage-spread` is how much wider the
            // disc is than the picture: 577 over 304, about 1.9, which is the
            // disc this band already drew. Full argument on `.subject-stage`.
            <div class="subject-stage" style="--stage-img-w: 19rem; --stage-spread: 1.9">
              <span class="subject-stage__pool" aria-hidden="true">
                <Topo seed={5} lines={9} />
              </span>
              <SanityImage
                source={image}
                width={800}
                sizes="(min-width: 768px) 45vw, 100vw"
                quality={80}
                class="photo-cutout h-auto w-full max-w-[19rem]"
              />
              <MudField field="director-fore" class="subject-stage__mud" />
            </div>
          ) : (
            // `photo-plate` on the clipping wrapper, so this photograph takes
            // the same grade as every other one on the site.
            <div class="photo-plate overflow-hidden rounded-md">
              <SanityImage
                source={image}
                width={800}
                sizes="(min-width: 768px) 45vw, 100vw"
                quality={75}
                class="h-auto w-full"
              />
            </div>
          )
        ) : (
          <div class="aspect-[4/5] rounded-md bg-muted" aria-hidden="true" />
        )
      }
    </div>

    <div class:list={['label-column', imageFirst ? 'lg:order-2' : 'lg:order-1']}>
      {
        /* THE OUTLINED LABEL, NOT SMALL CAPS (2026-09-17). This band drew the
          generic starter's eyebrow: 12px tracked caps, its own copy of the
          markup, sitting two sections away from bands that announced
          themselves with an outlined display word. Three eyebrow systems on
          one page is not a hierarchy, it is an accident of where the code came
          from. This is a CONTENT block, so it takes the label the other
          content bands take, from the same `.section-label` rule. */
        /* `--fit` sizes the outlined word off THIS COLUMN rather than off the
          window (2026-09-17). At 1280 the contact page's "Coming from out of
          town" broke over two lines in a 570px column, and an outlined word on
          two lines reads as a fault rather than as a heading. The container
          query and why it is scoped to this band are on `.section-label--fit`
          in globals.css. */
        eyebrow && <p class="section-label section-label--fit text-foreground/80">{eyebrow}</p>
      }
      {
        heading && (
          <h2 id={headingId} class="font-display text-h2 text-foreground">
            {heading}
          </h2>
        )
      }
      {body && <PortableText value={body} className={bodyClass} />}
      {
        cta?.label && (
          <div class="mt-l">
            <CtaLink cta={cta} variant="secondary" />
          </div>
        )
      }
    </div>
  </div>
</section>
