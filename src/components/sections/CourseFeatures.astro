---
// Foundation, edit with care
//
// What the course is actually like. Deliberately plain: this is prose, and
// numbering it is as much treatment as it needs.
//
// CONTENT block: receives a surface from the cadence in sectionCadence.ts.
//
// THE PHOTOGRAPH STICKS. When one is set, it holds in view while the features
// scroll past it, so the reader is looking at the trail while reading about the
// trail rather than scrolling away from it. It is `position: sticky` inside its
// own column, which needs no JavaScript and degrades to a normal image on a
// phone, where the layout is one column and sticking would mean covering the
// text with a photo.
//
// TWO MATERIAL CORRECTIONS (2026-09-17), and the list itself is untouched.
//
// THE PHOTOGRAPH TAKES THE GROUND LIFT, not the plate lift. It was
// `--lift-lg`, the black offset, which is right for an object sitting on a
// PLATE and wrong for one sitting on the page: on the bark page a black offset
// renders about nineteen values off the ground and the picture lost its shadow
// entirely, while the plate button six inches below it kept one. The
// --lift-ground block in globals.css is the long argument; this is one of the
// usages it says has to choose. The parks band keeps the black offset on
// purpose, because its ground is forest in both themes.
//
// THE NUMERALS ARE A MARKER, NOT A FOOTNOTE. Same face, same ink, three steps
// larger. At 14px they ranked below the body copy under them, so a numbered
// list read as an unnumbered one with something small above each title; the
// number is the only thing saying these four are in an order.

import SectionHeading from '@/components/SectionHeading.astro';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import Provisional from '@/components/race/Provisional.astro';
import type { ProjectedCourseFeaturesSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  cta?: ProjectedCourseFeaturesSection['cta'];
  image?: ProjectedCourseFeaturesSection['image'];
  caption?: string;
  features?: ProjectedCourseFeaturesSection['features'];
  surface?: string;
  headingId?: string;
};

const {
  eyebrow,
  headline = 'The course',
  cta,
  image,
  caption,
  features = [],
  surface = 'background',
  headingId = 'course-features-heading',
} = Astro.props as Props;

const surfaceClass = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';
const hasImage = Boolean(image?.asset);
---

{
  features.length > 0 && (
    <section class={`py-section-lg ${surfaceClass}`} aria-labelledby={headingId}>
      <div class="mob-center mx-auto w-full max-w-content px-6">
        <SectionHeading {eyebrow} {headline} {headingId} />

        <div
          class={
            // THE SHARED SPLIT (2026-09-18). The 0.9fr/1.1fr this band declared
            // inline is the ratio the whole site now uses, mirrored because the
            // picture leads here; it says so through `.split--media-first` in
            // globals.css instead of keeping a private copy of the numbers.
            // Nothing moves: the same two tracks, the same 2.5rem gutter.
            hasImage ? 'split split--media-first mt-10' : 'mt-10'
          }
        >
          {hasImage && (
            <figure class="lg:sticky lg:top-28 lg:self-start">
              <div class="photo-plate overflow-hidden rounded-xl border-2 border-black shadow-[var(--lift-ground-lg)]">
                <SanityImage
                  source={image}
                  width={1000}
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  alt={image?.alt ?? ''}
                  class="course-photo w-full"
                />
              </div>
              {caption && (
                <figcaption class="mx-auto mt-3 max-w-[48ch] text-sm leading-relaxed text-muted-foreground lg:mx-0">
                  {caption}
                </figcaption>
              )}
            </figure>
          )}

          <div class={hasImage ? 'mob-left' : 'mob-left grid gap-px sm:grid-cols-2'}>
            {features.map((f, i) => (
              <article class="border-t border-border py-6 first:border-t-0 first:pt-0 sm:pr-8">
                <p class="tabular text-heading-accent text-[1.0625rem] tracking-[0.06em]">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3 class="display mt-2 text-h4">{f.title}</h3>
                {f.body && <p class="mt-3 max-w-[46ch] text-muted-foreground">{f.body}</p>}
                <Provisional
                  confirmed={f.confirmed}
                  what="Not yet verified against the course."
                  class="mt-3"
                />
              </article>
            ))}

            {cta && (
              <div class="mt-8">
                <CtaLink {cta} class="btn-plate btn-plate--cream" />
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* The grade itself now lives on `.photo-plate` in globals.css, so every
     photograph on the site gets the same treatment. This only sizes the frame. */
  .course-photo {
    height: clamp(22rem, 46vw, 34rem);
    object-fit: cover;
  }
</style>
