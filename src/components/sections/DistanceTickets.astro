---
// Foundation, edit with care
//
// The two entries, as race tickets.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// WHY A TICKET. The element stopped being a styled div and became an object
// from the race's own world, and the mapping carries information the plain
// version could not: the perforation separates what the entry IS from what you
// KEEP, so the includes list and the register button sit on the tear-off stub.
// The notches are real holes: a mask on the ticket, positioned by the script at
// the bottom of this file, which measures where each perforation falls. See
// the .ticket rules in globals.css for why a painted disc could never pass.
//
// Per-distance register links matter here. Each distance carries its own
// RunSignUp event id, so the button lands the entrant on the right event
// instead of the generic race page.

import Provisional from '@/components/race/Provisional.astro';
import { externalLinkAttrs } from '@/lib/links';
import type { ProjectedDistanceTicketsSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  note?: string;
  distances?: ProjectedDistanceTicketsSection['distances'];
  race?: ProjectedDistanceTicketsSection['race'];
  headingId?: string;
};

const {
  eyebrow,
  headline = 'Two distances',
  note,
  distances = [],
  race,
  headingId = 'distances-heading',
} = Astro.props as Props;

/** Deep-link to this distance's own event where we know its id. */
function registerHref(eventId?: number): string | undefined {
  if (!race?.registerUrl) return undefined;
  return eventId ? `${race.registerUrl}?eventId=${eventId}` : race.registerUrl;
}
---

<section class="band-torn bg-muted py-section-lg" id="distances" aria-labelledby={headingId}>
  <div class="mob-center mx-auto w-full max-w-content px-6">
    {
      eyebrow && (
        <p class="blaze text-heading-accent mb-4 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
          {eyebrow}
        </p>
      )
    }
    <h2 id={headingId} class="display text-h2">{headline}</h2>

    <div class="ticket-board mob-left mt-12">
      <div class="ticket-board__row grid gap-10 md:gap-0">
        {
          distances.map((d) => (
            <article
              class={`ticket w-full max-w-[26rem] justify-self-center ${d.featured ? 'ticket--feature' : ''}`}
            >
              {d.featured && d.kicker && (
                <div class="ticket__flag" aria-hidden="true">
                  <span>{d.kicker}</span>
                </div>
              )}

              <div class="p-7">
                {/* The kicker is repeated as real text because the corner flag is
                  aria-hidden: a screen reader would otherwise announce it twice. */}
                <p class="ticket-soft font-mono text-[0.6875rem] tracking-[0.2em] uppercase">
                  {d.kicker}
                </p>
                <h3 class="display on-light mt-1 text-[clamp(3rem,7vw,4.5rem)]">
                  <span class="lc">{d.name}</span>
                </h3>

                {/* The two facts a US trail runner actually reads a distance by.
                  "50K" is a name, not a length, and until these were real fields
                  on the document they existed only inside the loopStructure
                  sentence where nothing could reach them. */}
                {(d.totalMiles || d.loopCount) && (
                  <p class="ticket-stat mt-2 font-mono text-[0.8125rem] tracking-[0.14em] uppercase">
                    {d.totalMiles && <span class="tabular">{d.totalMiles} miles</span>}
                    {d.totalMiles && d.loopCount && <span aria-hidden="true"> &middot; </span>}
                    {d.loopCount && <span class="tabular">{d.loopCount} loops</span>}
                  </p>
                )}

                {d.loopStructure && <p class="mt-3 text-sm">{d.loopStructure}</p>}
                {d.blurb && <p class="mt-4 text-sm leading-relaxed">{d.blurb}</p>}

                <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
                  {d.startTime && (
                    <div>
                      <dt class="ticket-soft font-mono text-[0.6875rem] tracking-[0.18em] uppercase">
                        Start
                      </dt>
                      <dd class="tabular">{d.startTime}</dd>
                    </div>
                  )}
                  {d.entryCap && (
                    <div>
                      <dt class="ticket-soft font-mono text-[0.6875rem] tracking-[0.18em] uppercase">
                        Entry cap
                      </dt>
                      <dd class="tabular">{d.entryCap}</dd>
                    </div>
                  )}
                </dl>
                {d.trekkerNote && <p class="ticket-soft mt-3 text-xs">{d.trekkerNote}</p>}

                {/* THE PRICE LADDER, PER DISTANCE. The two races are priced apart at
                  every stage, so a single race-level strip under the board (which
                  is where this used to be) could only ever be right for one of
                  them. Each ticket carries its own. */}
                {Array.isArray(d.feeTiers) && d.feeTiers.length > 0 && (
                  <dl class="mt-5 grid gap-1 border-t border-dashed border-current/30 pt-4 text-sm">
                    {d.feeTiers.map((t) => (
                      <div class="flex items-baseline justify-between gap-4">
                        <dt class="ticket-soft font-mono text-[0.6875rem] tracking-[0.14em] uppercase">
                          {t.label}
                        </dt>
                        <dd class="tabular font-bold">${t.amount}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>

              {/* Everything below the perforation is the part you would keep.
                A column, so the register button can be pushed to the bottom and
                the two tickets' buttons line up even though one includes list
                is a line longer than the other. */}
              <div class="ticket__stub flex flex-col p-7 pt-8">
                {Array.isArray(d.includes) && d.includes.length > 0 && (
                  <ul class="mb-6 grid gap-2 text-sm">
                    {d.includes.map((item) => (
                      <li class="flex items-start gap-2">
                        <span aria-hidden="true">&#10003;</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {registerHref(d.runSignUpEventId) && (
                  <a
                    class="btn-plate mt-6 w-full justify-center md:mt-auto md:pt-6"
                    href={registerHref(d.runSignUpEventId)}
                    {...externalLinkAttrs(registerHref(d.runSignUpEventId))}
                    rel="noopener"
                  >
                    {/* ONE LINE, ALWAYS. As a bare text node inside the flex row
                        the label was its own shrinkable item, so on a phone
                        "Register for the" wrapped inside itself while the
                        distance stayed put on the right: two buttons in one
                        plate. */}
                    <span class="whitespace-nowrap">
                      Register <span class="hidden min-[24rem]:inline">for the </span>
                      <span class="lc">{d.name}</span>
                    </span>
                    <span class="btn-plate__arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </a>
                )}

                <Provisional
                  confirmed={d.confirmed}
                  what="These times and the entry cap have not been confirmed for this year."
                  class="mt-4"
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>

    {
      /* The ladders moved onto the tickets (see above); the race-level tiers now
      only feed the JSON-LD offers. The note stays: it is where the director
      says what the early price is. */
    }
    {note && <p class="mt-8 text-center text-sm text-muted-foreground">{note}</p>}
  </div>
</section>

<script>
  // Tell each ticket where its perforation is, so the mask in globals.css can
  // punch the notches at the right height. The stub's top edge is the
  // perforation; the discs it replaces were centred 1px above it, and
  // offsetTop is measured from the padding edge, inside the 2px border, so
  // both are folded in here. Re-measured on resize, because the copy above the
  // perforation reflows and moves it.
  // Observing inside the pass means tickets that arrive with a view
  // transition get watched too; observe() is idempotent for a known target.
  const ro = 'ResizeObserver' in window ? new ResizeObserver(() => placePerforations()) : null;
  function placePerforations() {
    document.querySelectorAll<HTMLElement>('.ticket').forEach((ticket) => {
      const stub = ticket.querySelector<HTMLElement>('.ticket__stub');
      if (!stub) return;
      ticket.style.setProperty('--perf-y', `${stub.offsetTop + 2 - 1}px`);
      ro?.observe(stub);
    });
  }
  placePerforations();
  document.addEventListener('astro:page-load', placePerforations);
  if (!ro) window.addEventListener('resize', placePerforations);
</script>
