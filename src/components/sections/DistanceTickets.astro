---
// Foundation, edit with care
//
// The two entries, as race tickets.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// WHY A TICKET. The element stopped being a styled div and became an object
// from the race's own world, and the mapping carries information the plain
// version could not: the perforation separates what the entry IS from what you
// KEEP, so the includes list and the register button sit on the tear-off stub.
// The notches are filled with the page ground (--ground) rather than a fixed
// colour, which is what makes them read as holes punched through the card in
// both themes. See the .ticket rules in globals.css.
//
// Per-distance register links matter here. Each distance carries its own
// RunSignUp event id, so the button lands the entrant on the right event
// instead of the generic race page.

import Provisional from '@/components/race/Provisional.astro';
import type { ProjectedDistanceTicketsSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  note?: string;
  distances?: ProjectedDistanceTicketsSection['distances'];
  race?: ProjectedDistanceTicketsSection['race'];
  headingId?: string;
};

const {
  eyebrow,
  headline = 'Two distances',
  note,
  distances = [],
  race,
  headingId = 'distances-heading',
} = Astro.props as Props;

/** Deep-link to this distance's own event where we know its id. */
function registerHref(eventId?: number): string | undefined {
  if (!race?.registerUrl) return undefined;
  return eventId ? `${race.registerUrl}?eventId=${eventId}` : race.registerUrl;
}
---

<section class="bg-muted py-section-lg" id="distances" aria-labelledby={headingId}>
  <div class="mx-auto w-full max-w-content px-6">
    {
      eyebrow && (
        <p class="blaze text-heading-accent mb-4 font-mono text-[0.72rem] font-semibold tracking-[0.22em] uppercase">
          {eyebrow}
        </p>
      )
    }
    <h2 id={headingId} class="display text-h2">{headline}</h2>

    <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-start">
      {
        distances.map((d) => (
          <article class="ticket w-full max-w-[26rem] justify-self-center">
            {d.featured && d.kicker && (
              <div class="ticket__flag" aria-hidden="true">
                <span>{d.kicker}</span>
              </div>
            )}

            <div class="p-7">
              {/* The kicker is repeated as real text because the corner flag is
                  aria-hidden: a screen reader would otherwise announce it twice. */}
              <p class="font-mono text-[0.62rem] tracking-[0.2em] uppercase opacity-70">
                {d.kicker}
              </p>
              <h3 class="display on-light mt-1 text-[clamp(3rem,7vw,4.5rem)]">
                <span class="lc">{d.name}</span>
              </h3>
              {d.loopStructure && <p class="mt-3 text-sm opacity-80">{d.loopStructure}</p>}
              {d.blurb && <p class="mt-4 text-sm leading-relaxed opacity-90">{d.blurb}</p>}

              <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
                {d.startTime && (
                  <div>
                    <dt class="font-mono text-[0.6rem] tracking-[0.18em] uppercase opacity-60">
                      Start
                    </dt>
                    <dd class="tabular">{d.startTime}</dd>
                  </div>
                )}
                {d.entryCap && (
                  <div>
                    <dt class="font-mono text-[0.6rem] tracking-[0.18em] uppercase opacity-60">
                      Entry cap
                    </dt>
                    <dd class="tabular">{d.entryCap}</dd>
                  </div>
                )}
              </dl>
              {d.trekkerNote && <p class="mt-3 text-xs opacity-70">{d.trekkerNote}</p>}
            </div>

            {/* Everything below the perforation is the part you would keep. */}
            <div class="ticket__stub p-7 pt-8">
              {Array.isArray(d.includes) && d.includes.length > 0 && (
                <ul class="grid gap-2 text-sm">
                  {d.includes.map((item) => (
                    <li class="flex items-start gap-2">
                      <span aria-hidden="true">&#10003;</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}

              {registerHref(d.runSignUpEventId) && (
                <a
                  class="btn-plate mt-6 w-full justify-center"
                  href={registerHref(d.runSignUpEventId)}
                  rel="noopener"
                >
                  Register for the <span class="lc">{d.name}</span>
                </a>
              )}

              <Provisional
                confirmed={d.confirmed}
                what="These times and the entry cap have not been confirmed for this year."
                class="mt-4"
              />
            </div>
          </article>
        ))
      }
    </div>

    {
      Array.isArray(race?.feeTiers) && race.feeTiers.length > 0 && (
        <ul class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-2 font-mono text-xs tracking-wide text-muted-foreground">
          {race.feeTiers.map((t) => (
            <li>
              <span class="tabular font-bold text-foreground">${t.amount}</span> {t.label}
            </li>
          ))}
        </ul>
      )
    }
    {note && <p class="mt-3 text-center text-sm text-muted-foreground">{note}</p>}
  </div>
</section>
