---
// Foundation, edit with care
//
// The record holders, as callouts.
//
// CONTENT block: receives a surface from the cadence in sectionCadence.ts.
//
// DERIVED, not typed. The mockup hardcoded two names and two times. That is the
// same hand-maintained duplication the records system exists to remove: the day
// somebody breaks one of these, the band goes quietly wrong while still looking
// authoritative. These come from the same merged set the records tables use, so
// this band and the page it links to cannot disagree.
//
// THE HEADLINE PROMISED A BOARD AND NOW THERE IS ONE (2026-09-17). The four
// holders were four text callouts with a rust rule down the left, under a
// headline reading "The names on the board". Nothing on the band was a board.
// They sit on the real object now: RecordBoard.astro, the painted trailhead
// sign, with each name struck on as the band comes into view. The data is
// untouched; only the thing it is printed on changed.

import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import RecordBoard from '@/components/race/RecordBoard.astro';
import { bracketRecords, courseRecord } from '@/lib/age-brackets';
import { formatRaceTime } from '@/lib/race-time';
import type { ProjectedDynastiesSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  cta?: ProjectedDynastiesSection['cta'];
  distances?: ProjectedDynastiesSection['distances'];
  results?: ProjectedDynastiesSection['results'];
  historical?: ProjectedDynastiesSection['historical'];
  surface?: string;
  headingId?: string;
};

const {
  eyebrow,
  headline = 'The names on the board',
  cta,
  distances = [],
  results = [],
  historical = [],
  surface = 'background',
  headingId = 'dynasties-heading',
} = Astro.props as Props;

const GENDERS = [
  { key: 'M', label: 'Men' },
  { key: 'F', label: 'Women' },
] as const;

// One callout per distance and gender: whoever holds the outright record.
const holders = distances
  .filter((d) => d.slug)
  .flatMap((d) =>
    GENDERS.map((g) => {
      const set = results.filter((r) => r.distance === d.slug && r.gender === g.key);
      const hist = historical.filter((h) => h.distance === d.slug && h.gender === g.key);
      const rec = courseRecord(bracketRecords(set, hist));
      return rec?.athlete && rec.timeSeconds
        ? { distance: d.name ?? '', gender: g.label, ...rec }
        : null;
    }),
  )
  .filter((x): x is NonNullable<typeof x> => x !== null);

const surfaceClass = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';
---

{
  holders.length > 0 && (
    <section class={`py-section-lg ${surfaceClass}`} aria-labelledby={headingId}>
      <div class="mob-center mx-auto w-full max-w-content px-6">
        <SectionHeading {eyebrow} {headline} {headingId} />

        {/* ONE BOARD, FOUR ROWS, NOT A GRID OF FOUR. The callouts were two
            across from the narrowest phone, which was the right answer for
            four stacks of small type and the wrong one for an object: a sign
            with four rows on it is read straight down, and the four times line
            up in a rail at the right the way they do on a real one. Capped
            short of the content column: past about 54rem the rail pulls so far
            from the names that a row stops reading as one line, which is the
            same failure the results tables were rebuilt to fix. */}
        <RecordBoard
          class="mob-left mt-10 max-w-[54rem]"
          label="Course record holders"
          rows={holders.map((h) => ({
            label: `${h.gender} ${h.distance}`,
            name: h.athlete as string,
            slug: h.athleteSlug,
            time: formatRaceTime(h.timeSeconds),
            year: h.year,
          }))}
        />

        {cta && (
          <div class="mt-10">
            <CtaLink {cta} class="btn-plate btn-plate--cream" />
          </div>
        )}
      </div>
    </section>
  )
}
