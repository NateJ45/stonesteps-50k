---
// Foundation, edit with care
//
// The band at the top of an inner page.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// The title takes an optional SECOND LINE field rather than allowing HTML. The
// mockup rendered this value with set:html so an editor could type a <br>,
// which is fine while the value lives in a TypeScript file and is an injection
// surface the moment it comes from a CMS. Two fields cost nothing and cannot be
// abused.

import SanityImage from '@/components/SanityImage.astro';
import MudField from '@/components/race/MudField.astro';
import Topo from '@/components/race/Topo.astro';
import type { ProjectedPageHeaderSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  /**
   * Optional href for the eyebrow (2026-09-17). The archive's year pages use
   * the eyebrow as the way back up to /results, which is the one place on the
   * site where the blaze's words are also a destination. A string-or-nothing
   * prop rather than a slot, for the same reason the headline takes a second
   * LINE field instead of allowing HTML: two fields cost nothing and cannot be
   * abused by a value that one day comes from the CMS.
   */
  eyebrowHref?: string;
  headline?: string;
  headlineSecondLine?: string;
  /**
   * Strike the headline onto the page at poster size (2026-09-17).
   *
   * FOR A NUMERAL, AND ONLY FOR A NUMERAL. A year page's whole title is
   * "2025", and set at the band's ordinary clamp it was a heading the size of
   * "Ask the race director" with three quarters of the line empty beside it.
   * Four digits can carry the hero's own treatment: the press coming down, the
   * second pass of rust ink behind it, the size the wordmark is set at. A
   * sentence cannot, which is why this is a flag a page opts into rather than
   * the band's new default.
   *
   * NOT A NEW OBJECT. It is `.stamp-word` and `.display-echo`, the two the
   * hero already uses, on one span. Reduced motion switches the press off
   * through the shared rule, and the word is painted from its first frame, so
   * this cannot become a page whose largest element arrives late.
   */
  headlineStamp?: boolean;
  lede?: string;
  image?: ProjectedPageHeaderSection['image'];
  /** Stand the photograph as a cut-out on a pool of ground. See ImageText. */
  cutout?: boolean;
  seed?: number;
  headingId?: string;
};

const {
  eyebrow,
  eyebrowHref,
  headline = '',
  headlineSecondLine,
  headlineStamp = false,
  lede,
  image,
  cutout = false,
  seed = 17,
  headingId = 'page-header-heading',
} = Astro.props as Props;

const hasImage = Boolean(image?.asset);
---

<section
  class="relative overflow-hidden border-b border-border bg-background pt-8 pb-section-lg lg:pt-section-lg"
  aria-labelledby={headingId}
>
  {
    /* A WALK, NOT CONTOUR LINES. The topo here was thirteen hairlines at half
    opacity, which at that weight stops reading as a map and starts reading as
    stray marks on the paper: interesting enough to notice, not confident
    enough to be anything. One route of prints crossing the band says the same
    thing (this is a trail race, this is terrain) and says it deliberately.

    The contours are kept where they are a deliberate object rather than a
    whisper: dense behind the hero, and inside the disc behind the race
    director, where they are enlarged into a map detail. */
  }
  {
    /* THE FADE IS WHAT STOPS THE PRINTS BEING SLICED. This section clips
    (overflow-hidden, for the photograph's corner), and the walk fills it edge
    to edge, so without a mask the prints nearest the top and bottom are cut
    through the middle and read as a printing fault. Same treatment as the
    director band and the elevation band: thin the field out before the clip
    reaches it. */
  }
  <MudField field="walk" class="header-walk mud-edge-fade" />

  <div class="mob-center relative z-10 mx-auto w-full max-w-content px-6">
    {
      /* THE SHARED SPLIT (2026-09-18). This band's own 1.1fr/0.9fr grid is the
        one the whole site now uses, so it declares it through `.split` in
        globals.css rather than keeping a private copy of the numbers. Nothing
        here moves: the same two tracks, the same 2.5rem gutter. The one
        difference is that the shared rule wraps each track in `minmax(0, ...)`,
        which stops a long unbroken word in either column from widening its
        track past its share; at this band's sizes nothing reaches that limit,
        and the measured geometry is identical before and after. The reason for
        the move is the four other splits the site was carrying, listed on
        `.split` itself. */
    }
    <div class={hasImage ? 'split lg:items-center' : ''}>
      <div>
        {
          eyebrow && (
            <p class="blaze text-heading-accent mb-4 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
              {eyebrowHref ? (
                <a class="hover:underline" href={eyebrowHref}>
                  {eyebrow}
                </a>
              ) : (
                eyebrow
              )}
            </p>
          )
        }
        {
          /* Two BLOCK spans, not a <br>. A <br> gives no word boundary, so the
            accessible name came out as "Ask therace director." run together.
            Blocks break the line visually and keep the words separate for a
            screen reader. */
        }
        <h1
          id={headingId}
          class:list={[
            'display',
            headlineStamp
              ? 'display-echo text-[clamp(5rem,22vw,7rem)] lg:text-[clamp(5rem,11vw,8.5rem)]'
              : 'text-[clamp(2.5rem,7vw,5.5rem)]',
          ]}
        >
          {
            /* The stamped variant wraps the SAME string in one `.stamp-word`
              rather than splitting it per word the way the hero does. The hero
              splits because its mark is three words landing in sequence; a
              year is one press. No sr-only twin either, for the same reason:
              nothing here is drawn per character, so the text in the heading
              is the text a screen reader gets. */
          }
          {
            /* `inline-block`, not `block`, when it is stamped. The press opens
              at 2.4x about the element's own centre, and a full-width block
              would swing a numeral halfway across the band (and out through
              the section's clip) on the way in. An inline-block box is the
              width of the digits, so the press opens around them. */
          }
          <span class:list={[headlineStamp ? 'stamp-word inline-block' : 'block']}>{headline}</span>
          {
            /* The explicit space is load-bearing: Astro strips the whitespace
              between adjacent expressions, so without it the two lines
              concatenate into "Ask therace director." in the accessible name
              even though they render on separate lines. */
          }
          {
            headlineSecondLine && (
              <>
                {' '}
                <span class="block">{headlineSecondLine}</span>
              </>
            )
          }
        </h1>
        {
          lede && (
            <p class="mx-auto mt-6 max-w-[46ch] text-lg text-muted-foreground lg:mx-0">{lede}</p>
          )
        }
      </div>

      {
        /* THE CUT-OUT IS THE SAME STAGE THE HOME PAGE GIVES THE DIRECTOR
          (ImageText.astro, `cutout`), one size up: the header column is wider
          than the home band's half, and the source file is 541px across, so
          30rem is as large as he goes before the print softens. The pool,
          the echo plate and the mud at his feet all come from the shared
          `.subject-stage` and `.photo-cutout` rules, so the two appearances
          cannot drift apart.

          THE TWO CUSTOM PROPERTIES (2026-09-18) are what let the stage put him
          on the column's left edge, like every other object on the page,
          without the pool of ground staying behind in the middle of the column.
          `--stage-img-w` is the cap on the picture below (30rem, the same
          number the class carries) and `--stage-spread` is how much wider the
          disc is than the picture: 536 over 480, about 1.12, which is the disc
          this band already drew. The argument is on `.subject-stage` in
          globals.css. */
        hasImage && cutout ? (
          <div
            class="subject-stage subject-stage--soft"
            style="--stage-img-w: 30rem; --stage-spread: 1.12"
          >
            <span class="subject-stage__pool" aria-hidden="true">
              <Topo seed={5} lines={9} />
            </span>
            {/* THIS IS THE LCP ELEMENT on every page with a header photograph,
              and eager alone is not enough: Lighthouse measured 1.2s of "load
              delay" on the course page, the gap between the HTML arriving and
              the browser deciding to fetch this image at all. `fetchpriority`
              puts it in the first request wave. On both variants below. */}
            <SanityImage
              source={image}
              width={1000}
              sizes="(min-width: 1024px) 42vw, 100vw"
              quality={80}
              alt={image?.alt ?? ''}
              loading="eager"
              fetchpriority="high"
              class="photo-cutout photo-cutout--soft h-auto w-full max-w-[30rem]"
            />
            <MudField field="director-fore" class="subject-stage__mud" />
          </div>
        ) : hasImage ? (
          <figure class="overflow-hidden rounded-xl border-2 border-black shadow-[var(--lift-lg)]">
            <SanityImage
              source={image}
              width={1000}
              sizes="(min-width: 1024px) 42vw, 100vw"
              alt={image?.alt ?? ''}
              loading="eager"
              fetchpriority="high"
              class="w-full"
            />
          </figure>
        ) : null
      }
    </div>
  </div>
</section>
