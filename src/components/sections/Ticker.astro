---
// Safe to edit by hand
//
// The scrolling strip under the hero.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// DECORATION, and treated as such. The list is duplicated so the loop has no
// seam, and the whole thing is aria-hidden: a screen reader announcing the same
// six facts twice, out of order, is worse than silence. Every fact in here is
// stated properly somewhere else on the page, which is the condition for
// hiding it.
//
// The animation stops entirely under prefers-reduced-motion. A permanently
// moving strip is a genuine problem for vestibular disorders, and there is no
// version of this that is worth that.

type Props = { items?: string[] };
const { items = [] } = Astro.props as Props;

// HOW MANY COPIES OF THE LIST TO RENDER.
//
// The loop translates the track left by exactly ONE copy's width and starts
// over, so copy 2 lands where copy 1 was and the seam is invisible. That only
// holds while the track stays wider than the viewport for the whole cycle. With
// two copies and a 971px list on a 1600px screen it ran out at the halfway
// point and the strip showed empty red before snapping back.
//
// So: enough copies to repeat the list to a comfortable length, never fewer
// than four, which keeps the strip full past 3x the list width (about 3,000px
// here) and so past any ordinary screen. The shift is 100/copies, making the
// cycle exactly one copy, and the duration is per-copy, so the speed is
// identical no matter how many copies there are.
const COPIES = Math.max(4, Math.ceil(24 / Math.max(items.length, 1)));
const shift = `${(100 / COPIES).toFixed(4)}%`;
---

{
  items.length > 0 && (
    <div
      class="ticker border-y-2 border-black bg-primary text-primary-foreground"
      aria-hidden="true"
    >
      <div class="ticker__ease">
        <div class="ticker__track" style={`--ticker-shift: ${shift}`}>
          {Array.from({ length: COPIES }).map(() => (
            <ul class="ticker__row">
              {items.map((item) => (
                <li>
                  {item}
                  <span class="ticker__dot">&middot;</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  .ticker {
    overflow: hidden;
    padding-block: 0.55rem;
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker-slide 42s linear infinite;
  }

  /* The strip eases in rather than being already at speed the moment the page
     paints. It cannot be done on the track itself: that animation is a linear
     infinite loop, and easing its start would either break the seam or slow the
     whole loop. So the ease is a separate one-shot transform on a wrapper, and
     the two transforms simply compose. */
  .ticker__ease {
    animation: ticker-ease 1500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes ticker-ease {
    from {
      transform: translateX(3.5rem);
    }
    to {
      transform: none;
    }
  }
  .ticker__row {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ticker__row li {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ticker__dot {
    opacity: 0.55;
  }

  /* Identical rows, so the reset after exactly one row is invisible. The shift
     comes in from COPIES; the fallback keeps this sane if it ever goes missing. */
  @keyframes ticker-slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--ticker-shift, 25%)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__ease {
      animation: none;
    }
    .ticker__track {
      animation: none;
      /* Without the animation the duplicate row is dead weight, and the strip
         should still read as a strip rather than as a truncated list. */
      width: 100%;
      overflow-x: auto;
    }
    .ticker__row:not(:first-child) {
      display: none;
    }
  }
</style>
