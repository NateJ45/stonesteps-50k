---
// Foundation, edit with care
//
// The all-time records board.
//
// EVERYTHING HERE IS DERIVED. The component receives the raw results archive
// and the transcribed historical rows, and computes the course record, the top
// ten and the age-bracket table itself, through src/lib/age-brackets.ts. There
// is no field an editor can type a record into, on purpose: the site this
// replaces stores its records as hand-copied duplicates of age rows, and those
// copies have already drifted apart. See raceResult.ts for the full argument.
//
// DELIBERATELY PLAIN. The rest of the site turns elements into objects from the
// race's world (tickets, punch cards, patches). This page does not, and that is
// the decision, not an omission: its entire job is forty rows of times, and
// decorating data is how you make data unreadable. The only visual weight is on
// the outright record row.
//
// ACCESSIBILITY. The distance switcher is a real ARIA tablist with roving
// tabindex, arrow keys that wrap, and Home/End. Every table carries a
// screen-reader caption and uses `scope` on both column and row headers, so the
// bracket name is announced with each cell rather than leaving a screen reader
// to guess which row it is in.
//
// THE FRAME IS A BOARD NOW (2026-09-17), AND ONLY THE FRAME.
// The tables above stay exactly as plain as the note above promises: nothing
// inside a panel changed. What changed is what the panel sits on. The page is
// called The records, the headline above it says the names are on a board, the
// tabs are already sign plates, and underneath all of that the rows were
// floating on the bare band. So each distance's panel goes on the trailhead
// kiosk the FAQ is built from: the same `.kiosk` stock and the same INSET
// shadow, which is the whole point of that object. A raised card would have
// been one more thing sitting on the page; a recess reads as a board set into a
// post, which is what the page has been claiming to be.
//
// AND THE BIG FAINT TIME MOVED ONTO IT, per distance. The mark used to be one
// per section, printed on the band behind everything and derived from the 50K
// board only, which meant the 27K tab showed a 50K record behind a table headed
// Women 27K. Two things made that worth fixing now rather than later: a board
// with an opaque stock would have hidden the mark outright, and the file's own
// note on `fastestMark` already argued that a time this size beside the wrong
// heading is a lie whichever direction it points. Each panel now prints its own
// distance's record on its own board, behind its own rows. The ghost photograph
// stays where it was, on the band, so it still bleeds past the board's edge.

import SectionHeading from '@/components/SectionHeading.astro';
import DataMark from '@/components/race/DataMark.astro';
import GhostPhoto from '@/components/race/GhostPhoto.astro';
import { bracketRecords, courseRecord, fastestOnFile, type RecordRow } from '@/lib/age-brackets';
import { formatRaceTime } from '@/lib/race-time';
import type { ProjectedRecordsBoardSection } from '@/lib/pageBuilder.types';
import { externalLinkAttrs } from '@/lib/links';

type Props = {
  eyebrow?: string;
  headline?: string;
  intro?: string;
  distances?: ProjectedRecordsBoardSection['distances'];
  results?: ProjectedRecordsBoardSection['results'];
  historical?: ProjectedRecordsBoardSection['historical'];
  race?: ProjectedRecordsBoardSection['race'];
  surface?: string;
  headingId?: string;
};

const {
  eyebrow,
  headline = 'All-time records',
  intro,
  distances = [],
  results = [],
  historical = [],
  race,
  surface = 'background',
  headingId = 'records-heading',
} = Astro.props as Props;

const GENDERS = [
  { key: 'M', label: 'Men' },
  { key: 'F', label: 'Women' },
] as const;

/** Build every table for one distance, once, so the markup is a pure map. */
function boardFor(slug: string) {
  return GENDERS.map((g) => {
    const set = results.filter((r) => r.distance === slug && r.gender === g.key);
    const hist = historical.filter((h) => h.distance === slug && h.gender === g.key);

    const brackets = bracketRecords(set, hist);
    const course = courseRecord(brackets);

    // THE TOP TEN INCLUDES THE TRANSCRIBED RECORDS. It used to be the results
    // archive alone, on the argument that a transcribed record is one best mark
    // rather than a ranked field. The page that produced was wrong: the 27K
    // board named a course record of 1:58:36 by Brian List in 2010 and then
    // listed the fastest ten starting at 1:59:32 with him nowhere on it.
    //
    // Since 2026-09-17 there are no transcribed records at all: the 27K began
    // in 2015 (Dave), so the pre-2015 marks were for a race that did not
    // exist and were retired. Every row on this board now has a finish behind
    // it, and `hist` is an empty list until a record with evidence and no
    // result ever appears. See fastestOnFile for the merge that would handle
    // it.
    const topTen = fastestOnFile(set, hist, 10);

    // Which bracket row holds the outright record. The mockup highlighted a
    // stored "Course" row; we derive that record, so the highlight follows it.
    const overall = course?.bracket ?? null;

    return { ...g, brackets, course, overall, topTen, archiveCount: set.length };
  });
}

/** The fastest course record on one distance's board, or null. */
function markFor(genders: ReturnType<typeof boardFor>) {
  const seconds = genders
    .map((g) => g.course?.timeSeconds)
    .filter((t): t is number => typeof t === 'number' && t > 0)
    .reduce<number | null>((a, t) => (a === null || t < a ? t : a), null);
  return seconds ? formatRaceTime(seconds) : null;
}

const boards = distances
  .filter((d) => d.slug)
  .map((d) => {
    const genders = boardFor(d.slug as string);
    return { ...d, slug: d.slug as string, genders, mark: markFor(genders) };
  });

const surfaceClass = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';

// THE MARK IS DERIVED, NEVER STORED, and that part has not changed: it comes
// out of the same rows the board is built from, so it cannot disagree with the
// table it sits behind, and import a faster run tomorrow and it moves. It is
// also printed in full a few hundred pixels away, which is the rule for every
// mark like this - the big version is never the only place a value appears.
---

<section class={`relative py-section-lg ${surfaceClass}`} aria-labelledby={headingId}>
  {
    /* Clipped by a wrapper, never by the section: the band's ridge lives above
    its own box. See GhostPhoto's header. */
  }
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <GhostPhoto image={race?.atmosphere?.[1] ?? race?.atmosphere?.[0]} side="right" />
  </div>
  <div class="mob-center relative z-10 mx-auto w-full max-w-content px-6">
    <SectionHeading {eyebrow} {headline} {headingId} />
    {intro && <p class="mx-auto mt-4 max-w-[52ch] text-muted-foreground lg:mx-0">{intro}</p>}

    {
      boards.length > 0 && (
        <>
          <div class="tabs records-tabs mt-10 flex gap-2" role="tablist" aria-label="Race distance">
            {boards.map((b, i) => (
              <button
                type="button"
                role="tab"
                id={`rtab-${b.slug}`}
                aria-controls={`rpanel-${b.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={b.slug}
                class="display lc rounded-md border-2 border-black px-5 py-2 text-lg transition-colors aria-selected:bg-primary aria-selected:text-primary-foreground"
              >
                {b.name}
              </button>
            ))}
          </div>

          {boards.map((b, i) => (
            <div
              class="panel mob-left mt-8"
              id={`rpanel-${b.slug}`}
              role="tabpanel"
              aria-labelledby={`rtab-${b.slug}`}
              hidden={i !== 0}
            >
              {/* The board. Same three classes the FAQ's kiosk wears, so there
                is one recessed object on this site and not two that happen to
                look alike; `.kiosk--records` in globals.css only adds what a
                board holding tables needs that a board holding index cards does
                not. The mark's wrapper is what clips it, never the board, for
                the same reason GhostPhoto's caller clips that: a radius on the
                clipping layer and nothing spilling onto the page. */}
              <div class="kiosk kiosk--records rounded-2xl border-2 border-black p-5 sm:p-8">
                <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]">
                  <DataMark text={b.mark} align="left" />
                </div>
                <div class="relative z-10 grid gap-10 lg:grid-cols-2">
                  {b.genders.map((g) => (
                    <div>
                      <h3 class="display mb-3 text-h4">
                        {g.label} <span class="lc">{b.name}</span>
                      </h3>

                      {g.course?.timeSeconds && (
                        <p class="mb-4 text-sm text-muted-foreground">
                          Course record{' '}
                          <span class="tabular font-bold text-foreground">
                            {formatRaceTime(g.course.timeSeconds)}
                          </span>
                          {g.course.athlete && <> by {g.course.athlete}</>}
                          {g.course.year && <>, {g.course.year}</>}.
                        </p>
                      )}

                      <div class="overflow-x-auto">
                        <table class="w-full border-collapse text-sm">
                          <caption class="sr-only">
                            {g.label} {b.name} records by age group
                          </caption>
                          <thead>
                            <tr class="border-b border-primary/30">
                              <th
                                scope="col"
                                class="pb-2 text-left font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                              >
                                Bracket
                              </th>
                              <th
                                scope="col"
                                class="pb-2 text-left font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                              >
                                Holder
                              </th>
                              <th
                                scope="col"
                                class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                              >
                                Year
                              </th>
                              <th
                                scope="col"
                                class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                              >
                                Time
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            {g.brackets.map((row: RecordRow) => (
                              <tr
                                class={`border-b border-border/60 ${
                                  row.bracket === g.overall ? 'is-overall' : ''
                                }`}
                              >
                                <th scope="row" class="rec-bracket py-2 pr-3 text-left font-normal">
                                  {row.label}
                                </th>
                                <td class="rec-name py-2 pr-3">
                                  {row.athlete ? (
                                    row.athleteSlug ? (
                                      <a
                                        class="underline-offset-2 hover:text-link hover:underline"
                                        href={`/runners/${row.athleteSlug}`}
                                      >
                                        {row.athlete}
                                      </a>
                                    ) : (
                                      row.athlete
                                    )
                                  ) : row.timeSeconds ? (
                                    /* A time with no name is a record whose holder is
                                    not on file, which is a different thing from a
                                    bracket nobody has run. It used to say
                                    "Unclaimed" next to a year and a time. */
                                    <span class="text-muted-foreground">Name not on file</span>
                                  ) : (
                                    <span class="text-muted-foreground">Unclaimed</span>
                                  )}
                                </td>
                                <td class="py-2 text-right whitespace-nowrap">{row.year ?? ''}</td>
                                <td class="rec-time tabular py-2 text-right font-bold whitespace-nowrap">
                                  {formatRaceTime(row.timeSeconds) || '—'}
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>

                      {g.topTen.length > 0 && (
                        <div class="mt-8 overflow-x-auto">
                          <table class="w-full border-collapse text-sm">
                            <caption class="pb-2 text-left font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase">
                              Fastest {g.topTen.length} on file
                            </caption>
                            <thead>
                              <tr class="border-b border-primary/30">
                                <th
                                  scope="col"
                                  class="pb-2 text-left font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                                >
                                  #
                                </th>
                                <th
                                  scope="col"
                                  class="pb-2 text-left font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                                >
                                  {g.label}
                                </th>
                                <th
                                  scope="col"
                                  class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                                >
                                  Year
                                </th>
                                <th
                                  scope="col"
                                  class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                                >
                                  Time
                                </th>
                              </tr>
                            </thead>
                            <tbody>
                              {g.topTen.map((row, idx) => (
                                <tr
                                  class={`border-b border-border/60 ${idx === 0 ? 'is-overall' : ''}`}
                                >
                                  <th
                                    scope="row"
                                    class="rec-bracket tabular py-2 pr-3 text-left font-normal"
                                  >
                                    {String(idx + 1).padStart(2, '0')}
                                  </th>
                                  <td class="rec-name py-2 pr-3">
                                    {row.athlete?.slug ? (
                                      <a
                                        class="underline-offset-2 hover:text-link hover:underline"
                                        href={`/runners/${row.athlete.slug}`}
                                      >
                                        {row.athlete.name}
                                      </a>
                                    ) : (
                                      (row.athlete?.name ?? '')
                                    )}
                                  </td>
                                  <td class="py-2 text-right whitespace-nowrap">
                                    {row.year ?? ''}
                                  </td>
                                  <td class="rec-time tabular py-2 text-right font-bold whitespace-nowrap">
                                    {formatRaceTime(row.timeSeconds)}
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </>
      )
    }

    {
      /* Only the pointer survives. The paragraph that used to sit here described
        the archive's coverage and gaps and explained the ? marker on records
        the race's own tables report two ways; both were cut on 2026-09-11 as
        more caveat than a records board needs. The one thing a visitor still
        has to be told is where the rest of the results are. */
      race?.resultsUrl && (
        <p class="mt-10 max-w-[62ch] text-sm text-muted-foreground">
          <a
            class="text-link underline"
            href={race.resultsUrl}
            {...externalLinkAttrs(race.resultsUrl)}
          >
            The complete results archive lives on RunSignUp.
          </a>
        </p>
      )
    }
  </div>
</section>

<script>
  // Roving tabindex over the distance switcher.
  //
  // Scoped to each tablist rather than a document-wide querySelectorAll, so a
  // second board on the same page cannot steal the first one's keyboard focus.
  // Home and End are handled because a tablist that only answers arrows is a
  // half-implemented widget.
  //
  // RE-BOUND ON EVERY NAVIGATION, for the same reason the countdown is: a
  // module runs once per full page load, and the ClientRouter swaps the
  // document without re-executing it. Leaving this page and coming back
  // otherwise gave you a tablist whose buttons did nothing, which is worse than
  // a stopped clock because it looks like a working control.
  //
  // No teardown needed here, unlike the countdown: every listener is attached
  // to an element inside the swapped subtree and goes with it. Nothing is
  // registered on `document` or `window`, and there is no timer.
  const bindTablist = (list: HTMLElement) => {
    if (list.dataset.tablistBound === '1') return;
    list.dataset.tablistBound = '1';
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    if (tabs.length < 2) return;

    const select = (id: string) => {
      for (const t of tabs) {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(`rpanel-${t.dataset.tab}`);
        if (panel) panel.hidden = !on;
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.tab ?? ''));
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let next: HTMLButtonElement | undefined;
        if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (e.key === 'Home') next = tabs[0];
        else if (e.key === 'End') next = tabs[tabs.length - 1];
        if (!next) return;
        e.preventDefault();
        select(next.dataset.tab ?? '');
        next.focus();
      });
    });
  };

  const setupTablists = () => {
    document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach(bindTablist);
  };

  setupTablists();
  document.addEventListener('astro:page-load', setupTablists);
</script>
