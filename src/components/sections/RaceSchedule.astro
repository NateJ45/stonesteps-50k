---
// Foundation, edit with care
//
// Race day, on a clipboard.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// The clipboard is apt rather than decorative: several of these times are still
// unconfirmed, and a clipboard reads as "not final yet". Board, metal clamp,
// paper sheet, all CSS, no images.
//
// A row with no confirmed time shows "To be confirmed" and NOT a plausible
// hour. The mockup this is based on invented an entire race-day schedule, and
// that is precisely the failure this is built to prevent.

import type { ProjectedRaceScheduleSection } from '@/lib/pageBuilder.types';
import GhostPhoto from '@/components/race/GhostPhoto.astro';

type Props = {
  eyebrow?: string;
  headline?: string;
  items?: ProjectedRaceScheduleSection['items'];
  race?: ProjectedRaceScheduleSection['race'];
  headingId?: string;
};

const {
  eyebrow,
  headline = 'Race day',
  items = [],
  race,
  headingId = 'schedule-heading',
} = Astro.props as Props;

// Atmosphere sits in the LEFT margin here and in the right margin on the
// records board, so two bands on one page never mirror each other.
const ghost = race?.atmosphere?.[0];
---

{
  items.length > 0 && (
    <section class="band-torn relative bg-background py-section-lg" aria-labelledby={headingId}>
      {/* Clipped by a wrapper, never by the section: the band's ridge lives
        above its own box. See GhostPhoto's header. */}
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <GhostPhoto image={ghost} side="left" />
      </div>
      <div class="mob-center relative z-10 mx-auto w-full max-w-content px-6">
        {eyebrow && (
          <p class="blaze text-heading-accent mb-4 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
            {eyebrow}
          </p>
        )}
        <h2 id={headingId} class="display text-h2">
          {headline}
        </h2>

        {/* THE CLIPBOARD SITS UNDER ITS OWN HEADING (2026-09-18). It was
          `mx-auto` at every width, so on the home page a 736px board floated in
          the middle of the page at x=272 with its heading at 24, while the same
          clipboard on /results/2025 sat at 24 like the record board beside it.
          `lg:mx-0` puts it on the column's left edge from `lg` up and leaves the
          phone alone, where a 327px column centres everything anyway. */}
        <div class="clip mx-auto mt-14 max-w-[46rem] px-[1.1rem] pt-6 pb-[1.1rem] lg:mx-0">
          <div class="clip__clamp" aria-hidden="true" />
          <div class="clip__sheet p-6 sm:p-8">
            <ol class="grid gap-1">
              {items.map((item) => (
                <li class="grid grid-cols-[6.5rem_1fr] items-baseline gap-x-4 gap-y-0.5 border-b border-black/10 py-2.5 last:border-b-0 sm:grid-cols-[6.5rem_minmax(0,1fr)_auto]">
                  <span
                    class={`tabular text-sm ${item.time ? 'text-[color:var(--plate-accent)]' : 'text-[color:var(--plate-ink-soft)]'}`}
                  >
                    {item.time ?? 'TBC'}
                  </span>
                  <span class="display on-light text-[1.15rem]">{item.label}</span>
                  {item.detail && (
                    <span class="col-start-2 text-xs text-[color:var(--plate-ink-soft)] sm:col-start-3 sm:text-right">
                      {item.detail}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>
  )
}
