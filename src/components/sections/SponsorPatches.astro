---
// Foundation, edit with care
//
// Sponsors, as embroidered patches.
//
// THE LOGO NEEDS A DEFINITE HEIGHT, not max-height with w-auto. An unloaded
// lazy image with width:auto shrink-wraps to a 0x0 box, so it never intersects
// the viewport, so it never loads: the logos simply never appeared, on a page
// that looked fine in a screenshot because the patches still had their own
// min-height. A definite height plus the intrinsic aspect ratio gives the
// browser a real box to reserve before the bytes arrive. max-w-full clamps the
// wide marks and object-contain letterboxes rather than squashing, so a
// 1000x204 wordmark and a square badge both sit correctly on the patch.
//
// SELF_CONTAINED: paints its own ground, never receives a surface prop.
//
// This replaced the greyscale-logos-at-70%-opacity strip, which is the single
// most common generated-design default in existence. Logos show in FULL COLOUR
// here, because patches are colourful and because a sponsor who paid deserves
// their actual mark rather than a washed-out one.

import SanityImage from '@/components/SanityImage.astro';
import { externalLinkAttrs } from '@/lib/links';
import type { ProjectedSponsorPatchesSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  sponsors?: ProjectedSponsorPatchesSection['sponsors'];
  headingId?: string;
};

const {
  eyebrow,
  headline = 'With thanks',
  sponsors = [],
  headingId = 'sponsors-heading',
} = Astro.props as Props;
---

{
  sponsors.length > 0 && (
    <section class="band-torn bg-background py-section-md" aria-labelledby={headingId}>
      <div class="mob-center mx-auto w-full max-w-content px-6">
        {eyebrow && (
          <p class="blaze text-heading-accent mb-4 font-mono text-[0.75rem] font-semibold tracking-[0.22em] uppercase">
            {eyebrow}
          </p>
        )}
        <h2 id={headingId} class="display text-h3">
          {headline}
        </h2>

        <ul class="mt-8 flex flex-wrap items-stretch justify-center gap-6">
          {sponsors.map((s) => (
            <li class="patch min-h-[9.5rem] w-full max-w-[16rem] px-6 py-7">
              {/* A patch with a url is a link to the sponsor's own site, in a
                new tab; without one it is just a patch. The anchor fills the
                patch so the whole object is the target, not only the mark. */}
              {s.url ? (
                <a
                  href={s.url}
                  class="patch__link"
                  aria-label={`${s.name ?? 'Sponsor'} website`}
                  {...externalLinkAttrs(s.url)}
                >
                  {s.logo?.asset ? (
                    <SanityImage
                      source={s.logo}
                      width={512}
                      sizes="256px"
                      alt={s.logo.alt ?? s.name ?? ''}
                      class="h-[6rem] max-w-full object-contain"
                    />
                  ) : (
                    <span class="display on-light text-center text-[1.05rem]">{s.name}</span>
                  )}
                </a>
              ) : s.logo?.asset ? (
                <SanityImage
                  source={s.logo}
                  width={512}
                  sizes="256px"
                  alt={s.logo.alt ?? s.name ?? ''}
                  class="h-[6rem] max-w-full object-contain"
                />
              ) : (
                <span class="display on-light text-center text-[1.05rem]">{s.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
