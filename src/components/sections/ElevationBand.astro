---
// Foundation, edit with care
//
// The elevation band: heading, intro, and the profile itself.
//
// CONTENT block: receives a surface from the cadence in sectionCadence.ts.
//
// The profile's shape is synthetic and says so in its own caption. See
// src/components/race/ElevationProfile.astro before treating it as data.

import SectionHeading from '@/components/SectionHeading.astro';
import Topo from '@/components/race/Topo.astro';
import ElevationProfile from '@/components/race/ElevationProfile.astro';
import type { ProjectedElevationSection } from '@/lib/pageBuilder.types';

type Props = {
  eyebrow?: string;
  headline?: string;
  intro?: string;
  totalGain?: string;
  race?: ProjectedElevationSection['race'];
  surface?: string;
  headingId?: string;
};

const {
  eyebrow,
  headline = 'Ten thousand feet of it',
  intro,
  totalGain,
  race,
  surface = 'background',
  headingId = 'elevation-heading',
} = Astro.props as Props;

const surfaceClass = surface === 'muted' ? 'band-torn bg-muted' : 'band-torn bg-background';
---

<!-- The clip lives on an inner wrapper, not on the <section>. The section
  needs `overflow: visible` so its torn top edge (`.band-torn`, drawn as a
  ::before sitting 15px ABOVE the box) is not cut off; the topo still has to be
  clipped to the band. Same result, one level down. -->
<section class={`relative py-section-lg ${surfaceClass}`} aria-labelledby={headingId}>
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <Topo seed={29} lines={10} opacity={0.35} />
    {
      /* THE BAND'S BACKGROUND IS THE BAND'S SUBJECT. The same profile, from the
      same data, drawn once across the bottom of the whole band and once again
      below as the chart people actually read. A background that is a blown-up
      piece of the content is the thing that stops a section looking like copy
      dropped onto a texture; a generic shape behind a heading is what reads as
      added afterwards. */
    }
    <ElevationProfile
      variant="watermark"
      totalGain={totalGain}
      gpxUrl={race?.gpxUrl}
      profile={race?.elevationProfile}
    />
  </div>
  <div class="mob-center relative z-10 mx-auto w-full max-w-content px-6">
    <SectionHeading {eyebrow} {headline} {headingId} labelDisplay />
    {intro && <p class="mx-auto mt-4 max-w-[52ch] text-muted-foreground lg:mx-0">{intro}</p>}
    <div class="mt-10">
      <ElevationProfile
        totalGain={totalGain}
        gpxUrl={race?.gpxUrl}
        profile={race?.elevationProfile}
      />
    </div>
  </div>
</section>
