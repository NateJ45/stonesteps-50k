---
// Safe to edit by hand
//
// One year's full field, both distances.
//
// PRERENDERED, unlike the runner pages. There are 22 of these and there will
// never be many more (one a year), each is a page a visitor might actually
// search for, and all 22 are built from a SINGLE query whose rows are passed
// through getStaticPaths props. That is the fix the runner pages needed: a
// per-page query there meant 711 round trips and a seven minute build.
//
// WHAT IS DELIBERATELY NOT HERE: the runner's home city. The race published
// city and state alongside every name for twenty years and RunSignUp still
// does, so this is not hiding anything that is not already public. But a
// search-indexed page is a real step up in findability from a results table,
// and the city adds nothing a visitor to a RACE RESULT needs. Name, age, place
// and time are the result. See public-data-policy.json.

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import { getAllResults, getDistanceRefs, getSiteSettings } from '@/lib/queries';
import { editionFor, summariseEditions, type ResultRow, type DistanceRef } from '@/lib/editions';
import { formatRaceTime } from '@/lib/race-time';
import { fastestByBracket } from '@/lib/bracket-leaders';

export async function getStaticPaths() {
  const [results, distances] = await Promise.all([
    getAllResults().catch(() => []),
    getDistanceRefs().catch(() => []),
  ]);

  const rows = results as ResultRow[];
  const dists = distances as DistanceRef[];

  // Only the years that HAVE results get a route. A missing year is listed on
  // /results with an explanation; giving it a page would mean building an empty
  // one that says nothing the index does not already say better.
  return summariseEditions(rows, dists)
    .filter((e) => !e.missing)
    .map((e, i, all) => ({
      params: { year: String(e.year) },
      props: {
        edition: editionFor(rows, e.year, dists)!,
        // Neighbours for the prev/next links, in chronological terms rather
        // than list terms: `all` is newest first, so the NEWER edition is the
        // one before it in the array.
        newer: i > 0 ? all[i - 1].year : null,
        older: i < all.length - 1 ? all[i + 1].year : null,
      },
    }));
}

const { edition, newer, older } = Astro.props;
const siteSettings = await getSiteSettings().catch(() => null);

const anyTrekker = edition.distances.some((d) => d.rows.some((r) => r.trekker));

const title = `${edition.year} results | Stone Steps 50K`;
const description = `Every finisher of the ${edition.year} Stone Steps 50K and 27K, with times.`;

// Built here because PageHeader takes a plain string. Same sentence the page
// has always opened with, assembled instead of interleaved with markup.
const lede =
  `${edition.total} ${edition.total === 1 ? 'finisher' : 'finishers'}` +
  (edition.distances.length > 1
    ? `, across the ${edition.distances.map((d) => d.name).join(' and the ')}`
    : '') +
  '.';
---

<BaseLayout {title} {description} {siteSettings}>
  {
    /* THE SAME HEADER BAND EVERY OTHER INNER PAGE GETS (2026-09-17). See the
      note on /results: a year page used to open on flat background with a
      smaller headline than the rest of the site, which made the whole archive
      read as a bolt-on. The eyebrow keeps its link back up to the archive,
      which is what `eyebrowHref` on PageHeader exists for.

      The tables below are left exactly as they were. This page is a thousand
      rows of times and nothing decorative belongs behind them. */
  }
  <PageHeader
    eyebrow="Results"
    eyebrowHref="/results"
    headline={String(edition.year)}
    {lede}
    headingId="year-heading"
  />

  {/* No aria-labelledby here: see the note on /results. One region per page. */}
  <section class="bg-background py-section-lg">
    <div class="mx-auto w-full max-w-content px-6">
      {
        edition.distances.map((d, di) => (
          <div class="mt-16 first:mt-0">
            {/* A REAL BREAK BETWEEN THE TWO RACES. This was a `text-h3` heading
              43px wide with two and a half thousand pixels of unbroken table
              between it and the next one, so the page read as one endless list
              that changed race somewhere in the middle without saying so. The
              distance now arrives as a chip plus its name at display size over
              a rule the width of the page: the same object the archive page
              uses, so the two agree about what a race looks like. The first
              distance in the Studio's own order is the headline one and gets
              the filled chip. */}
            <div class="dist-head">
              {/* NO CHIP HERE, and that is not an oversight. On the archive
                page a distance is a marker on a dense row, so it is a chip. On
                this page the distance IS the section, so it is a heading, and a
                chip beside a heading that says the same word twice is just
                repetition. The headline race is set in the accent instead, so
                the two blocks are told apart at a glance from anywhere on the
                page rather than by reading them. */}
              <h2 class:list={['display text-h2', di === 0 && 'text-heading-accent']}>{d.name}</h2>
              <p class="tabular text-sm text-muted-foreground">
                {d.finishers} {d.finishers === 1 ? 'finisher' : 'finishers'}
              </p>
            </div>

            {/* The winners sit over the list they came off, so they share its
              measure rather than running the full content column and leaving
              the women's card stranded a screen away from the table beneath
              it. */}
            {d.winners.length > 0 && (
              <ul class="mt-5 grid max-w-[46rem] gap-4 sm:grid-cols-2">
                {d.winners.map((w) => (
                  <li class="border-l-[3px] border-[color:var(--heading-accent)] pl-5">
                    <p class="font-mono text-[0.6875rem] tracking-[0.2em] text-muted-foreground uppercase">
                      {w.gender === 'F' ? 'Women' : 'Men'}
                    </p>
                    <p class="display mt-1 text-h4">
                      {w.row.slug ? (
                        <a class="hover:underline" href={`/runners/${w.row.slug}`}>
                          {w.row.name}
                        </a>
                      ) : (
                        w.row.name
                      )}
                    </p>
                    <p class="tabular text-heading-accent mt-1 text-xl font-bold">
                      {formatRaceTime(w.row.timeSeconds)}
                    </p>
                  </li>
                ))}
              </ul>
            )}

            {/* FASTEST IN EACH AGE GROUP, NOT "AGE GROUP WINNERS". The race's
              own divisions have moved around: 2007 awarded under 30 and 30-39,
              2008 and 2009 replaced both with a single under 40, and several
              years published no divisions at all. Calling these people winners
              would name medals nobody received. The fastest time in an age band
              is true in every year. See src/lib/bracket-leaders.ts.

              Only brackets with somebody in them render, so a thin early field
              shows three rows rather than six with gaps, and 2006 shows nothing
              at all because its source published age ranges instead of ages. */}
            {(() => {
              const groups = [
                { key: 'M', label: 'Men' },
                { key: 'F', label: 'Women' },
              ]
                .map((g) => ({ ...g, leaders: fastestByBracket(d.rows, g.key) }))
                .filter((g) => g.leaders.length > 0);
              if (groups.length === 0) return null;
              return (
                <div class="mt-10 max-w-[46rem]">
                  <p class="font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase">
                    Fastest in each age group
                  </p>
                  <div class="mt-3 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                    {groups.map((g) => (
                      <div>
                        <p class="text-heading-accent font-mono text-[0.6875rem] tracking-[0.2em] uppercase">
                          {g.label}
                        </p>
                        <ul class="ages mt-2">
                          {g.leaders.map((l) => (
                            <li class="ages__row">
                              <span class="ages__bracket">{l.label}</span>
                              <span class="ages__name">
                                {l.row.slug ? (
                                  <a
                                    class="underline-offset-2 hover:text-link hover:underline"
                                    href={`/runners/${l.row.slug}`}
                                  >
                                    {l.row.name}
                                  </a>
                                ) : (
                                  l.row.name
                                )}
                              </span>
                              <span class="ages__time tabular">
                                {formatRaceTime(l.row.timeSeconds)}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })()}

            {/* THE TABLE TAKES A MEASURE, NOT THE COLUMN. Full width, the Name
              cell alone was 762px on a desktop, so a name sat at the left
              margin and its time 880px away with nothing in between: the eye
              had to carry one across the other sixty times over. The <colgroup>
              plus `table-layout: fixed` is what holds it, because without the
              fixed layout the browser hands every spare pixel back to the
              longest name and the gap returns. See .finishers in globals.css. */}
            <div class="mt-7 overflow-x-auto">
              <table class="finishers text-sm">
                <caption class="pb-2 text-left font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase">
                  {edition.year} {d.name}, every finisher on file
                </caption>
                <colgroup>
                  <col class="c-place" />
                  <col />
                  <col class="c-age" />
                  <col class="c-time" />
                </colgroup>
                <thead>
                  <tr class="border-b border-primary/30">
                    <th
                      scope="col"
                      class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                    >
                      #
                    </th>
                    <th
                      scope="col"
                      class="pb-2 pl-3 text-left font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                    >
                      Name
                    </th>
                    <th
                      scope="col"
                      class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                    >
                      Age
                    </th>
                    <th
                      scope="col"
                      class="pb-2 text-right font-mono text-[0.6875rem] tracking-[0.18em] uppercase"
                    >
                      Time
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {d.rows.map((row) => (
                    <tr>
                      {/* THE ROW INDEX IS NOT A PLACE. This used to read
                        `row.place ?? i + 1`, so a row the race never placed
                        still showed a number, and Marc Teismann was 3rd here in
                        2014 and blank on his own page. Every placeable row now
                        carries a real place (ranked from the times at import
                        where the race published none, see src/lib/
                        derive-place.ts), so the only rows left without one are
                        the trekkers, who are ineligible by the race's own rule
                        and get the same dash their runner page gives them. */}
                      <td class="f-place">
                        {row.place ?? <span aria-hidden="true">&mdash;</span>}
                      </td>
                      <th scope="row" class="f-name">
                        {row.slug ? (
                          <a
                            class="underline-offset-2 hover:text-link hover:underline"
                            href={`/runners/${row.slug}`}
                          >
                            {row.name}
                          </a>
                        ) : (
                          row.name
                        )}
                        {row.trekker && (
                          <abbr
                            class="source-flag text-muted-foreground"
                            title="Trekker: took the optional early start, not eligible for awards"
                          >
                            T
                          </abbr>
                        )}
                      </th>
                      <td class="f-age">{row.age ?? ''}</td>
                      <td class="f-time">{formatRaceTime(row.timeSeconds)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }

      {
        anyTrekker && (
          <ul class="mt-10 grid max-w-[62ch] gap-2 border-t border-border pt-6 text-sm text-muted-foreground">
            <li>
              <span class="source-flag" aria-hidden="true">
                T
              </span>{' '}
              Trekker. Took the optional early start, which the race makes ineligible for age group
              and overall awards. The time is real and counts nowhere in the records.
            </li>
          </ul>
        )
      }

      <nav class="mt-12 flex flex-wrap items-center gap-4" aria-label="Other years">
        {
          older && (
            <a class="btn-plate btn-plate--cream" href={`/results/${older}`}>
              <span aria-hidden="true">&larr;</span> {older}
            </a>
          )
        }
        <a class="btn-plate btn-plate--cream" href="/results">All years</a>
        {
          newer && (
            <a class="btn-plate btn-plate--cream" href={`/results/${newer}`}>
              {newer}{' '}
              <span class="btn-plate__arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          )
        }
      </nav>
    </div>
  </section>
</BaseLayout>
