---
// Safe to edit by hand
//
// The results archive, edition by edition.
//
// WHY THIS PAGE EXISTS. The race published per-year results at /results-2003/
// through /results-2020/ for two decades, then deleted every one of them in a
// redesign. They were recovered from the Wayback Machine and the race's own
// timing spreadsheets (scripts/import-archive.mjs). Until this page there was
// no route on the site that showed a single finisher: the records board only
// draws the fastest, so a year in which nobody set a record left no trace.
//
// EVERYTHING HERE IS DERIVED from the results themselves, through
// src/lib/editions.ts. The entrant counts, the winners, the span of years and
// the holes in it are all computed, so no one can type a number here that
// disagrees with the rows it counts.
//
// THE GAPS ARE RENDERED, NOT SKIPPED. A year inside the span with no results on
// file is drawn as a row that says so. Dropping it would say the race did not
// happen that autumn, which is a worse error than an empty row. (2020 was that
// row until its results were found; the rule stays for whatever is next.)

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import { getAllResults, getDistanceRefs, getSiteSettings } from '@/lib/queries';
import { summariseEditions, type ResultRow, type DistanceRef } from '@/lib/editions';
import { formatRaceTime } from '@/lib/race-time';

const [results, distances, siteSettings] = await Promise.all([
  getAllResults().catch(() => []),
  getDistanceRefs().catch(() => []),
  getSiteSettings().catch(() => null),
]);

const editions = summariseEditions(results as ResultRow[], distances as DistanceRef[]);
const ran = editions.filter((e) => !e.missing);
const totalFinishers = ran.reduce((n, e) => n + e.total, 0);
const span = editions.length ? `${editions.at(-1)!.year} to ${editions[0].year}` : '';

// THE WINNERS ARE PICKED BY GENDER, NOT BY POSITION. The old markup mapped
// `d.winners` in whatever order the array happened to hold, which is fine while
// every year has exactly two and the men's is first, and silently puts a
// woman's name in the men's column the first time it is not. Now each column
// asks for the one it wants and renders nothing when that year has none.
//
// THE SLUG COMES WITH IT (2026-09-17). The winner's name was plain text here
// and a link on every other page that prints it: the year page, the records
// board, the runner pages themselves. A visitor scanning 23 runnings for a
// name they know is exactly the person who wants to click it, and this was the
// one place on the site that would not let them.
const winnerOf = (
  d: { winners: { gender: string }[] },
  gender: 'M' | 'F',
): { gender: string; row: { name: string; slug?: string | null; timeSeconds: number } } | null =>
  (
    d.winners as {
      gender: string;
      row: { name: string; slug?: string | null; timeSeconds: number };
    }[]
  ).find((w) => w.gender === gender) ?? null;

const title = 'Results archive | Stone Steps 50K';
const description = `Every Stone Steps 50K and 27K result on file, ${span}.`;

// THE LEDE IS BUILT HERE rather than in the markup, because PageHeader takes a
// string. Nothing is said when there is nothing on file: a header that counted
// zero finishes would be stating the empty state twice, and the list below
// already explains how to fill it.
const lede =
  ran.length > 0
    ? `${totalFinishers.toLocaleString()} finishes across ${ran.length} runnings, ${span}. Pick a year to see the full field.`
    : undefined;
---

<BaseLayout {title} {description} {siteSettings}>
  {
    /* THE SAME HEADER BAND EVERY OTHER INNER PAGE GETS (2026-09-17). The
      archive used to open with a bare eyebrow and a title on flat background:
      no walk of prints, no rule under the band, a smaller headline than
      /course or /records. It was the one stretch of the site that could have
      belonged to somebody else's build. PageHeader is the object the rest of
      the site opens with, so the archive opens with it too, and the two pages
      cannot drift apart because there is now only one of them.

      NOTHING IS ADDED BELOW THE BAND, deliberately. The ground the builder
      pages stand on is the walk in the header and the page's own paper grain;
      the records boards on /records sit on plain surface for the same reason
      this list does. Forty rows of times have to stay scannable, and
      decorating the page whose entire job is data would wreck it. */
  }
  <PageHeader eyebrow="Results" headline="Every running" {lede} headingId="results-heading" />

  {
    /* NO aria-labelledby ON THIS SECTION. The header band above is already a
      region labelled by the page's h1, and repeating the same label here gives
      two landmarks the same accessible name, which axe fails as
      `landmark-unique` and a screen-reader user hears as the same place twice.
      A section with no accessible name is not a landmark at all, which is what
      this one wants to be: the page has one region, at the top. */
  }
  <section class="bg-background py-section-lg">
    <div class="mx-auto w-full max-w-content px-6">
      {
        editions.length === 0 && (
          <p class="mb-6 max-w-[60ch] text-muted-foreground">
            No results are on file yet. Run <code>node scripts/import-results.mjs</code> to pull
            them from RunSignUp.
          </p>
        )
      }

      {
        /* THE COLUMN HEADS. They exist once, at the top, instead of the words
          "Men's win" and "Women's win" being repeated forty-six times down the
          page. aria-hidden because this is a decorative alignment rail, not a
          table header: every winner cell below carries its own label, visible
          on a phone and screen-reader-only from 56rem where this rail takes
          over the explaining. */
      }
      <div
        class="arch-head arch-tracks border-b border-border pb-2 font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase"
        aria-hidden="true"
      >
        <span>Year</span>
        <span>Race</span>
        <span>Finishers</span>
        <span>Men's winner</span>
        <span class="text-right">Time</span>
        <span>Women's winner</span>
        <span class="text-right">Time</span>
      </div>

      <ul class="grid list-none gap-0 p-0">
        {
          editions.map((e) => (
            <li class="border-b border-border py-5">
              {/* The missing-year row carries NO opacity utility.
                  `text-muted-foreground` already sits near the AA floor and
                  diluting it puts the row under, which is how this exact line
                  failed axe the first time. It is set apart by not being a
                  link and by carrying its own sentence, not by being faded. */}
              {e.missing ? (
                <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
                  <span class="display tabular text-h3 text-muted-foreground">{e.year}</span>
                  <span class="text-sm text-muted-foreground">Run, but no results on file.</span>
                </div>
              ) : (
                /* THE ROW IS NO LONGER ONE BIG LINK (2026-09-17), and it had to
                  stop being one. A link cannot contain another link, so while
                  the whole row went to /results/<year> the two winners' names
                  on it could not go anywhere, which made this the only page on
                  the site that prints a finisher's name and will not let you
                  click it. The year keeps the job: it is the loudest thing on
                  the row, it is set in the accent, and it is what a reader
                  reaches for anyway. */
                <div class="arch-row arch-tracks">
                  <span class="arch-row__year display tabular text-heading-accent text-h3">
                    {/* The numeral keeps the display face and the accent it
                      always had; what is new is that it is the link. Its
                      offset echo is left to `.display`, which switches it on
                      only in the theme where an offset is a shadow rather than
                      a smear. See `.arch-row__link` in globals.css. */}
                    <a class="arch-row__link" href={`/results/${e.year}`}>
                      {e.year}
                    </a>
                  </span>

                  {e.distances.map((d, di) => (
                    <span class="arch-dist">
                      {/* The first distance in the Studio's own order is the
                        headline race and gets the filled chip. See the note on
                        .dist-chip--lead in globals.css. */}
                      <span class:list={['dist-chip', di === 0 && 'dist-chip--lead']}>
                        {d.name}
                      </span>
                      <span class="arch-count tabular text-sm text-muted-foreground">
                        {d.finishers}{' '}
                        <span class="arch-count__word">
                          {d.finishers === 1 ? 'finisher' : 'finishers'}
                        </span>
                      </span>

                      {(['M', 'F'] as const).map((g) => {
                        const w = winnerOf(d, g);
                        return (
                          <>
                            <span class="arch-win text-sm">
                              <span class="arch-win__label font-mono text-[0.6875rem] tracking-[0.16em] text-muted-foreground uppercase">
                                {g === 'F' ? 'Women' : 'Men'}
                              </span>
                              <span class="text-foreground">
                                {w?.row.slug ? (
                                  <a
                                    class="underline-offset-2 hover:text-link hover:underline"
                                    href={`/runners/${w.row.slug}`}
                                  >
                                    {w.row.name}
                                  </a>
                                ) : (
                                  (w?.row.name ?? '—')
                                )}
                              </span>
                            </span>
                            <span class="arch-time tabular text-sm text-muted-foreground">
                              {w ? formatRaceTime(w.row.timeSeconds) : ''}
                            </span>
                          </>
                        );
                      })}
                    </span>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap gap-4">
        <a class="btn-plate btn-plate--cream" href="/records">
          All-time records
          <span class="btn-plate__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
