// Foundation, edit with care
//
// THE SECTIONS WALL: one of every page-builder block, rendered through the real
// SectionRenderer (the authoring kit, PORTS.md card 109).
//
// WHAT IT IS FOR. `npm run thumbnails` (scripts/shoot-section-thumbnails.mjs)
// shoots each `[data-section-type]` box below into
// public/section-thumbnails/<type>.jpg, and those pictures are what the
// "+ Add item" menu's grid view shows in the Studio. So the picture the race
// director picks from is the block as this site actually draws it.
//
// STONE STEPS (2026-10-18): THE RACE'S OWN BLOCKS USE THE RACE'S OWN DATA. The
// first copy of each block on Home, The Course, Records and Contact is fetched
// at build time, so the tickets carry the real prices, the board the real
// records and the bands their real photos. A block that is on no page yet (and
// every block, in a build with no Sanity project) falls back to the fixed
// fixture below, which is also what src/lib/authoring.test.ts looks for: every
// block type in sections.ts and raceSections.ts needs a `_type: '<name>'`
// fixture here and a picture on disk.
//
// The fixture images are fake Sanity references; the thumbnail script answers
// those CDN requests with a local photo. Real images load from the CDN. NOT
// shot by the visual suite (styleguide.astro is): noindex, out of the sitemap
// ('/styleguide' is filtered in astro.config.mjs) and under a reserved slug.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getHomePage, getPage, getSiteSettings } from '@/lib/queries';

const siteSettings = await getSiteSettings();

