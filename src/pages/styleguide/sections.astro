// The race's pages, for the real copy of each block. Missing pages (no Sanity
// project) come back null, and every block uses its fixture.
const home = (await getHomePage()) as {
  pageBuilder?: Record<string, unknown>[];
  results?: unknown[];
  historical?: unknown[];
} | null;
const pages = (await Promise.all(
  ['course', 'records', 'contact'].map((slug) => getPage(slug)),
)) as Array<{ pageBuilder?: Record<string, unknown>[] } | null>;
const real = new Map<string, Record<string, unknown>>();
for (const doc of [home, ...pages]) {
  for (const section of doc?.pageBuilder ?? []) {
    const type = String(section?._type ?? '');
    if (type && !real.has(type)) real.set(type, section);
  }
}
const SECTIONS = FIXTURES.map((fixture) => real.get(String(fixture._type)) ?? fixture);
---

<BaseLayout
  title="Sections wall | Stone Steps 50K"
  description="Wall of every page-builder section. Not for visitors."
  {siteSettings}
  noindex
>
  {SECTIONS.map((section, i) => (
    <div data-section-type={String(section._type)}>
      <SectionRenderer
        sections={[section]}
        idPrefix={`fx-${i}`}
        results={(home?.results ?? []) as never}
        historical={(home?.historical ?? []) as never}
      />
    </div>
  ))}
</BaseLayout>
