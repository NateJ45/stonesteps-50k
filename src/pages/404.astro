---
// Safe to edit by hand
//
// The 404, as a wrong turn.
//
// Surveyor's flagging tape is what actually marks an off-course turn on a trail
// race, so that is what this page is. The tape strips FRAME the copy rather
// than crossing it: tape over the words would be a joke at the reader's expense
// at the exact moment they are already lost.
//
// The repeated phrase is generated rather than typed, so a rotated strip stays
// filled at any viewport width instead of running out of text on a wide screen.
//
// Content comes from the notFoundPage singleton where it is set, with race
// specific defaults, so an editor can change the words without touching code.
// Stays noindex.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Topo from '@/components/race/Topo.astro';
import { getNotFoundPage, getRace, getSiteSettings } from '@/lib/queries';

const [notFoundPage, siteSettings, race] = await Promise.all([
  getNotFoundPage().catch(() => null),
  getSiteSettings().catch(() => null),
  getRace().catch(() => null),
]);

const seoTitle = notFoundPage?.seoTitle ?? 'Wrong turn';
const seoDescription =
  notFoundPage?.seoDescription ?? 'That page is not on the course. Here is the way back.';

const eyebrow = notFoundPage?.eyebrow ?? 'Error 404';
const headline = notFoundPage?.headline ?? 'You took a wrong turn.';
const body =
  notFoundPage?.body ??
  'That page is not on the course. It happens. Follow the blazes back and pick up the loop where you left it.';

// The same four places the header offers, so being lost costs one click.
const links = [
  { label: 'The Race', href: '/' },
  { label: 'Course', href: '/course' },
  { label: 'Records', href: '/records' },
  { label: 'Contact', href: '/contact' },
  ...(race?.resultsUrl ? [{ label: 'Results', href: race.resultsUrl }] : []),
];

/** Long enough to fill a rotated strip at any viewport width. */
const repeat = (phrase: string) => Array.from({ length: 18 }, () => phrase).join(' · ');
---

<BaseLayout title={seoTitle} description={seoDescription} {siteSettings} noindex>
  <section class="lost relative overflow-hidden py-section-lg">
    <Topo seed={67} lines={14} class="opacity-40" />

    <!-- Flagging tape, the way an off-course turn actually gets marked. -->
    <div class="tape tape--a" aria-hidden="true"><span>{repeat('Wrong way')}</span></div>
    <div class="tape tape--b" aria-hidden="true"><span>{repeat('Not the course')}</span></div>

    <div class="relative z-10 mx-auto mt-24 w-full max-w-content px-6 pb-16">
      <p
        class="blaze text-heading-accent mb-4 font-mono text-[0.72rem] font-semibold tracking-[0.22em] uppercase"
      >
        {eyebrow}
      </p>

      <h1 class="display text-[clamp(2.5rem,8vw,5.5rem)]">{headline}</h1>

      <p class="mt-6 max-w-[46ch] text-lg text-muted-foreground">{body}</p>

      <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2" aria-label="Back to the course">
        {
          links.map((item) => (
            <a
              class="display border-b-2 border-transparent text-lg transition-colors hover:border-[color:var(--heading-accent)]"
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="btn-plate mt-10" href="/">
        Back to the start
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    background: radial-gradient(
      110% 80% at 25% 0%,
      color-mix(in srgb, var(--primary) 8%, var(--background)) 0%,
      var(--background) 62%
    );
  }

  /* Two strips of tape, framing the copy rather than crossing it. */
  .tape {
    position: absolute;
    left: -12%;
    width: 124%;
    background: var(--primary);
    color: var(--primary-foreground);
    border-block: 2px solid var(--plate-edge);
    box-shadow: var(--lift);
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  .tape > span {
    display: block;
    padding: 0.35rem 0;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Pinned in rem, not per cent. A percentage moves with the section height,
     which changes with the copy, so the clearance below was only ever correct
     at one viewport. */
  .tape--a {
    top: 1rem;
    transform: rotate(-4deg);
  }
  .tape--b {
    bottom: 1.5rem;
    transform: rotate(2.5deg);
  }

  @media (max-width: 700px) {
    /* One strip on a phone. Two crowd the copy at this width. */
    .tape--b {
      display: none;
    }
  }
</style>
