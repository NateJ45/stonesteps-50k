---
/* ============================================================================
   Preview route - draft-aware pages for the Studio Presentation tool
   (ported from presacademy 2026-08-28; original lineage: the WCP site)
   ============================================================================
   One SSR route renders ANY page in draft mode for the Presentation Tool: it
   reads the perspective cookie, fetches the doc draft-aware (stega on), and
   renders it through the SAME SectionRenderer the live pages use, so the
   preview cannot drift from the page.

   THIS TEMPLATE HAS TWO PAGE SHAPES, and the preview treats them differently.

    1. BUILDER PAGES - home, about, services, process, and every custom `page`
       doc. Their whole body IS the `pageBuilder` array, so the preview is
       full-fidelity: the same array through the same renderer. The only things
       missing are the site header, the footer and the polish layer, which
       PreviewLayout deliberately leaves out (see its header for why).

    2. BESPOKE PAGES - faq, contact, journal, privacy, 404. Their middles are
       drawn in code (the FAQ accordion, the contact form, the journal grid),
       so what previews is their EDITABLE SURFACE: the hero fields, any page
       sections, and the closing call to action, with a note on the page saying
       so. Converting one of these to the page builder would upgrade its
       preview for free, but that conversion is a separate job (PORTS.md card
       12) and is deliberately not attempted here.

   Keep the path -> type map in sync with SINGLETON_PREVIEW_PATHS in
   src/sanity/resolve.ts. (It used to name a third copy, FIRST_SEGMENT_PREVIEWABLE
   in src/layouts/PreviewLayout.astro; that one was dead code and is gone.)
   noindex comes from PreviewLayout.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import type { ProjectedRaceResult, ProjectedRecordEntry } from '@/lib/pageBuilder.types';
import { previewFetch, previewConfig, previewUnconfiguredResponse } from '@/lib/cms-preview';
import {
  IMAGE_PROJECTION,
  CTA_PROJECTION,
  sectionsProjection,
  ARCHIVE_PROJECTION,
} from '@/lib/queries';

// Fresh clone with no project id / no runtime token: say so, do not 500.
const config = previewConfig();
if (!config.ok) {
  return previewUnconfiguredResponse(config.missing);
}

const draftMode = Astro.cookies.has(perspectiveCookieName);

// Never let a browser cache a preview page (2026-08-28, measured on
// presacademy). These SSR responses carried NO Cache-Control, so browsers
// applied heuristic caching, and the Presentation iframe kept serving the
// PREVIOUS deploy's page (stale island hashes, invisible new editor features)
// until the cache aged out. Draft content is per-cookie anyway; caching it was
// never right.
Astro.response.headers.set('Cache-Control', 'no-store');

const slug = (Astro.params.slug as string | undefined) || '';

// Fixed preview path -> singleton type. Mirror of src/sanity/resolve.ts.
// TWO ENTRIES, and `contact` is deliberately NOT one of them: it is a `page`
// document here, and while this map claimed the path the slug branch below
// never ran, so previewing Contact answered "No document found". See the note
// on SINGLETON_PREVIEW_PATHS in src/sanity/resolve.ts.
const SINGLETON_BY_PATH: Record<string, string> = {
  '': 'homePage',
  '404': 'notFoundPage',
};

// The types whose whole body is the pageBuilder array. Everything else previews
// as its editable surface only. `page` (custom pages) is a builder type too and
// is handled by the slug branch below.
const BUILDER_SINGLETONS = new Set(['homePage']);

// The heading-id prefix each live page passes to SectionRenderer. Matching it
// here keeps generated ids identical to the live page, so an in-page anchor an
// editor is checking behaves the same in the preview.
const ID_PREFIX: Record<string, string> = {
  homePage: 'home',
  aboutPage: 'about',
  servicesPage: 'services',
  processPage: 'process',
};

// Every hero / builder / CTA field any of the page types may carry. Absent
// fields come back null and the components skip them.
const PREVIEW_FIELDS = `{
  _id, _type, title,
  seoTitle,
  heroEyebrow, heroHeadline, heroSubhead, heroScriptAccent,
  heroImage${IMAGE_PROJECTION},
  "notFoundEyebrow": eyebrow,
  "notFoundHeadline": headline,
  ${sectionsProjection('pageBuilder')},
  ${ARCHIVE_PROJECTION},
  finalCtaEyebrow, finalCtaHeadline, finalCtaSubhead, finalCtaScriptAccent,
  finalCta${CTA_PROJECTION},
  finalCtaBackgroundImage${IMAGE_PROJECTION}
}`;

interface PreviewDoc {
  _id: string;
  _type: string;
  title?: string;
  seoTitle?: string;
  heroEyebrow?: string;
  heroHeadline?: string;
  heroSubhead?: string;
  heroScriptAccent?: string;
  heroImage?: unknown;
  notFoundEyebrow?: string;
  notFoundHeadline?: string;
  pageBuilder?: unknown[];
  finalCtaEyebrow?: string;
  finalCtaHeadline?: string;
  finalCtaSubhead?: string;
  finalCtaScriptAccent?: string;
  finalCta?: unknown;
  finalCtaBackgroundImage?: unknown;
  /** The shared results archive: see ARCHIVE_PROJECTION in queries.ts. */
  results?: ProjectedRaceResult[];
  historical?: ProjectedRecordEntry[];
}

const singletonType = SINGLETON_BY_PATH[slug];

const fetched = await previewFetch<PreviewDoc | null>(
  draftMode,
  singletonType
    ? `*[_type == $type][0]${PREVIEW_FIELDS}`
    : `*[_type == "page" && slug.current == $slug][0]${PREVIEW_FIELDS}`,
  singletonType ? { type: singletonType } : { slug },
);

// A MISSING DOCUMENT STILL RENDERS THE PREVIEW SHELL. This used to answer a bare
// 404 text response, and that broke the Studio in a way a refresh was the only
// way out of (2026-09-12): the text page carries no PreviewLayout, so no
// overlay, so the comlink channel to the Studio never connects for that frame.
// Presentation then DROPS every navigation asked for while the channel is not
// connected (see src/lib/preview-navigation.ts), and a frame with no overlay
// never reports a location either, so the bounce that would have re-issued the
// click never comes. Pick "404 page" (a document this dataset has not created)
// and every page after it read "could not connect". The shell always renders
// now; what is missing is said inside it, where the overlay is alive.
//
// The 404 gets its live defaults rather than a notice, because that is what the
// public /404 renders without a document: the words in src/pages/404.astro.
const missing = !fetched;
const doc: PreviewDoc =
  fetched ??
  (singletonType === 'notFoundPage'
    ? {
        _id: 'notFoundPage',
        _type: 'notFoundPage',
        notFoundEyebrow: 'Error 404',
        notFoundHeadline: 'You took a wrong turn.',
        heroSubhead:
          'That page is not on the course. It happens. Follow the blazes back and pick up the loop where you left it.',
      }
    : {
        _id: singletonType ?? `page-${slug}`,
        _type: singletonType ?? 'page',
        title: slug || 'Home',
      });

// The doc id the overlay and /preview/live listen on, read from the QUERY (a
// Studio-created page has a random id). The draft perspective can return the
// drafts. twin's id; strip the prefix so the listen filter matches both twins.
const pageId = doc._id.replace(/^drafts\./, '');

// ---------------------------------------------------------------------------
// In-canvas section controls (PORTS.md card 17; wired in Phase D)
// ---------------------------------------------------------------------------
// The doc and array field each rendered section belongs to. SectionRenderer
// turns this into one `data-sanity` attribute per section, which is what lets
// the Presentation overlay outline a section and offer insert / duplicate /
// remove / drag-to-reorder right in the preview instead of only in the
// Structure panel. See src/lib/preview-edit-attr.ts.
//
// Passed regardless of draftMode. The attribute is inert without the Studio's
// overlay, this route is noindex and never part of the static build, and a
// preview opened before the cookie lands would otherwise render uncontrollable
// sections. Every page type in this template holds its sections in
// `pageBuilder`, so unlike presacademy there is only one field name.
const editDoc = { id: pageId, type: doc._type, field: 'pageBuilder' as const };

const isBuilderPage = !singletonType || BUILDER_SINGLETONS.has(singletonType);
const sections = doc.pageBuilder ?? [];
const idPrefix = singletonType ? (ID_PREFIX[singletonType] ?? 'section') : 'page';

// The bespoke pages carry hero fields; the 404 page names them differently.
const heroHeadline = doc.heroHeadline || doc.notFoundHeadline || '';
const heroEyebrow = doc.heroEyebrow || doc.notFoundEyebrow || '';
const showHero = !isBuilderPage && Boolean(heroHeadline);
const hasFinalCta = !isBuilderPage && Boolean(doc.finalCtaHeadline || doc.finalCta);

const label = doc.title || doc.seoTitle || heroHeadline || slug || 'Home';
const title = `${label} - Preview`;
---

<PreviewLayout {title} {draftMode} {pageId}>
  {
    missing && (
      <div class="mx-auto max-w-3xl px-4 py-6">
        <p class="rounded-md border border-border-soft bg-bg-soft px-4 py-3 text-sm text-foreground/80">
          {singletonType === 'notFoundPage'
            ? 'This page has not been created in the Studio yet, so these are the built-in words the live site uses. Fill in the form on the right and publish to change them.'
            : `No document found for "${slug || 'home'}" yet. Create it in the Studio and it will appear here.`}
        </p>
      </div>
    )
  }
  {
    showHero && (
      <Hero
        eyebrow={heroEyebrow}
        headline={heroHeadline}
        subhead={doc.heroSubhead ?? ''}
        backgroundImage={(doc.heroImage as never) ?? null}
        scriptAccent={doc.heroScriptAccent}
        headingId="preview-hero"
        size="short"
      />
    )
  }
  {
    !isBuilderPage && (
      <div class="mx-auto max-w-3xl px-4 py-6">
        <p class="rounded-md border border-border-soft bg-bg-soft px-4 py-3 text-sm text-foreground/80">
          This page's middle is drawn in code (the list, form or grid it is built around), so it
          previews as its editable surface only: the hero above, any page sections below, and the
          closing call to action. The parts held in code render on the live site.
        </p>
      </div>
    )
  }
  {
    isBuilderPage && sections.length === 0 && (
      <div class="mx-auto max-w-3xl px-4 py-6">
        <p class="rounded-md border border-border-soft bg-bg-soft px-4 py-3 text-sm text-foreground/80">
          This page has no sections yet. Add one from the Page layout field, or right here in the
          preview with the plus control. The live site falls back to the built-in default sections
          until you do, so it is not blank.
        </p>
      </div>
    )
  }
  <SectionRenderer
    {sections}
    {idPrefix}
    {editDoc}
    results={doc.results ?? []}
    historical={doc.historical ?? []}
  />
  {
    hasFinalCta && (
      <FinalCta
        eyebrow={doc.finalCtaEyebrow}
        headline={doc.finalCtaHeadline}
        subhead={doc.finalCtaSubhead}
        scriptAccent={doc.finalCtaScriptAccent}
        cta={doc.finalCta ?? null}
        backgroundImage={(doc.finalCtaBackgroundImage as never) ?? null}
      />
    )
  }
</PreviewLayout>
