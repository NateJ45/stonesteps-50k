{
  // Cloudflare Workers configuration for this project.
  // Cloudflare merged Pages into Workers in early 2026; Workers is the path forward.
  "compatibility_date": "2026-05-26",
  // nodejs_compat (added 2026-08-28 with the Astro 7 / adapter 14 upgrade): the
  // SSR routes' render graph can touch process.env (React internals, the Sanity
  // client, the embedded Studio shell) and without the flag those reads throw at
  // request time. global_fetch_strictly_public predates it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "stonesteps-50k",

  // ── The contact endpoint's bindings (src/pages/api/contact.ts) ────────────
  // Commented out until the resources exist: an active binding with a
  // placeholder id fails the deploy. See PORTS.md card 45 in the starter.
  //
  //   1. npx wrangler d1 create stonesteps-contact
  //   2. Paste the id below, uncomment, then:
  //      npx wrangler d1 migrations apply stonesteps-contact --remote
  //   3. npx wrangler secret put CONTACT_TO   (verified destination address)
  //      npx wrangler secret put CONTACT_FROM (address on a sending domain)
  //
  // EMAIL SENDING IS NOT AVAILABLE TO THIS DOMAIN TODAY. stonesteps50k.com is on
  // GoDaddy DNS (ns13/ns14.domaincontrol.com) and Cloudflare Email Service
  // requires Cloudflare DNS; its mail is on Microsoft 365, so Email Routing is
  // out too. Until that changes, set WEB3FORMS_KEY as a Worker secret and the
  // endpoint stores the submission in D1 and notifies through Web3Forms, with
  // the key out of the client bundle.
  //
  // WIRED ON 2026-09-18, the day the domain moved to Cloudflare DNS; the note
  // above is kept as the record of why it waited. The database holds every
  // submission before any email is attempted, and the binding sends from an
  // address on this domain, which `wrangler email sending enable
  // stonesteps50k.com` onboarded (its SPF and DKIM records live in the zone
  // under cf-bounce). CONTACT_TO and CONTACT_FROM are Worker secrets.
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "stonesteps-contact",
      "database_id": "ce9ce357-9904-46a9-b7e8-8cc97f9ac72f",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],

  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    // @astrojs/cloudflare v14 splits the build into dist/client (static assets)
    // + dist/server (the SSR bundle: /studio, /preview/**, /api/draft-mode/*).
    //
    // Deliberately NO "not_found_handling" here (removed 2026-08-28). With
    // "404-page" set, Cloudflare answers NAVIGATION requests (Sec-Fetch-Mode:
    // navigate) that miss the asset store straight from the static 404 page
    // WITHOUT invoking the Worker, which silently 404s every SSR route for real
    // browsers while curl (which sends no Sec-Fetch headers) sees them working.
    // That broke presacademy's Presentation preview in production on 2026-08-26
    // and hid from every command-line probe. Without the field, asset misses
    // invoke the Worker and Astro renders the 404 page itself.
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
